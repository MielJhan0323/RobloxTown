{
  "slug": "the-knock",
  "title": "The Knock (Part 1)",
  "timing": "voice",
  "voice": "output/cache/the-knock/voice_fx.wav",
  "duration": 53.077,
  "shots": [
    {
      "n": 1,
      "text": "In this town, when the streetlights go out,",
      "start": 0.0,
      "end": 2.16,
      "src": "output/anim/the-knock/shot_01.mp4",
      "src_dur": 4.6,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": null,
      "override": {},
      "dur": 2.16
    },
    {
      "n": 2,
      "text": "you never open the door.",
      "start": 2.16,
      "end": 3.54,
      "src": "output/anim/the-knock/shot_02.mp4",
      "src_dur": 2.933,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": null,
      "override": {},
      "dur": 1.38
    },
    {
      "n": 3,
      "text": "That's when the Knockers come.",
      "start": 3.54,
      "end": 4.98,
      "src": "output/anim/the-knock/shot_03.mp4",
      "src_dur": 3.133,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": null,
      "override": {},
      "dur": 1.44
    },
    {
      "n": 4,
      "text": "They sound like people you love.",
      "start": 4.98,
      "end": 6.5,
      "src": "output/anim/the-knock/shot_04.mp4",
      "src_dur": 3.467,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": null,
      "override": {},
      "dur": 1.52
    },
    {
      "n": 5,
      "text": "Last year, one knocked on the Parkers' door using their grandma's voice.",
      "start": 6.5,
      "end": 9.74,
      "src": "output/anim/the-knock/shot_05.mp4",
      "src_dur": 6.333,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": null,
      "override": {},
      "dur": 3.24
    },
    {
      "n": 6,
      "text": "Their grandma lives in Florida.",
      "start": 9.74,
      "end": 11.6,
      "src": "output/anim/the-knock/shot_06.mp4",
      "src_dur": 3.2,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": null,
      "override": {},
      "dur": 1.86
    },
    {
      "n": 7,
      "text": "The rules are simple. Lock everything.",
      "start": 11.6,
      "end": 13.68,
      "src": "output/anim/the-knock/shot_07.mp4",
      "src_dur": 3.933,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": null,
      "override": {},
      "dur": 2.08
    },
    {
      "n": 8,
      "text": "Don't answer.",
      "start": 13.68,
      "end": 14.66,
      "src": "output/anim/the-knock/shot_08.mp4",
      "src_dur": 1.867,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": null,
      "override": {},
      "dur": 0.98
    },
    {
      "n": 9,
      "text": "Knockers can copy any voice, but only words they heard today.",
      "start": 14.66,
      "end": 17.72,
      "src": "output/anim/the-knock/shot_09.mp4",
      "src_dur": 5.733,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": null,
      "override": {},
      "dur": 3.06
    },
    {
      "n": 10,
      "text": "Tonight, Mom and Dad went out for dinner.",
      "start": 17.72,
      "end": 19.34,
      "src": "output/anim/the-knock/shot_10.mp4",
      "src_dur": 4.333,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": null,
      "override": {},
      "dur": 1.62
    },
    {
      "n": 11,
      "text": "\"Back before the lights go out,\" Mom said.",
      "start": 19.34,
      "end": 21.04,
      "src": "output/anim/the-knock/shot_11.mp4",
      "src_dur": 4.2,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": null,
      "override": {},
      "dur": 1.7
    },
    {
      "n": 12,
      "text": "She kissed my head and called me \"bug,\" like she does every night.",
      "start": 21.04,
      "end": 23.62,
      "src": "output/anim/the-knock/shot_12.mp4",
      "src_dur": 6.2,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": null,
      "override": {},
      "dur": 2.58
    },
    {
      "n": 13,
      "text": "We were on the front porch.",
      "start": 23.62,
      "end": 24.8,
      "src": "output/anim/the-knock/shot_13.mp4",
      "src_dur": 3.267,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": null,
      "override": {},
      "dur": 1.18
    },
    {
      "n": 14,
      "text": "At nine, the streetlights went out.",
      "start": 24.8,
      "end": 26.6,
      "src": "output/anim/the-knock/shot_14.mp4",
      "src_dur": 3.667,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": null,
      "override": {},
      "dur": 1.8
    },
    {
      "n": 15,
      "text": "They weren't home.",
      "start": 26.6,
      "end": 27.54,
      "src": "output/anim/the-knock/shot_15.mp4",
      "src_dur": 2.267,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": null,
      "override": {},
      "dur": 0.94
    },
    {
      "n": 16,
      "text": "At nine-oh-one, someone knocked on the front door.",
      "start": 27.54,
      "end": 29.94,
      "src": "output/anim/the-knock/shot_16.mp4",
      "src_dur": 4.6,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": null,
      "override": {},
      "dur": 2.4
    },
    {
      "n": 17,
      "text": "\"Bug? It's Mom. I lost my keys. Open up, it's freezing.\"",
      "start": 29.94,
      "end": 33.14,
      "src": "output/anim/the-knock/shot_17.mp4",
      "src_dur": 6.0,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": null,
      "override": {},
      "dur": 3.2
    },
    {
      "n": 18,
      "text": "Then, a knock on the back door. Softer.",
      "start": 33.14,
      "end": 35.6,
      "src": "output/anim/the-knock/shot_18.mp4",
      "src_dur": 4.533,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": null,
      "override": {},
      "dur": 2.46
    },
    {
      "n": 19,
      "text": "\"Hey, kiddo. It's Dad. Mom's with me. Don't open the front. Something followed us.\"",
      "start": 35.6,
      "end": 39.45,
      "src": "output/anim/the-knock/shot_19.mp4",
      "src_dur": 7.867,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": null,
      "override": {},
      "dur": 3.85
    },
    {
      "n": 20,
      "text": "Dad never calls me kiddo.",
      "start": 39.45,
      "end": 40.95,
      "src": "output/anim/the-knock/shot_20.mp4",
      "src_dur": 3.0,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": null,
      "override": {},
      "dur": 1.5
    },
    {
      "n": 21,
      "text": "But Mom said \"bug\" on the porch, where anything could have heard it.",
      "start": 40.95,
      "end": 43.59,
      "src": "output/anim/the-knock/shot_21.mp4",
      "src_dur": 6.4,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": null,
      "override": {},
      "dur": 2.64
    },
    {
      "n": 22,
      "text": "The front door rattled.",
      "start": 43.59,
      "end": 44.75,
      "src": "output/anim/the-knock/shot_22.mp4",
      "src_dur": 2.667,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": null,
      "override": {},
      "dur": 1.16
    },
    {
      "n": 23,
      "text": "The back door went quiet. Too quiet.",
      "start": 44.75,
      "end": 46.53,
      "src": "output/anim/the-knock/shot_23.mp4",
      "src_dur": 4.067,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": null,
      "override": {},
      "dur": 1.78
    },
    {
      "n": 24,
      "text": "My phone has two percent battery.",
      "start": 46.53,
      "end": 48.63,
      "src": "output/anim/the-knock/shot_24.mp4",
      "src_dur": 3.467,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": null,
      "override": {},
      "dur": 2.1
    },
    {
      "n": 25,
      "text": "I can reach one door before it dies.",
      "start": 48.63,
      "end": 49.93,
      "src": "output/anim/the-knock/shot_25.mp4",
      "src_dur": 4.067,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": null,
      "override": {},
      "dur": 1.3
    },
    {
      "n": 26,
      "text": "Front door, or back door?",
      "start": 49.93,
      "end": 53.077,
      "src": "output/anim/the-knock/shot_26.mp4",
      "src_dur": 4.4,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": null,
      "override": {},
      "dur": 3.147
    }
  ],
