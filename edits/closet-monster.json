   "motion": "push_in",
   "transition": "cut",
   "grade": "neutral",
   "placeholder": null,
   "override": {},
   "dur": 1.471
  },
  {
   "n": 29,
   "text": "It wasn't empty anymore. It was a tunnel, glowing at the bottom.",
