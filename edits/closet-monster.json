 "shots": [
  {
   "n": 1,
   "text": "In this town, every closet has a monster in it.",
   "start": 0.0,
   "end": 2.173,
   "src": "output/anim/closet-monster/shot_01.mp4",
   "src_dur": 2.8,
   "motion": "push_in",
   "transition": "cut",
   "grade": "neutral",
   "placeholder": null,
   "override": {},
   "dur": 2.173
  },
  {
   "n": 2,
   "text": "They're not scary. They're roommates.",
   "start": 2.173,
   "end": 4.141,
   "src": "output/anim/closet-monster/shot_02.mp4",
   "src_dur": 2.6,
   "motion": "push_in",
   "transition": "cut",
   "grade": "neutral",
   "placeholder": null,
   "override": {},
   "dur": 1.968
  },
  {
   "n": 3,
   "text": "Some steal socks.",
   "start": 4.141,
   "end": 5.196,
   "src": "output/anim/closet-monster/shot_03.mp4",
   "src_dur": 1.667,
   "motion": "push_in",
   "transition": "cut",
   "grade": "neutral",
   "placeholder": null,
   "override": {},
   "dur": 1.055
  },
  {
   "n": 4,
   "text": "Some snore so loud the hangers rattle.",
   "start": 5.196,
   "end": 6.848,
   "src": "output/anim/closet-monster/shot_04.mp4",
   "src_dur": 2.267,
   "motion": "push_in",
   "transition": "cut",
   "grade": "neutral",
   "placeholder": null,
   "override": {},
   "dur": 1.652
  },
  {
   "n": 5,
   "text": "My cousin's monster does his homework.",
   "start": 6.848,
   "end": 8.528,
   "src": "output/anim/closet-monster/shot_05.mp4",
   "src_dur": 2.333,
   "motion": "push_in",
   "transition": "cut",
   "grade": "neutral",
   "placeholder": null,
   "override": {},
   "dur": 1.68
  },
  {
   "n": 6,
   "text": "Badly.",
   "start": 8.528,
   "end": 9.375,
   "src": "output/anim/closet-monster/shot_06.mp4",
   "src_dur": 1.467,
   "motion": "push_in",
   "transition": "cut",
   "grade": "neutral",
   "placeholder": null,
   "override": {},
   "dur": 0.847
  },
  {
   "n": 7,
   "text": "You get your monster the day you're born.",
   "start": 9.375,
   "end": 10.936,
   "src": "output/anim/closet-monster/shot_07.mp4",
   "src_dur": 2.2,
   "motion": "push_in",
   "transition": "cut",
   "grade": "neutral",
   "placeholder": null,
   "override": {},
   "dur": 1.561
  },
  {
   "n": 8,
   "text": "It moves in, and it never leaves.",
   "start": 10.936,
   "end": 12.627,
   "src": "output/anim/closet-monster/shot_08.mp4",
   "src_dur": 2.333,
   "motion": "push_in",
   "transition": "cut",
   "grade": "neutral",
   "placeholder": null,
   "override": {},
   "dur": 1.691
  },
  {
   "n": 9,
   "text": "But my closet was empty.",
   "start": 12.627,
   "end": 14.135,
   "src": "output/anim/closet-monster/shot_09.mp4",
   "src_dur": 2.133,
   "motion": "push_in",
   "transition": "cut",
   "grade": "neutral",
   "placeholder": null,
   "override": {},
   "dur": 1.508
  },
  {
   "n": 10,
   "text": "Dad worked late. Every night.",
   "start": 14.135,
   "end": 15.929,
   "src": "output/anim/closet-monster/shot_10.mp4",
   "src_dur": 2.4,
   "motion": "push_in",
   "transition": "cut",
   "grade": "neutral",
   "placeholder": null,
   "override": {},
   "dur": 1.794
  },
  {
   "n": 11,
   "text": "Mom worked even later.",
   "start": 15.929,
   "end": 17.192,
   "src": "output/anim/closet-monster/shot_11.mp4",
   "src_dur": 1.867,
   "motion": "push_in",
   "transition": "cut",
   "grade": "neutral",
   "placeholder": null,
   "override": {},
   "dur": 1.263
  },
  {
   "n": 12,
   "text": "Dinner was a sticky note on the fridge.",
   "start": 17.192,
   "end": 18.776,
   "src": "output/anim/closet-monster/shot_12.mp4",
   "src_dur": 2.2,
   "motion": "push_in",
   "transition": "cut",
   "grade": "neutral",
   "placeholder": null,
   "override": {},
   "dur": 1.584
  },
  {
   "n": 13,
   "text": "\"Love you. Microwave for two minutes.\"",
   "start": 18.776,
   "end": 20.532,
   "src": "output/anim/closet-monster/shot_13.mp4",
   "src_dur": 2.4,
   "motion": "push_in",
   "transition": "cut",
   "grade": "neutral",
   "placeholder": null,
   "override": {},
   "dur": 1.756
  },
  {
   "n": 14,
   "text": "So I really wanted a monster. Just someone to talk to.",
   "start": 20.532,
   "end": 23.157,
   "src": "output/anim/closet-monster/shot_14.mp4",
   "src_dur": 3.267,
   "motion": "push_in",
   "transition": "cut",
   "grade": "neutral",
   "placeholder": null,
   "override": {},
   "dur": 2.625
  },
  {
   "n": 15,
   "text": "I left cookies.",
   "start": 23.157,
   "end": 24.152,
   "src": "output/anim/closet-monster/shot_15.mp4",
   "src_dur": 1.6,
   "motion": "push_in",
   "transition": "cut",
   "grade": "neutral",
   "placeholder": null,
   "override": {},
   "dur": 0.995
  },
  {
   "n": 16,
   "text": "I left the nightlight on.",
   "start": 24.152,
   "end": 25.343,
   "src": "output/anim/closet-monster/shot_16.mp4",
   "src_dur": 1.8,
   "motion": "push_in",
   "transition": "cut",
   "grade": "neutral",
   "placeholder": null,
   "override": {},
   "dur": 1.191
  },
  {
   "n": 17,
   "text": "I even made a sign: \"Monster Wanted.\"",
   "start": 25.343,
   "end": 27.341,
   "src": "output/anim/closet-monster/shot_17.mp4",
   "src_dur": 2.6,
   "motion": "push_in",
   "transition": "cut",
   "grade": "neutral",
   "placeholder": null,
   "override": {},
   "dur": 1.998
  },
  {
   "n": 18,
   "text": "Every night, I opened the closet. Nothing.",
   "start": 27.341,
   "end": 29.655,
   "src": "output/anim/closet-monster/shot_18.mp4",
   "src_dur": 2.933,
   "motion": "push_in",
   "transition": "cut",
   "grade": "neutral",
   "placeholder": null,
   "override": {},
   "dur": 2.314
  },
  {
   "n": 19,
   "text": "The cookies were always gone by morning, though.",
   "start": 29.655,
   "end": 31.436,
   "src": "output/anim/closet-monster/shot_19.mp4",
   "src_dur": 2.4,
   "motion": "push_in",
   "transition": "cut",
   "grade": "neutral",
   "placeholder": null,
   "override": {},
   "dur": 1.781
  },
  {
   "n": 20,
   "text": "And Mom said when I was a baby, I never cried at night.",
