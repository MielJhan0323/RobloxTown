{
  "slug": "closet-monster",
  "title": "The Monster in My Closet",
  "timing": "voice",
  "voice": "output/cache/closet-monster/voice_fx.wav",
  "duration": 83.582,
  "shots": [
    {
      "n": 1,
      "text": "In this town, every closet has a monster in it.",
      "start": 0.0,
      "end": 2.173,
      "src": "output/anim/closet-monster/shot_01.mp4",
      "src_dur": 2.8,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": null,
      "override": {},
      "dur": 2.173
    },
    {
      "n": 2,
      "text": "They're not scary. They're roommates.",
      "start": 2.173,
      "end": 4.141,
      "src": "output/anim/closet-monster/shot_02.mp4",
      "src_dur": 2.6,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": null,
      "override": {},
      "dur": 1.968
    },
    {
      "n": 3,
      "text": "Some steal socks.",
      "start": 4.141,
      "end": 5.196,
      "src": "output/anim/closet-monster/shot_03.mp4",
      "src_dur": 1.667,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": null,
      "override": {},
      "dur": 1.055
    },
    {
      "n": 4,
      "text": "Some snore so loud the hangers rattle.",
      "start": 5.196,
      "end": 6.848,
      "src": "output/anim/closet-monster/shot_04.mp4",
      "src_dur": 2.267,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": null,
      "override": {},
      "dur": 1.652
    },
    {
      "n": 5,
      "text": "My cousin's monster does his homework.",
      "start": 6.848,
      "end": 8.528,
      "src": "output/anim/closet-monster/shot_05.mp4",
      "src_dur": 2.333,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": null,
      "override": {},
      "dur": 1.68
    },
    {
      "n": 6,
      "text": "Badly.",
      "start": 8.528,
      "end": 9.375,
      "src": "output/anim/closet-monster/shot_06.mp4",
      "src_dur": 1.467,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": null,
      "override": {},
      "dur": 0.847
    },
    {
      "n": 7,
      "text": "You get your monster the day you're born.",
      "start": 9.375,
      "end": 10.936,
      "src": "output/anim/closet-monster/shot_07.mp4",
      "src_dur": 2.2,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": null,
      "override": {},
      "dur": 1.561
    },
    {
      "n": 8,
      "text": "It moves in, and it never leaves.",
      "start": 10.936,
      "end": 12.627,
      "src": "output/anim/closet-monster/shot_08.mp4",
      "src_dur": 2.333,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": null,
      "override": {},
      "dur": 1.691
    },
    {
      "n": 9,
      "text": "But my closet was empty.",
      "start": 12.627,
      "end": 14.135,
      "src": "output/anim/closet-monster/shot_09.mp4",
      "src_dur": 2.133,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": null,
      "override": {},
      "dur": 1.508
    },
    {
      "n": 10,
      "text": "Dad worked late. Every night.",
      "start": 14.135,
      "end": 15.929,
      "src": "output/anim/closet-monster/shot_10.mp4",
      "src_dur": 2.4,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": null,
      "override": {},
      "dur": 1.794
    },
    {
      "n": 11,
      "text": "Mom worked even later.",
      "start": 15.929,
      "end": 17.192,
      "src": "output/anim/closet-monster/shot_11.mp4",
      "src_dur": 1.867,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": null,
      "override": {},
      "dur": 1.263
    },
    {
      "n": 12,
      "text": "Dinner was a sticky note on the fridge.",
      "start": 17.192,
      "end": 18.776,
      "src": "output/anim/closet-monster/shot_12.mp4",
      "src_dur": 2.2,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": null,
      "override": {},
      "dur": 1.584
    },
    {
      "n": 13,
      "text": "\"Love you. Microwave for two minutes.\"",
      "start": 18.776,
      "end": 20.532,
      "src": "output/anim/closet-monster/shot_13.mp4",
      "src_dur": 2.4,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": null,
      "override": {},
      "dur": 1.756
    },
    {
      "n": 14,
      "text": "So I really wanted a monster. Just someone to talk to.",
      "start": 20.532,
      "end": 23.157,
      "src": "output/anim/closet-monster/shot_14.mp4",
      "src_dur": 3.267,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": null,
      "override": {},
      "dur": 2.625
    },
    {
      "n": 15,
      "text": "I left cookies.",
      "start": 23.157,
      "end": 24.152,
      "src": "output/anim/closet-monster/shot_15.mp4",
      "src_dur": 1.6,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": null,
      "override": {},
      "dur": 0.995
    },
    {
      "n": 16,
      "text": "I left the nightlight on.",
      "start": 24.152,
      "end": 25.343,
      "src": "output/anim/closet-monster/shot_16.mp4",
      "src_dur": 1.8,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": null,
      "override": {},
      "dur": 1.191
    },
    {
      "n": 17,
      "text": "I even made a sign: \"Monster Wanted.\"",
      "start": 25.343,
      "end": 27.341,
      "src": "output/anim/closet-monster/shot_17.mp4",
      "src_dur": 2.6,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": null,
      "override": {},
      "dur": 1.998
    },
    {
      "n": 18,
      "text": "Every night, I opened the closet. Nothing.",
      "start": 27.341,
      "end": 29.655,
      "src": "output/anim/closet-monster/shot_18.mp4",
      "src_dur": 2.933,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": null,
      "override": {},
      "dur": 2.314
    },
    {
      "n": 19,
      "text": "The cookies were always gone by morning, though.",
      "start": 29.655,
      "end": 31.436,
      "src": "output/anim/closet-monster/shot_19.mp4",
      "src_dur": 2.4,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": null,
      "override": {},
      "dur": 1.781
    },
    {
      "n": 20,
      "text": "And Mom said when I was a baby, I never cried at night.",
      "start": 31.436,
      "end": 33.661,
      "src": "output/anim/closet-monster/shot_20.mp4",
      "src_dur": 2.867,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": null,
      "override": {},
      "dur": 2.225
    },
    {
      "n": 21,
      "text": "Something always hummed me back to sleep.",
      "start": 33.661,
      "end": 35.48,
      "src": "output/anim/closet-monster/shot_21.mp4",
      "src_dur": 2.467,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": null,
      "override": {},
      "dur": 1.819
    },
    {
      "n": 22,
      "text": "On my twelfth birthday, nobody came home.",
      "start": 35.48,
      "end": 37.282,
      "src": "output/anim/closet-monster/shot_22.mp4",
      "src_dur": 2.467,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": null,
      "override": {},
      "dur": 1.802
    },
    {
      "n": 23,
      "text": "But taped inside my closet door, I found a note.",
      "start": 37.282,
      "end": 39.418,
      "src": "output/anim/closet-monster/shot_23.mp4",
      "src_dur": 2.8,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": null,
      "override": {},
      "dur": 2.136
    },
    {
      "n": 24,
      "text": "Old. Yellow. In my handwriting.",
      "start": 39.418,
      "end": 41.75,
      "src": "output/anim/closet-monster/shot_24.mp4",
      "src_dur": 2.933,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": null,
      "override": {},
      "dur": 2.332
    },
    {
      "n": 25,
      "text": "\"Don't open the closet at midnight. Trust me.\"",
      "start": 41.75,
      "end": 43.85,
      "src": "output/anim/closet-monster/shot_25.mp4",
      "src_dur": 2.733,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": null,
      "override": {},
      "dur": 2.1
    },
    {
      "n": 26,
      "text": "I didn't write that. At least... not yet.",
      "start": 43.85,
      "end": 46.005,
      "src": "output/anim/closet-monster/shot_26.mp4",
      "src_dur": 2.8,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": null,
      "override": {},
      "dur": 2.155
    },
    {
      "n": 27,
      "text": "At midnight, I opened it anyway.",
      "start": 46.005,
      "end": 47.466,
      "src": "output/anim/closet-monster/shot_27.mp4",
      "src_dur": 2.067,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": null,
      "override": {},
      "dur": 1.461
    },
    {
      "n": 28,
      "text": "I just didn't want to be alone.",
      "start": 47.466,
      "end": 48.937,
      "src": "output/anim/closet-monster/shot_28.mp4",
      "src_dur": 2.133,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": null,
      "override": {},
      "dur": 1.471
    },
    {
      "n": 29,
      "text": "It wasn't empty anymore. It was a tunnel, glowing at the bottom.",
      "start": 48.937,
      "end": 51.809,
      "src": "output/anim/closet-monster/shot_29.mp4",
      "src_dur": 3.533,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": null,
      "override": {},
      "dur": 2.872
    },
    {
      "n": 30,
      "text": "I fell, and fell,",
      "start": 51.809,
      "end": 52.529,
      "src": "output/anim/closet-monster/shot_30.mp4",
      "src_dur": 1.333,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": null,
      "override": {},
      "dur": 0.72
    },
    {
      "n": 31,
      "text": "and landed... in a closet.",
      "start": 52.529,
      "end": 53.74,
      "src": "output/anim/closet-monster/shot_31.mp4",
      "src_dur": 1.867,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": null,
      "override": {},
      "dur": 1.211
    },
    {
      "n": 32,
      "text": "My closet. Twelve years ago.",
      "start": 53.74,
      "end": 55.697,
      "src": "output/anim/closet-monster/shot_32.mp4",
      "src_dur": 2.6,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": null,
      "override": {},
      "dur": 1.957
    },
    {
      "n": 33,
      "text": "Through the crack in the door, there was a crib.",
      "start": 55.697,
      "end": 57.339,
      "src": "output/anim/closet-monster/shot_33.mp4",
      "src_dur": 2.267,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": null,
      "override": {},
      "dur": 1.642
    },
    {
      "n": 34,
      "text": "And a baby. Crying. Me.",
      "start": 57.339,
      "end": 59.598,
      "src": "output/anim/closet-monster/shot_34.mp4",
      "src_dur": 2.867,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": null,
      "override": {},
      "dur": 2.259
    },
    {
      "n": 35,
      "text": "My closet was never empty. Its monster was just hiding.",
      "start": 59.598,
      "end": 62.629,
      "src": "output/anim/closet-monster/shot_35.mp4",
      "src_dur": 3.667,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": null,
      "override": {},
      "dur": 3.031
    },
    {
      "n": 36,
      "text": "I could have knocked.",
      "start": 62.629,
      "end": 63.566,
      "src": "output/anim/closet-monster/shot_36.mp4",
      "src_dur": 1.6,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": null,
      "override": {},
      "dur": 0.937
    },
    {
      "n": 37,
      "text": "Every single night, I could have knocked.",
      "start": 63.566,
      "end": 65.101,
      "src": "output/anim/closet-monster/shot_37.mp4",
      "src_dur": 2.2,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": null,
      "override": {},
      "dur": 1.535
    },
    {
      "n": 38,
      "text": "But if he'd had a friend, he never would've opened that door at midnight.",
      "start": 65.101,
      "end": 67.566,
      "src": "output/anim/closet-monster/shot_38.mp4",
      "src_dur": 3.067,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": null,
      "override": {},
      "dur": 2.465
    },
    {
      "n": 39,
      "text": "And I'd never be here to hum when he cries.",
      "start": 67.566,
      "end": 69.442,
      "src": "output/anim/closet-monster/shot_39.mp4",
      "src_dur": 2.533,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": null,
      "override": {},
      "dur": 1.876
    },
    {
      "n": 40,
      "text": "So I stayed in the dark.",
      "start": 69.442,
      "end": 70.667,
      "src": "output/anim/closet-monster/shot_40.mp4",
      "src_dur": 1.867,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": null,
      "override": {},
      "dur": 1.225
    },
    {
      "n": 41,
      "text": "I ate the cookies.",
      "start": 70.667,
      "end": 71.693,
      "src": "output/anim/closet-monster/shot_41.mp4",
      "src_dur": 1.667,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": null,
      "override": {},
      "dur": 1.026
    },
    {
      "n": 42,
      "text": "I read the sticky notes too.",
      "start": 71.693,
      "end": 73.159,
      "src": "output/anim/closet-monster/shot_42.mp4",
      "src_dur": 2.067,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": null,
      "override": {},
      "dur": 1.466
    },
    {
      "n": 43,
      "text": "Tonight, he turns twelve. Nobody's coming home.",
      "start": 73.159,
      "end": 75.612,
      "src": "output/anim/closet-monster/shot_43.mp4",
      "src_dur": 3.067,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": null,
      "override": {},
      "dur": 2.453
    },
    {
      "n": 44,
      "text": "I'm taping a note inside the door. In my handwriting.",
      "start": 75.612,
      "end": 78.314,
      "src": "output/anim/closet-monster/shot_44.mp4",
      "src_dur": 3.333,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": null,
      "override": {},
      "dur": 2.702
    },
    {
      "n": 45,
      "text": "\"Don't open the closet at midnight. Trust me.\"",
      "start": 78.314,
      "end": 80.414,
      "src": "output/anim/closet-monster/shot_45.mp4",
      "src_dur": 2.733,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": null,
      "override": {},
      "dur": 2.1
    },
    {
      "n": 46,
      "text": "He won't listen.",
      "start": 80.414,
      "end": 81.357,
      "src": "output/anim/closet-monster/shot_46.mp4",
      "src_dur": 1.6,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": null,
      "override": {},
      "dur": 0.943
    },
    {
      "n": 47,
      "text": "I didn't.",
      "start": 81.357,
      "end": 83.582,
      "src": "output/anim/closet-monster/shot_47.mp4",
      "src_dur": 2.867,
      "motion": "push_in",
