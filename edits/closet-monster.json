   "end": 41.75,
   "src": "output/anim/closet-monster/shot_24.mp4",
   "src_dur": 2.933,
   "motion": "push_in",
   "transition": "cut",
   "grade": "neutral",
   "placeholder": null,
   "override": {},
   "dur": 2.332
  },
  {
   "n": 25,
   "text": "\"Don't open the closet at midnight. Trust me.\"",
   "start": 41.75,
   "end": 43.85,
   "src": "output/anim/closet-monster/shot_25.mp4",
   "src_dur": 2.733,
   "motion": "push_in",
   "transition": "cut",
   "grade": "neutral",
   "placeholder": null,
   "override": {},
   "dur": 2.1
  },
  {
   "n": 26,
   "text": "I didn't write that. At least... not yet.",
   "start": 43.85,
   "end": 46.005,
   "src": "output/anim/closet-monster/shot_26.mp4",
   "src_dur": 2.8,
   "motion": "push_in",
   "transition": "cut",
   "grade": "neutral",
   "placeholder": null,
   "override": {},
   "dur": 2.155
  },
  {
   "n": 27,
   "text": "At midnight, I opened it anyway.",
   "start": 46.005,
   "end": 47.466,
   "src": "output/anim/closet-monster/shot_27.mp4",
   "src_dur": 2.067,
   "motion": "push_in",
   "transition": "cut",
   "grade": "neutral",
   "placeholder": null,
   "override": {},
   "dur": 1.461
  },
  {
   "n": 28,
   "text": "I just didn't want to be alone.",
