   "end": 33.661,
   "src": "output/anim/closet-monster/shot_20.mp4",
   "src_dur": 2.867,
   "motion": "push_in",
   "transition": "cut",
   "grade": "neutral",
   "placeholder": null,
   "override": {},
   "dur": 2.225
  },
  {
   "n": 21,
   "text": "Something always hummed me back to sleep.",
