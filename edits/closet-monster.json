   "end": 35.48,
   "src": "output/anim/closet-monster/shot_21.mp4",
   "src_dur": 2.467,
   "motion": "push_in",
   "transition": "cut",
   "grade": "neutral",
   "placeholder": null,
   "override": {},
   "dur": 1.819
  },
  {
   "n": 22,
   "text": "On my twelfth birthday, nobody came home.",
