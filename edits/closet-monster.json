{
  "slug": "closet-monster",
  "title": "The Monster in My Closet",
  "timing": "estimated",
  "voice": null,
  "duration": 127.993,
  "shots": [
    {
      "n": 1,
      "text": "In this town, every closet has a monster in it.",
      "start": 0.0,
      "end": 3.939,
      "src": null,
      "src_dur": null,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": "house / tunnel | see story code | 1.8",
      "override": {},
      "dur": 3.939
    },
    {
      "n": 2,
      "text": "They're not scary. They're roommates.",
      "start": 3.939,
      "end": 6.469,
      "src": null,
      "src_dur": null,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": "house / tunnel | see story code | 1.8",
      "override": {},
      "dur": 2.53
    },
    {
      "n": 3,
      "text": "Some steal socks.",
      "start": 6.469,
      "end": 7.8,
      "src": null,
      "src_dur": null,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": "house / tunnel | see story code | 1.8",
      "override": {},
      "dur": 1.331
    },
    {
      "n": 4,
      "text": "Some snore so loud the hangers rattle.",
      "start": 7.8,
      "end": 10.524,
      "src": null,
      "src_dur": null,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": "house / tunnel | see story code | 1.8",
      "override": {},
      "dur": 2.724
    },
    {
      "n": 5,
      "text": "My cousin's monster does his homework.",
      "start": 10.524,
      "end": 13.056,
      "src": null,
      "src_dur": null,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": "house / tunnel | see story code | 1.8",
      "override": {},
      "dur": 2.532
    },
    {
      "n": 6,
      "text": "Badly.",
      "start": 13.056,
      "end": 13.676,
      "src": null,
      "src_dur": null,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": "house / tunnel | see story code | 1.8",
      "override": {},
      "dur": 0.62
    },
    {
      "n": 7,
      "text": "You get your monster the day you're born.",
      "start": 13.676,
      "end": 16.681,
      "src": null,
      "src_dur": null,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": "house / tunnel | see story code | 1.8",
      "override": {},
      "dur": 3.005
    },
    {
      "n": 8,
      "text": "It moves in, and it never leaves.",
      "start": 16.681,
      "end": 19.328,
      "src": null,
      "src_dur": null,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": "house / tunnel | see story code | 1.8",
      "override": {},
      "dur": 2.647
    },
    {
      "n": 9,
      "text": "But my closet was empty.",
      "start": 19.328,
      "end": 21.252,
      "src": null,
      "src_dur": null,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": "house / tunnel | see story code | 1.8",
      "override": {},
      "dur": 1.924
    },
    {
      "n": 10,
      "text": "Dad worked late. Every night.",
      "start": 21.252,
      "end": 23.544,
      "src": null,
      "src_dur": null,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": "house / tunnel | see story code | 1.8",
      "override": {},
      "dur": 2.292
    },
    {
      "n": 11,
      "text": "Mom worked even later.",
      "start": 23.544,
      "end": 25.217,
      "src": null,
      "src_dur": null,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": "house / tunnel | see story code | 1.8",
      "override": {},
      "dur": 1.673
    },
    {
      "n": 12,
      "text": "Dinner was a sticky note on the fridge.",
      "start": 25.217,
      "end": 28.163,
      "src": null,
      "src_dur": null,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": "house / tunnel | see story code | 1.8",
      "override": {},
      "dur": 2.946
    },
    {
      "n": 13,
      "text": "\"Love you. Microwave for two minutes.\"",
      "start": 28.163,
      "end": 30.606,
      "src": null,
      "src_dur": null,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": "house / tunnel | see story code | 1.8",
      "override": {},
      "dur": 2.443
    },
    {
      "n": 14,
      "text": "So I really wanted a monster. Just someone to talk to.",
      "start": 30.606,
      "end": 34.794,
      "src": null,
      "src_dur": null,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": "house / tunnel | see story code | 1.8",
      "override": {},
      "dur": 4.188
    },
    {
      "n": 15,
      "text": "I left cookies.",
      "start": 34.794,
      "end": 36.067,
      "src": null,
      "src_dur": null,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": "house / tunnel | see story code | 1.8",
      "override": {},
      "dur": 1.273
    },
    {
      "n": 16,
      "text": "I left the nightlight on.",
      "start": 36.067,
      "end": 38.02,
      "src": null,
      "src_dur": null,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": "house / tunnel | see story code | 1.8",
      "override": {},
      "dur": 1.953
    },
    {
      "n": 17,
      "text": "I even made a sign: \"Monster Wanted.\"",
      "start": 38.02,
      "end": 40.476,
      "src": null,
      "src_dur": null,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": "house / tunnel | see story code | 1.8",
      "override": {},
      "dur": 2.456
    },
    {
      "n": 18,
      "text": "Every night, I opened the closet. Nothing.",
      "start": 40.476,
      "end": 43.609,
      "src": null,
      "src_dur": null,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": "house / tunnel | see story code | 1.8",
      "override": {},
      "dur": 3.133
    },
    {
      "n": 19,
      "text": "The cookies were always gone by morning, though.",
      "start": 43.609,
      "end": 46.893,
      "src": null,
      "src_dur": null,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": "house / tunnel | see story code | 1.8",
      "override": {},
      "dur": 3.284
    },
    {
      "n": 20,
      "text": "And Mom said when I was a baby, I never cried at night.",
      "start": 46.893,
      "end": 51.346,
      "src": null,
      "src_dur": null,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": "house / tunnel | see story code | 1.8",
      "override": {},
      "dur": 4.453
    },
    {
      "n": 21,
      "text": "Something always hummed me back to sleep.",
      "start": 51.346,
      "end": 54.159,
      "src": null,
      "src_dur": null,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": "house / tunnel | see story code | 1.8",
      "override": {},
      "dur": 2.813
    },
    {
      "n": 22,
      "text": "On my twelfth birthday, nobody came home.",
      "start": 54.159,
      "end": 57.043,
      "src": null,
      "src_dur": null,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": "house / tunnel | see story code | 1.8",
      "override": {},
      "dur": 2.884
    },
    {
      "n": 23,
      "text": "But taped inside my closet door, I found a note.",
      "start": 57.043,
      "end": 60.711,
      "src": null,
      "src_dur": null,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": "house / tunnel | see story code | 1.8",
      "override": {},
      "dur": 3.668
    },
    {
      "n": 24,
      "text": "Old. Yellow. In my handwriting.",
      "start": 60.711,
      "end": 63.283,
      "src": null,
      "src_dur": null,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": "house / tunnel | see story code | 1.8",
      "override": {},
      "dur": 2.572
    },
    {
      "n": 25,
      "text": "\"Don't open the closet at midnight. Trust me.\"",
      "start": 63.283,
      "end": 66.348,
      "src": null,
      "src_dur": null,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": "house / tunnel | see story code | 1.8",
      "override": {},
      "dur": 3.065
    },
    {
      "n": 26,
      "text": "I didn't write that. At least... not yet.",
      "start": 66.348,
      "end": 69.735,
      "src": null,
      "src_dur": null,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": "house / tunnel | see story code | 1.8",
      "override": {},
      "dur": 3.387
    },
    {
      "n": 27,
      "text": "At midnight, I opened it anyway.",
      "start": 69.735,
      "end": 72.159,
      "src": null,
      "src_dur": null,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": "house / tunnel | see story code | 1.8",
      "override": {},
      "dur": 2.424
    },
    {
      "n": 28,
      "text": "I just didn't want to be alone.",
      "start": 72.159,
      "end": 74.676,
      "src": null,
      "src_dur": null,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": "house / tunnel | see story code | 1.8",
      "override": {},
      "dur": 2.517
    },
    {
      "n": 29,
      "text": "It wasn't empty anymore. It was a tunnel, glowing at the bottom.",
      "start": 74.676,
      "end": 79.424,
      "src": null,
      "src_dur": null,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": "house / tunnel | see story code | 1.8",
      "override": {},
      "dur": 4.748
    },
    {
      "n": 30,
      "text": "I fell, and fell,",
      "start": 79.424,
      "end": 80.869,
      "src": null,
      "src_dur": null,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": "house / tunnel | see story code | 1.8",
      "override": {},
      "dur": 1.445
    },
    {
      "n": 31,
      "text": "and landed... in a closet.",
      "start": 80.869,
      "end": 83.013,
      "src": null,
      "src_dur": null,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": "house / tunnel | see story code | 1.8",
      "override": {},
      "dur": 2.144
    },
    {
      "n": 32,
      "text": "My closet. Twelve years ago.",
      "start": 83.013,
      "end": 85.276,
      "src": null,
      "src_dur": null,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": "house / tunnel | see story code | 1.8",
      "override": {},
      "dur": 2.263
    },
    {
      "n": 33,
      "text": "Through the crack in the door, there was a crib.",
      "start": 85.276,
      "end": 88.944,
      "src": null,
      "src_dur": null,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": "house / tunnel | see story code | 1.8",
      "override": {},
      "dur": 3.668
    },
    {
      "n": 34,
      "text": "And a baby. Crying. Me.",
      "start": 88.944,
      "end": 91.28,
      "src": null,
      "src_dur": null,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": "house / tunnel | see story code | 1.8",
      "override": {},
      "dur": 2.336
    },
    {
      "n": 35,
      "text": "My closet was never empty. Its monster was just hiding.",
      "start": 91.28,
      "end": 95.306,
      "src": null,
      "src_dur": null,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": "house / tunnel | see story code | 1.8",
      "override": {},
      "dur": 4.026
    },
    {
      "n": 36,
      "text": "I could have knocked.",
      "start": 95.306,
      "end": 96.948,
      "src": null,
      "src_dur": null,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": "house / tunnel | see story code | 1.8",
      "override": {},
      "dur": 1.642
    },
    {
      "n": 37,
      "text": "Every single night, I could have knocked.",
      "start": 96.948,
      "end": 99.831,
      "src": null,
      "src_dur": null,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": "house / tunnel | see story code | 1.8",
      "override": {},
      "dur": 2.883
    },
    {
      "n": 38,
      "text": "But if he'd had a friend, he never would've opened that door at midnight.",
      "start": 99.831,
      "end": 105.011,
      "src": null,
      "src_dur": null,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": "house / tunnel | see story code | 1.8",
      "override": {},
      "dur": 5.18
    },
    {
      "n": 39,
      "text": "And I'd never be here to hum when he cries.",
      "start": 105.011,
      "end": 108.461,
      "src": null,
      "src_dur": null,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": "house / tunnel | see story code | 1.8",
      "override": {},
      "dur": 3.45
    },
    {
      "n": 40,
      "text": "So I stayed in the dark.",
      "start": 108.461,
      "end": 110.578,
      "src": null,
      "src_dur": null,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": "house / tunnel | see story code | 1.8",
      "override": {},
      "dur": 2.117
    },
    {
      "n": 41,
      "text": "I ate the cookies.",
      "start": 110.578,
      "end": 112.131,
      "src": null,
      "src_dur": null,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": "house / tunnel | see story code | 1.8",
      "override": {},
      "dur": 1.553
    },
    {
      "n": 42,
      "text": "I read the sticky notes too.",
      "start": 112.131,
      "end": 114.367,
      "src": null,
      "src_dur": null,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": "house / tunnel | see story code | 1.8",
      "override": {},
      "dur": 2.236
    },
    {
      "n": 43,
      "text": "Tonight, he turns twelve. Nobody's coming home.",
      "start": 114.367,
      "end": 117.648,
      "src": null,
      "src_dur": null,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": "house / tunnel | see story code | 1.8",
      "override": {},
      "dur": 3.281
    },
    {
      "n": 44,
      "text": "I'm taping a note inside the door. In my handwriting.",
      "start": 117.648,
      "end": 121.615,
      "src": null,
      "src_dur": null,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": "house / tunnel | see story code | 1.8",
      "override": {},
      "dur": 3.967
    },
    {
      "n": 45,
      "text": "\"Don't open the closet at midnight. Trust me.\"",
      "start": 121.615,
      "end": 124.68,
      "src": null,
      "src_dur": null,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": "house / tunnel | see story code | 1.8",
      "override": {},
      "dur": 3.065
    },
    {
      "n": 46,
      "text": "He won't listen.",
      "start": 124.68,
      "end": 125.981,
      "src": null,
      "src_dur": null,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": "house / tunnel | see story code | 1.8",
      "override": {},
      "dur": 1.301
    },
    {
      "n": 47,
      "text": "I didn't.",
      "start": 125.981,
      "end": 127.993,
      "src": null,
      "src_dur": null,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": "house / tunnel | see story code | 1.8",
      "override": {},
      "dur": 2.012
    }
  ],
