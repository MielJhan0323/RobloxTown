{
  "slug": "closet-monster",
  "title": "The Monster in My Closet",
  "timing": "voice",
  "voice": "output/cache/closet-monster/voice_fx.wav",
  "duration": 87.051,
  "shots": [
    {
      "n": 1,
      "text": "In this town, every closet has a monster in it.",
      "start": 0.0,
      "end": 2.54,
      "src": "output/anim/closet-monster/shot_01.mp4",
      "src_dur": 3.2,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": null,
      "override": {},
      "dur": 2.54
    },
    {
      "n": 2,
      "text": "They're not scary. They're roommates.",
      "start": 2.54,
      "end": 4.28,
      "src": "output/anim/closet-monster/shot_02.mp4",
      "src_dur": 2.4,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": null,
      "override": {},
      "dur": 1.74
    },
    {
      "n": 3,
      "text": "Some steal socks.",
      "start": 4.28,
      "end": 5.18,
      "src": "output/anim/closet-monster/shot_03.mp4",
      "src_dur": 1.533,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": null,
      "override": {},
      "dur": 0.9
    },
    {
      "n": 4,
      "text": "Some snore so loud the hangers rattle.",
      "start": 5.18,
      "end": 7.24,
      "src": "output/anim/closet-monster/shot_04.mp4",
      "src_dur": 2.667,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": null,
      "override": {},
      "dur": 2.06
    },
    {
      "n": 5,
      "text": "My cousin's monster does his homework.",
      "start": 7.24,
      "end": 8.42,
      "src": "output/anim/closet-monster/shot_05.mp4",
      "src_dur": 1.8,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": null,
      "override": {},
      "dur": 1.18
    },
    {
      "n": 6,
      "text": "Badly.",
      "start": 8.42,
      "end": 8.87,
      "src": "output/anim/closet-monster/shot_06.mp4",
      "src_dur": 1.067,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": null,
      "override": {},
      "dur": 0.45
    },
    {
      "n": 7,
      "text": "You get your monster the day you're born.",
      "start": 8.87,
      "end": 11.25,
      "src": "output/anim/closet-monster/shot_07.mp4",
      "src_dur": 3.0,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": null,
      "override": {},
      "dur": 2.38
    },
    {
      "n": 8,
      "text": "It moves in, and it never leaves.",
      "start": 11.25,
      "end": 13.17,
      "src": "output/anim/closet-monster/shot_08.mp4",
      "src_dur": 2.533,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": null,
      "override": {},
      "dur": 1.92
    },
    {
      "n": 9,
      "text": "But my closet was empty.",
      "start": 13.17,
      "end": 14.63,
      "src": "output/anim/closet-monster/shot_09.mp4",
      "src_dur": 2.067,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": null,
      "override": {},
      "dur": 1.46
    },
    {
      "n": 10,
      "text": "Dad worked late. Every night.",
      "start": 14.63,
      "end": 16.38,
      "src": "output/anim/closet-monster/shot_10.mp4",
      "src_dur": 2.4,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": null,
      "override": {},
      "dur": 1.75
    },
    {
      "n": 11,
      "text": "Mom worked even later.",
      "start": 16.38,
      "end": 17.68,
      "src": "output/anim/closet-monster/shot_11.mp4",
      "src_dur": 1.933,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": null,
      "override": {},
      "dur": 1.3
    },
    {
      "n": 12,
      "text": "Dinner was a sticky note on the fridge.",
      "start": 17.68,
      "end": 19.34,
      "src": "output/anim/closet-monster/shot_12.mp4",
      "src_dur": 2.267,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": null,
      "override": {},
      "dur": 1.66
    },
    {
      "n": 13,
      "text": "\"Love you. Microwave for two minutes.\"",
      "start": 19.34,
      "end": 21.1,
      "src": "output/anim/closet-monster/shot_13.mp4",
      "src_dur": 2.4,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": null,
      "override": {},
      "dur": 1.76
    },
    {
      "n": 14,
      "text": "So I really wanted a monster. Just someone to talk to.",
      "start": 21.1,
      "end": 24.16,
      "src": "output/anim/closet-monster/shot_14.mp4",
      "src_dur": 3.667,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": null,
      "override": {},
      "dur": 3.06
    },
    {
      "n": 15,
      "text": "I left cookies.",
      "start": 24.16,
      "end": 25.18,
      "src": "output/anim/closet-monster/shot_15.mp4",
      "src_dur": 1.667,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": null,
      "override": {},
      "dur": 1.02
    },
    {
      "n": 16,
      "text": "I left the nightlight on.",
      "start": 25.18,
      "end": 25.88,
      "src": "output/anim/closet-monster/shot_16.mp4",
      "src_dur": 1.333,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": null,
      "override": {},
      "dur": 0.7
    },
    {
      "n": 17,
      "text": "I even made a sign: \"Monster Wanted.\"",
      "start": 25.88,
      "end": 27.92,
      "src": "output/anim/closet-monster/shot_17.mp4",
      "src_dur": 2.667,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": null,
      "override": {},
      "dur": 2.04
    },
    {
      "n": 18,
      "text": "Every night, I opened the closet. Nothing.",
      "start": 27.92,
      "end": 30.85,
      "src": "output/anim/closet-monster/shot_18.mp4",
      "src_dur": 3.533,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": null,
      "override": {},
      "dur": 2.93
    },
    {
      "n": 19,
      "text": "The cookies were always gone by morning, though.",
      "start": 30.85,
      "end": 32.53,
      "src": "output/anim/closet-monster/shot_19.mp4",
      "src_dur": 2.333,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": null,
      "override": {},
      "dur": 1.68
    },
    {
      "n": 20,
      "text": "And Mom said when I was a baby, I never cried at night.",
      "start": 32.53,
      "end": 34.85,
      "src": "output/anim/closet-monster/shot_20.mp4",
      "src_dur": 2.933,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": null,
      "override": {},
      "dur": 2.32
    },
    {
      "n": 21,
      "text": "Something always hummed me back to sleep.",
      "start": 34.85,
      "end": 36.83,
      "src": "output/anim/closet-monster/shot_21.mp4",
      "src_dur": 2.6,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": null,
      "override": {},
      "dur": 1.98
    },
    {
      "n": 22,
      "text": "On my twelfth birthday, nobody came home.",
      "start": 36.83,
      "end": 38.91,
      "src": "output/anim/closet-monster/shot_22.mp4",
      "src_dur": 2.733,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": null,
      "override": {},
      "dur": 2.08
    },
    {
      "n": 23,
      "text": "But taped inside my closet door, I found a note.",
      "start": 38.91,
      "end": 41.31,
      "src": "output/anim/closet-monster/shot_23.mp4",
      "src_dur": 3.0,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": null,
      "override": {},
      "dur": 2.4
    },
    {
      "n": 24,
      "text": "Old. Yellow. In my handwriting.",
      "start": 41.31,
      "end": 43.33,
      "src": "output/anim/closet-monster/shot_24.mp4",
      "src_dur": 2.667,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": null,
      "override": {},
      "dur": 2.02
    },
    {
      "n": 25,
      "text": "\"Don't open the closet at midnight. Trust me.\"",
      "start": 43.33,
      "end": 45.73,
      "src": "output/anim/closet-monster/shot_25.mp4",
      "src_dur": 3.0,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": null,
      "override": {},
      "dur": 2.4
    },
    {
      "n": 26,
      "text": "I didn't write that. At least... not yet.",
      "start": 45.73,
      "end": 48.07,
      "src": "output/anim/closet-monster/shot_26.mp4",
      "src_dur": 3.0,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": null,
      "override": {},
      "dur": 2.34
    },
    {
      "n": 27,
      "text": "At midnight, I opened it anyway.",
      "start": 48.07,
      "end": 49.96,
      "src": "output/anim/closet-monster/shot_27.mp4",
      "src_dur": 2.533,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": null,
      "override": {},
      "dur": 1.89
    },
    {
      "n": 28,
      "text": "I just didn't want to be alone.",
      "start": 49.96,
      "end": 51.46,
      "src": "output/anim/closet-monster/shot_28.mp4",
      "src_dur": 2.133,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": null,
      "override": {},
      "dur": 1.5
    },
    {
      "n": 29,
      "text": "It wasn't empty anymore. It was a tunnel, glowing at the bottom.",
      "start": 51.46,
      "end": 54.44,
      "src": "output/anim/closet-monster/shot_29.mp4",
      "src_dur": 3.6,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": null,
      "override": {},
      "dur": 2.98
    },
    {
      "n": 30,
      "text": "I fell, and fell,",
      "start": 54.44,
      "end": 55.4,
      "src": "output/anim/closet-monster/shot_30.mp4",
      "src_dur": 4.6,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": null,
      "override": {},
      "dur": 0.96
    },
    {
      "n": 31,
      "text": "and landed... in a closet.",
      "start": 55.4,
      "end": 56.93,
      "src": "output/anim/closet-monster/shot_31.mp4",
      "src_dur": 2.133,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": null,
      "override": {},
      "dur": 1.53
    },
    {
      "n": 32,
      "text": "My closet. Twelve years ago.",
      "start": 56.93,
      "end": 59.15,
      "src": "output/anim/closet-monster/shot_32.mp4",
      "src_dur": 2.867,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": null,
      "override": {},
      "dur": 2.22
    },
    {
      "n": 33,
      "text": "Through the crack in the door, there was a crib.",
      "start": 59.15,
      "end": 60.57,
      "src": "output/anim/closet-monster/shot_33.mp4",
      "src_dur": 2.067,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": null,
      "override": {},
      "dur": 1.42
    },
    {
      "n": 34,
      "text": "And a baby. Crying. Me.",
      "start": 60.57,
      "end": 63.19,
      "src": "output/anim/closet-monster/shot_34.mp4",
      "src_dur": 3.267,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": null,
      "override": {},
      "dur": 2.62
    },
    {
      "n": 35,
      "text": "My closet was never empty. Its monster was just hiding.",
      "start": 63.19,
      "end": 66.09,
      "src": "output/anim/closet-monster/shot_35.mp4",
      "src_dur": 3.533,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": null,
      "override": {},
      "dur": 2.9
    },
    {
      "n": 36,
      "text": "I could have knocked.",
      "start": 66.09,
      "end": 66.85,
      "src": "output/anim/closet-monster/shot_36.mp4",
      "src_dur": 1.4,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": null,
      "override": {},
      "dur": 0.76
    },
    {
      "n": 37,
      "text": "Every single night, I could have knocked.",
      "start": 66.85,
      "end": 68.87,
      "src": "output/anim/closet-monster/shot_37.mp4",
      "src_dur": 2.667,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": null,
      "override": {},
      "dur": 2.02
    },
    {
      "n": 38,
      "text": "But if he'd had a friend, he never would've opened that door at midnight.",
      "start": 68.87,
      "end": 71.53,
      "src": "output/anim/closet-monster/shot_38.mp4",
      "src_dur": 3.267,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": null,
      "override": {},
      "dur": 2.66
    },
    {
      "n": 39,
      "text": "And I'd never be here to hum when he cries.",
      "start": 71.53,
      "end": 73.47,
      "src": "output/anim/closet-monster/shot_39.mp4",
      "src_dur": 2.6,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": null,
      "override": {},
      "dur": 1.94
    },
    {
      "n": 40,
      "text": "So I stayed in the dark.",
      "start": 73.47,
      "end": 74.27,
      "src": "output/anim/closet-monster/shot_40.mp4",
      "src_dur": 1.4,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": null,
      "override": {},
      "dur": 0.8
    },
    {
      "n": 41,
      "text": "I ate the cookies.",
      "start": 74.27,
      "end": 75.62,
      "src": "output/anim/closet-monster/shot_41.mp4",
      "src_dur": 2.0,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": null,
      "override": {},
      "dur": 1.35
    },
    {
      "n": 42,
      "text": "I read the sticky notes too.",
      "start": 75.62,
      "end": 77.12,
      "src": "output/anim/closet-monster/shot_42.mp4",
      "src_dur": 2.133,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": null,
      "override": {},
      "dur": 1.5
    },
    {
      "n": 43,
      "text": "Tonight, he turns twelve. Nobody's coming home.",
      "start": 77.12,
      "end": 79.5,
      "src": "output/anim/closet-monster/shot_43.mp4",
      "src_dur": 3.0,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": null,
      "override": {},
      "dur": 2.38
    },
    {
      "n": 44,
      "text": "I'm taping a note inside the door. In my handwriting.",
      "start": 79.5,
      "end": 82.0,
      "src": "output/anim/closet-monster/shot_44.mp4",
      "src_dur": 3.133,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": null,
      "override": {},
      "dur": 2.5
    },
    {
      "n": 45,
      "text": "\"Don't open the closet at midnight. Trust me.\"",
      "start": 82.0,
      "end": 83.87,
      "src": "output/anim/closet-monster/shot_45.mp4",
      "src_dur": 2.533,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": null,
      "override": {},
      "dur": 1.87
    },
    {
      "n": 46,
      "text": "He won't listen.",
      "start": 83.87,
      "end": 85.05,
      "src": "output/anim/closet-monster/shot_46.mp4",
      "src_dur": 1.8,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": null,
      "override": {},
      "dur": 1.18
    },
    {
      "n": 47,
      "text": "I didn't.",
      "start": 85.05,
      "end": 87.051,
      "src": "output/anim/closet-monster/shot_47.mp4",
      "src_dur": 2.667,
      "motion": "push_in",
      "transition": "cut",
