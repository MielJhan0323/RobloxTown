{
 "slug": "the-knock-3",
 "title": "The Knock (Part 3 - Final)",
 "timing": "voice",
 "voice": "output/cache/the-knock-3/voice_fx.wav",
 "duration": 49.521,
 "shots": [
  {
   "n": 1,
   "text": "You picked the option I didn't even think of.",
   "start": 0.0,
   "end": 2.38,
   "src": null,
   "src_dur": null,
   "motion": "push_in",
   "transition": "cut",
   "grade": "neutral",
   "placeholder": "1.8",
   "override": {},
   "dur": 2.38
  },
  {
   "n": 2,
   "text": "The streetlights were back on.",
   "start": 2.38,
   "end": 3.88,
   "src": "output/anim/the-knock-3/shot_02.mp4",
   "src_dur": 3.133,
   "motion": "push_in",
   "transition": "cut",
   "grade": "neutral",
   "placeholder": null,
   "override": {},
   "dur": 1.5
  },
  {
   "n": 3,
   "text": "Knockers only come in the dark.",
   "start": 3.88,
   "end": 5.34,
   "src": "output/anim/the-knock-3/shot_03.mp4",
   "src_dur": 3.4,
   "motion": "push_in",
   "transition": "cut",
   "grade": "neutral",
   "placeholder": null,
   "override": {},
   "dur": 1.46
  },
  {
   "n": 4,
   "text": "So I ran.",
   "start": 5.34,
   "end": 6.3,
   "src": "output/anim/the-knock-3/shot_04.mp4",
   "src_dur": 1.933,
   "motion": "push_in",
   "transition": "cut",
   "grade": "neutral",
   "placeholder": null,
   "override": {},
   "dur": 0.96
  },
  {
   "n": 5,
   "text": "Down the hall.",
   "start": 6.3,
   "end": 7.0,
   "src": null,
   "src_dur": null,
   "motion": "push_in",
   "transition": "cut",
   "grade": "neutral",
   "placeholder": "1.8",
   "override": {},
   "dur": 0.7
  },
  {
   "n": 6,
   "text": "Past the stairs. I didn't look up.",
   "start": 7.0,
   "end": 8.48,
   "src": null,
   "src_dur": null,
   "motion": "push_in",
   "transition": "cut",
   "grade": "neutral",
   "placeholder": "1.8",
   "override": {},
   "dur": 1.48
  },
  {
   "n": 7,
   "text": "I threw open the front door,",
   "start": 8.48,
   "end": 9.58,
   "src": null,
   "src_dur": null,
   "motion": "push_in",
   "transition": "cut",
   "grade": "neutral",
   "placeholder": "1.8",
   "override": {},
   "dur": 1.1
  },
  {
   "n": 8,
   "text": "and the morning hit my face.",
   "start": 9.58,
   "end": 11.12,
   "src": null,
   "src_dur": null,
   "motion": "push_in",
   "transition": "cut",
   "grade": "neutral",
   "placeholder": "1.8",
   "override": {},
   "dur": 1.54
  },
  {
   "n": 9,
   "text": "Mrs. Parker was getting her newspaper.",
   "start": 11.12,
   "end": 12.54,
   "src": null,
   "src_dur": null,
   "motion": "push_in",
   "transition": "cut",
   "grade": "neutral",
   "placeholder": "1.8",
   "override": {},
   "dur": 1.42
  },
  {
   "n": 10,
   "text": "She saw my face and didn't ask a single question.",
   "start": 12.54,
   "end": 14.44,
   "src": null,
   "src_dur": null,
   "motion": "push_in",
   "transition": "cut",
   "grade": "neutral",
   "placeholder": "1.8",
   "override": {},
   "dur": 1.9
  },
  {
   "n": 11,
   "text": "She just pulled me inside.",
   "start": 14.44,
   "end": 16.08,
   "src": null,
   "src_dur": null,
   "motion": "push_in",
   "transition": "cut",
   "grade": "neutral",
   "placeholder": "1.8",
   "override": {},
   "dur": 1.64
  },
  {
   "n": 12,
   "text": "Mom was still on the phone.",
   "start": 16.08,
   "end": 17.24,
   "src": null,
   "src_dur": null,
   "motion": "push_in",
   "transition": "cut",
   "grade": "neutral",
   "placeholder": "1.8",
   "override": {},
   "dur": 1.16
  },
  {
   "n": 13,
   "text": "\"Stay there, bug. We're five minutes away.\"",
   "start": 17.24,
   "end": 18.96,
   "src": null,
   "src_dur": null,
   "motion": "push_in",
   "transition": "cut",
   "grade": "neutral",
   "placeholder": "1.8",
   "override": {},
   "dur": 1.72
  },
  {
   "n": 14,
   "text": "From the Parkers' window, I could see my house.",
   "start": 18.96,
   "end": 21.28,
   "src": null,
   "src_dur": null,
   "motion": "push_in",
   "transition": "cut",
   "grade": "neutral",
   "placeholder": "1.8",
   "override": {},
   "dur": 2.32
  },
  {
   "n": 15,
   "text": "My bedroom curtain moved.",
   "start": 21.28,
   "end": 22.86,
   "src": null,
   "src_dur": null,
   "motion": "push_in",
   "transition": "cut",
   "grade": "neutral",
   "placeholder": "1.8",
   "override": {},
   "dur": 1.58
  },
  {
   "n": 16,
   "text": "Something was standing in my window.",
   "start": 22.86,
   "end": 24.24,
   "src": null,
   "src_dur": null,
   "motion": "push_in",
   "transition": "cut",
   "grade": "neutral",
   "placeholder": "1.8",
   "override": {},
   "dur": 1.38
  },
  {
   "n": 17,
   "text": "Wearing my hoodie.",
   "start": 24.24,
   "end": 25.16,
   "src": null,
   "src_dur": null,
   "motion": "push_in",
   "transition": "cut",
   "grade": "neutral",
   "placeholder": "1.8",
   "override": {},
   "dur": 0.92
  },
  {
   "n": 18,
   "text": "It lifted its hand and waved. Slowly.",
   "start": 25.16,
   "end": 27.5,
   "src": null,
   "src_dur": null,
   "motion": "push_in",
   "transition": "cut",
   "grade": "neutral",
   "placeholder": "1.8",
   "override": {},
   "dur": 2.34
  },
  {
   "n": 19,
   "text": "The same way I wave.",
   "start": 27.5,
   "end": 28.74,
   "src": null,
   "src_dur": null,
   "motion": "push_in",
   "transition": "cut",
   "grade": "neutral",
   "placeholder": "1.8",
   "override": {},
   "dur": 1.24
  },
  {
   "n": 20,
   "text": "Then Mom and Dad's car pulled into the driveway.",
   "start": 28.74,
   "end": 30.52,
   "src": null,
   "src_dur": null,
   "motion": "push_in",
   "transition": "cut",
   "grade": "neutral",
   "placeholder": "1.8",
   "override": {},
   "dur": 1.78
  },
  {
   "n": 21,
   "text": "I ran across the street faster than I've ever run.",
   "start": 30.52,
   "end": 32.96,
   "src": null,
   "src_dur": null,
   "motion": "push_in",
   "transition": "cut",
   "grade": "neutral",
   "placeholder": "1.8",
   "override": {},
   "dur": 2.44
  },
  {
   "n": 22,
   "text": "Mom hugged me so hard my feet left the ground.",
   "start": 32.96,
   "end": 35.12,
   "src": null,
   "src_dur": null,
   "motion": "push_in",
   "transition": "cut",
   "grade": "neutral",
   "placeholder": "1.8",
   "override": {},
   "dur": 2.16
  },
  {
   "n": 23,
   "text": "\"Bug, you're okay. You're okay.\"",
   "start": 35.12,
   "end": 36.9,
   "src": null,
   "src_dur": null,
   "motion": "push_in",
   "transition": "cut",
   "grade": "neutral",
   "placeholder": "1.8",
   "override": {},
   "dur": 1.78
  },
  {
   "n": 24,
   "text": "Dad knelt down and messed up my hair. He smiled at me.",
   "start": 36.9,
   "end": 39.49,
   "src": null,
   "src_dur": null,
   "motion": "push_in",
   "transition": "cut",
   "grade": "neutral",
   "placeholder": "1.8",
   "override": {},
   "dur": 2.59
  },
  {
   "n": 25,
   "text": "\"Hey, kiddo.\"",
   "start": 39.49,
   "end": 40.29,
   "src": null,
   "src_dur": null,
   "motion": "push_in",
   "transition": "cut",
   "grade": "neutral",
   "placeholder": "1.8",
   "override": {},
   "dur": 0.8
  },
  {
   "n": 26,
   "text": "I looked at Mom. She didn't notice.",
   "start": 40.29,
   "end": 42.29,
   "src": null,
   "src_dur": null,
   "motion": "push_in",
   "transition": "cut",
   "grade": "neutral",
   "placeholder": "1.8",
   "override": {},
   "dur": 2.0
  },
  {
   "n": 27,
   "text": "Last night, something knocked on our back door and said, \"Something followed us.\"",
   "start": 42.29,
   "end": 45.57,
   "src": null,
   "src_dur": null,
   "motion": "push_in",
   "transition": "cut",
   "grade": "neutral",
   "placeholder": "1.8",
   "override": {},
   "dur": 3.28
  },
  {
   "n": 28,
   "text": "It wasn't lying.",
   "start": 45.57,
   "end": 46.82,
   "src": null,
   "src_dur": null,
   "motion": "push_in",
   "transition": "cut",
   "grade": "neutral",
   "placeholder": "1.8",
   "override": {},
   "dur": 1.25
  },
  {
   "n": 29,
   "text": "Dad never calls me kiddo.",
   "start": 46.82,
   "end": 49.521,
   "src": null,
   "src_dur": null,
   "motion": "push_in",
   "transition": "cut",
   "grade": "neutral",
   "placeholder": "1.8",
   "override": {},
   "dur": 2.701
  }
 ],
