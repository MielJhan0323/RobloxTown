{
  "slug": "the-knock-3",
  "title": "The Knock (Part 3 - Final)",
  "timing": "estimated",
  "voice": null,
  "duration": 74.796,
  "shots": [
    {
      "n": 1,
      "text": "You picked the option I didn't even think of.",
      "start": 0.0,
      "end": 3.617,
      "src": null,
      "src_dur": null,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": "1.8",
      "override": {},
      "dur": 3.617
    },
    {
      "n": 2,
      "text": "The streetlights were back on.",
      "start": 3.617,
      "end": 5.719,
      "src": null,
      "src_dur": null,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": "1.8",
      "override": {},
      "dur": 2.102
    },
    {
      "n": 3,
      "text": "Knockers only come in the dark.",
      "start": 5.719,
      "end": 8.043,
      "src": null,
      "src_dur": null,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": "1.8",
      "override": {},
      "dur": 2.324
    },
    {
      "n": 4,
      "text": "So I ran.",
      "start": 8.043,
      "end": 9.137,
      "src": null,
      "src_dur": null,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": "1.8",
      "override": {},
      "dur": 1.094
    },
    {
      "n": 5,
      "text": "Down the hall.",
      "start": 9.137,
      "end": 10.38,
      "src": null,
      "src_dur": null,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": "1.8",
      "override": {},
      "dur": 1.243
    },
    {
      "n": 6,
      "text": "Past the stairs. I didn't look up.",
      "start": 10.38,
      "end": 13.206,
      "src": null,
      "src_dur": null,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": "1.8",
      "override": {},
      "dur": 2.826
    },
    {
      "n": 7,
      "text": "I threw open the front door,",
      "start": 13.206,
      "end": 15.291,
      "src": null,
      "src_dur": null,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": "1.8",
      "override": {},
      "dur": 2.085
    },
    {
      "n": 8,
      "text": "and the morning hit my face.",
      "start": 15.291,
      "end": 17.526,
      "src": null,
      "src_dur": null,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": "1.8",
      "override": {},
      "dur": 2.235
    },
    {
      "n": 9,
      "text": "Mrs. Parker was getting her newspaper.",
      "start": 17.526,
      "end": 20.278,
      "src": null,
      "src_dur": null,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": "1.8",
      "override": {},
      "dur": 2.752
    },
    {
      "n": 10,
      "text": "She saw my face and didn't ask a single question.",
      "start": 20.278,
      "end": 23.906,
      "src": null,
      "src_dur": null,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": "1.8",
      "override": {},
      "dur": 3.628
    },
    {
      "n": 11,
      "text": "She just pulled me inside.",
      "start": 23.906,
      "end": 25.889,
      "src": null,
      "src_dur": null,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": "1.8",
      "override": {},
      "dur": 1.983
    },
    {
      "n": 12,
      "text": "Mom was still on the phone.",
      "start": 25.889,
      "end": 28.094,
      "src": null,
      "src_dur": null,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": "1.8",
      "override": {},
      "dur": 2.205
    },
    {
      "n": 13,
      "text": "\"Stay there, bug. We're five minutes away.\"",
      "start": 28.094,
      "end": 30.948,
      "src": null,
      "src_dur": null,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": "1.8",
      "override": {},
      "dur": 2.854
    },
    {
      "n": 14,
      "text": "From the Parkers' window, I could see my house.",
      "start": 30.948,
      "end": 34.365,
      "src": null,
      "src_dur": null,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": "1.8",
      "override": {},
      "dur": 3.417
    },
    {
      "n": 15,
      "text": "My bedroom curtain moved.",
      "start": 34.365,
      "end": 36.126,
      "src": null,
      "src_dur": null,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": "1.8",
      "override": {},
      "dur": 1.761
    },
    {
      "n": 16,
      "text": "Something was standing in my window.",
      "start": 36.126,
      "end": 38.598,
      "src": null,
      "src_dur": null,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": "1.8",
      "override": {},
      "dur": 2.472
    },
    {
      "n": 17,
      "text": "Wearing my hoodie.",
      "start": 38.598,
      "end": 39.959,
      "src": null,
      "src_dur": null,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": "1.8",
      "override": {},
      "dur": 1.361
    },
    {
      "n": 18,
      "text": "It lifted its hand and waved. Slowly.",
      "start": 39.959,
      "end": 42.874,
      "src": null,
      "src_dur": null,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": "1.8",
      "override": {},
      "dur": 2.915
    },
    {
      "n": 19,
      "text": "The same way I wave.",
      "start": 42.874,
      "end": 44.68,
      "src": null,
      "src_dur": null,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": "1.8",
      "override": {},
      "dur": 1.806
    },
    {
      "n": 20,
      "text": "Then Mom and Dad's car pulled into the driveway.",
      "start": 44.68,
      "end": 48.085,
      "src": null,
      "src_dur": null,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": "1.8",
      "override": {},
      "dur": 3.405
    },
    {
      "n": 21,
      "text": "I ran across the street faster than I've ever run.",
      "start": 48.085,
      "end": 51.743,
      "src": null,
      "src_dur": null,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": "1.8",
      "override": {},
      "dur": 3.658
    },
    {
      "n": 22,
      "text": "Mom hugged me so hard my feet left the ground.",
      "start": 51.743,
      "end": 55.281,
      "src": null,
      "src_dur": null,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": "1.8",
      "override": {},
      "dur": 3.538
    },
    {
      "n": 23,
      "text": "\"Bug, you're okay. You're okay.\"",
      "start": 55.281,
      "end": 57.424,
      "src": null,
      "src_dur": null,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": "1.8",
      "override": {},
      "dur": 2.143
    },
    {
      "n": 24,
      "text": "Dad knelt down and messed up my hair. He smiled at me.",
      "start": 57.424,
      "end": 61.806,
      "src": null,
      "src_dur": null,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": "1.8",
      "override": {},
      "dur": 4.382
    },
    {
      "n": 25,
      "text": "\"Hey, kiddo.\"",
      "start": 61.806,
      "end": 62.587,
      "src": null,
      "src_dur": null,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": "1.8",
      "override": {},
      "dur": 0.781
    },
    {
      "n": 26,
      "text": "I looked at Mom. She didn't notice.",
      "start": 62.587,
      "end": 65.443,
      "src": null,
      "src_dur": null,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": "1.8",
      "override": {},
      "dur": 2.856
    },
    {
      "n": 27,
      "text": "Last night, something knocked on our back door and said, \"Something followed us.\"",
      "start": 65.443,
      "end": 70.428,
      "src": null,
      "src_dur": null,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": "1.8",
      "override": {},
      "dur": 4.985
    },
    {
      "n": 28,
      "text": "It wasn't lying.",
      "start": 70.428,
      "end": 71.73,
      "src": null,
      "src_dur": null,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": "1.8",
      "override": {},
      "dur": 1.302
    },
    {
      "n": 29,
      "text": "Dad never calls me kiddo.",
      "start": 71.73,
      "end": 74.796,
      "src": null,
      "src_dur": null,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": "1.8",
      "override": {},
      "dur": 3.066
    }
  ],
