      "motion": "push_in",
      "transition": "cut",
      "grade": "cool",
      "placeholder": "B desk | Narrator | tired | close | papers, maps",
      "override": {},
      "dur": 2.205
    },
    {
      "n": 19,
      "text": "My cousin said our house was built on an old graveyard.",
