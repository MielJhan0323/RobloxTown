      "end": 19.706,
      "src": null,
      "src_dur": null,
      "motion": "push_in",
      "transition": "cut",
      "grade": "cool",
      "placeholder": "B bedroom | Narrator in bed | shocked, eyes open | medium | bed, blanket",
      "override": {},
      "dur": 1.643
    },
    {
      "n": 12,
      "text": "On the second night, I heard footsteps in the hall.",
      "start": 19.706,
      "end": 23.463,
      "src": null,
      "src_dur": null,
      "motion": "push_in",
      "transition": "cut",
      "grade": "cool",
      "placeholder": "B bedroom door | Narrator sits up | scared | medium | door ajar",
      "override": {},
      "dur": 3.757
    },
    {
      "n": 13,
      "text": "On the third night,",
      "start": 23.463,
      "end": 24.896,
      "src": null,
      "src_dur": null,
      "motion": "push_in",
      "transition": "cut",
      "grade": "cool",
      "placeholder": "B hallway | wide | dark hall",
      "override": {},
      "dur": 1.433
    },
    {
      "n": 14,
      "text": "the fridge was glowing in the dark.",
      "start": 24.896,
      "end": 27.531,
      "src": null,
      "src_dur": null,
      "motion": "push_in",
      "transition": "cut",
      "grade": "cool",
      "placeholder": "B kitchen | medium, push-in | fridge light",
      "override": {},
      "dur": 2.635
    },
    {
      "n": 15,
      "text": "And then the vent started whispering.",
      "start": 27.531,
      "end": 30.033,
      "src": null,
      "src_dur": null,
      "motion": "push_in",
      "transition": "cut",
      "grade": "cool",
      "placeholder": "B bedroom | Narrator ear to vent | worried | medium | vent",
      "override": {},
      "dur": 2.502
    },
    {
      "n": 16,
      "text": "\"Over. Do you copy? Over.\"",
      "start": 30.033,
      "end": 32.148,
      "src": null,
      "src_dur": null,
      "motion": "push_in",
      "transition": "cut",
      "grade": "cool",
      "placeholder": "B vent | close insert | vent grille",
      "override": {},
      "dur": 2.115
    },
    {
      "n": 17,
      "text": "I stopped sleeping.",
      "start": 32.148,
      "end": 33.539,
      "src": null,
      "src_dur": null,
      "motion": "push_in",
      "transition": "cut",
      "grade": "cool",
      "placeholder": "B bedroom | Narrator under blanket, flashlight | tired | medium | flashlight",
      "override": {},
      "dur": 1.391
    },
    {
      "n": 18,
      "text": "I drew maps of every sound.",
