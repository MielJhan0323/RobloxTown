  "duration": 68.584,
  "shots": [
    {
      "n": 1,
      "text": "In this town,",
      "start": 0.0,
      "end": 0.85,
      "src": "raw/lighthouse/shot_01.mov",
      "src_dur": 3.783,
      "motion": "push_in",
      "transition": "cut",
      "grade": "warm",
      "placeholder": null,
      "override": {},
      "dur": 0.85
    },
    {
      "n": 2,
      "text": "the lighthouse shines for anyone who's lost.",
      "start": 0.85,
      "end": 2.578,
      "src": "raw/lighthouse/shot_02.mov",
      "src_dur": 4.767,
      "motion": "push_in",
      "transition": "cut",
      "grade": "warm",
      "placeholder": null,
      "override": {},
      "dur": 1.728
    },
    {
      "n": 3,
      "text": "Not just ships.",
      "start": 2.578,
      "end": 3.693,
      "src": "raw/lighthouse/shot_03.mov",
      "src_dur": 3.733,
      "motion": "pan_right",
      "transition": "cut",
      "grade": "warm",
      "placeholder": null,
      "override": {},
      "dur": 1.115
    },
    {
      "n": 4,
      "text": "People.",
      "start": 3.693,
      "end": 4.559,
      "src": "raw/lighthouse/shot_04.mov",
      "src_dur": 5.55,
      "motion": "punch",
      "transition": "cut",
      "grade": "warm",
      "placeholder": null,
      "override": {},
      "dur": 0.866
    },
    {
      "n": 5,
      "text": "When Tommy Briggs got lost at the summer fair,",
      "start": 4.559,
      "end": 6.579,
      "src": "raw/lighthouse/shot_05.mov",
      "src_dur": 4.583,
      "motion": "pan_left",
      "transition": "cut",
      "grade": "warm",
      "placeholder": null,
      "override": {},
      "dur": 2.02
    },
    {
      "n": 6,
      "text": "the beam found him at the cotton candy stand.",
      "start": 6.579,
      "end": 8.429,
      "src": "raw/lighthouse/shot_06.mov",
      "src_dur": 3.483,
      "motion": "push_in",
      "transition": "cut",
      "grade": "warm",
      "placeholder": null,
      "override": {},
      "dur": 1.85
    },
    {
      "n": 7,
      "text": "When Mrs. Alder lost her glasses,",
      "start": 8.429,
      "end": 10.049,
      "src": "raw/lighthouse/shot_07.mov",
      "src_dur": 3.5,
      "motion": "push_in",
      "transition": "cut",
      "grade": "warm",
      "placeholder": null,
      "override": {},
      "dur": 1.62
    },
    {
      "n": 8,
      "text": "it lit up her own head.",
      "start": 10.049,
      "end": 11.038,
      "src": "raw/lighthouse/shot_08.mov",
      "src_dur": 4.6,
      "motion": "punch",
      "transition": "cut",
      "grade": "warm",
      "placeholder": null,
      "override": {},
      "dur": 0.989
    },
    {
      "n": 9,
      "text": "They were on it.",
      "start": 11.038,
      "end": 12.023,
      "src": "raw/lighthouse/shot_09.mov",
      "src_dur": 3.75,
      "motion": "push_in",
      "transition": "cut",
      "grade": "warm",
      "placeholder": null,
      "override": {
        "src": "raw/lighthouse/shot_08.mov",
        "src_in": 2.6,
        "motion": "punch"
      },
      "dur": 0.985
    },
    {
      "n": 10,
      "text": "And when my dad lost his job,",
      "start": 12.023,
      "end": 13.663,
      "src": "raw/lighthouse/shot_10.mov",
      "src_dur": 3.767,
      "motion": "push_in",
      "transition": "cut",
      "grade": "cool",
      "placeholder": null,
      "override": {},
      "dur": 1.64
    },
    {
      "n": 11,
      "text": "it shone on our porch for a whole week.",
      "start": 13.663,
      "end": 15.364,
      "src": "raw/lighthouse/shot_11.mov",
      "src_dur": 3.767,
      "motion": "push_in",
      "transition": "cut",
      "grade": "cool",
      "placeholder": null,
      "override": {},
      "dur": 1.701
    },
    {
      "n": 12,
      "text": "He pretended not to notice.",
      "start": 15.364,
      "end": 17.049,
      "src": "raw/lighthouse/shot_12.mov",
      "src_dur": 2.65,
      "motion": "push_in",
      "transition": "cut",
      "grade": "cool",
      "placeholder": null,
      "override": {},
      "dur": 1.685
    },
    {
      "n": 13,
      "text": "He noticed.",
      "start": 17.049,
      "end": 18.13,
      "src": "raw/lighthouse/shot_13.mov",
      "src_dur": 3.783,
      "motion": "punch",
      "transition": "cut",
      "grade": "cool",
      "placeholder": null,
      "override": {},
      "dur": 1.081
    },
    {
      "n": 14,
      "text": "Then, we moved.",
      "start": 18.13,
      "end": 19.173,
      "src": "raw/lighthouse/shot_14.mov",
      "src_dur": 2.85,
      "motion": "pan_right",
      "transition": "fog",
      "grade": "neutral",
      "placeholder": null,
      "override": {},
      "dur": 1.043
    },
    {
      "n": 15,
      "text": "Across town, to a little blue house by the docks.",
      "start": 19.173,
      "end": 21.257,
      "src": "raw/lighthouse/shot_15.mov",
      "src_dur": 3.783,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": null,
      "override": {},
      "dur": 2.084
    },
    {
      "n": 16,
      "text": "My sister June was six.",
      "start": 21.257,
      "end": 22.75,
      "src": "raw/lighthouse/shot_16.mov",
      "src_dur": 2.8,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": null,
      "override": {},
      "dur": 1.493
    },
    {
      "n": 17,
      "text": "She stopped talking the day we packed up her room.",
      "start": 22.75,
      "end": 24.814,
      "src": "raw/lighthouse/shot_17.mov",
      "src_dur": 3.817,
      "motion": "pan_left",
      "transition": "cut",
      "grade": "cool",
      "placeholder": null,
      "override": {},
      "dur": 2.064
    },
    {
      "n": 18,
      "text": "Not sad-quiet.",
      "start": 24.814,
      "end": 26.066,
      "src": "raw/lighthouse/shot_18.mov",
      "src_dur": 2.817,
      "motion": "push_in",
      "transition": "cut",
      "grade": "cool",
      "placeholder": null,
      "override": {},
      "dur": 1.252
    },
    {
      "n": 19,
      "text": "Just gone-quiet.",
      "start": 26.066,
      "end": 27.363,
      "src": "raw/lighthouse/shot_19.mov",
      "src_dur": 2.717,
      "motion": "push_in",
      "transition": "cut",
      "grade": "cool",
      "placeholder": null,
      "override": {},
      "dur": 1.297
    },
    {
      "n": 20,
      "text": "Mom tried pancakes.",
      "start": 27.363,
      "end": 28.567,
      "src": "raw/lighthouse/shot_20.mov",
      "src_dur": 2.8,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": null,
      "override": {},
      "dur": 1.204
    },
    {
      "n": 21,
      "text": "Dad tried knock-knock jokes.",
      "start": 28.567,
      "end": 30.032,
      "src": "raw/lighthouse/shot_21.mov",
      "src_dur": 2.833,
      "motion": "pan_right",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": null,
      "override": {},
      "dur": 1.465
    },
    {
      "n": 22,
      "text": "I gave her my bike.",
      "start": 30.032,
      "end": 31.305,
      "src": "raw/lighthouse/shot_22.mov",
      "src_dur": 2.75,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": null,
      "override": {},
      "dur": 1.273
    },
    {
      "n": 23,
      "text": "Nothing.",
      "start": 31.305,
      "end": 32.299,
      "src": "raw/lighthouse/shot_23.mov",
      "src_dur": 1.767,
      "motion": "drift",
      "transition": "cut",
      "grade": "cool",
      "placeholder": null,
      "override": {},
      "dur": 0.994
    },
    {
      "n": 24,
      "text": "The first foggy night, I couldn't sleep.",
      "start": 32.299,
      "end": 34.116,
      "src": "raw/lighthouse/shot_24.mov",
      "src_dur": 2.817,
      "motion": "push_in",
      "transition": "fog",
      "grade": "cool",
      "placeholder": null,
      "override": {},
      "dur": 1.817
    },
    {
      "n": 25,
      "text": "I looked out my window,",
      "start": 34.116,
      "end": 35.216,
      "src": "raw/lighthouse/shot_25.mov",
      "src_dur": 2.817,
      "motion": "push_in",
      "transition": "cut",
      "grade": "cool",
      "placeholder": null,
      "override": {},
      "dur": 1.1
    },
    {
      "n": 26,
      "text": "and the beam was sweeping the whole town.",
      "start": 35.216,
      "end": 36.772,
      "src": "raw/lighthouse/shot_26.mov",
      "src_dur": 2.783,
      "motion": "pan_left",
      "transition": "cut",
      "grade": "cool",
      "placeholder": null,
      "override": {},
      "dur": 1.556
    },
    {
      "n": 27,
      "text": "Then it stopped.",
      "start": 36.772,
      "end": 37.961,
      "src": "raw/lighthouse/shot_27.mov",
      "src_dur": 1.833,
      "motion": "drift",
      "transition": "cut",
      "grade": "cool",
      "placeholder": null,
      "override": {},
      "dur": 1.189
    },
    {
      "n": 28,
      "text": "Right on our house.",
      "start": 37.961,
      "end": 39.122,
      "src": "raw/lighthouse/shot_28.mov",
      "src_dur": 2.75,
      "motion": "punch",
      "transition": "sparkle",
      "grade": "cool",
      "placeholder": null,
      "override": {},
      "dur": 1.161
    },
    {
      "n": 29,
      "text": "On June's window.",
      "start": 39.122,
      "end": 40.61,
      "src": "raw/lighthouse/shot_29.mov",
      "src_dur": 2.817,
      "motion": "push_in",
      "transition": "cut",
      "grade": "cool",
      "placeholder": null,
      "override": {},
      "dur": 1.488
    },
    {
      "n": 30,
      "text": "I tiptoed into her room.",
      "start": 40.61,
      "end": 42.128,
      "src": "raw/lighthouse/shot_30.mov",
      "src_dur": 2.833,
      "motion": "pan_right",
      "transition": "cut",
      "grade": "cool",
      "placeholder": null,
      "override": {},
      "dur": 1.518
    },
    {
      "n": 31,
      "text": "She was sitting up, staring at the light.",
      "start": 42.128,
      "end": 43.82,
      "src": "raw/lighthouse/shot_31.mov",
      "src_dur": 2.783,
      "motion": "push_in",
      "transition": "cut",
      "grade": "cool",
      "placeholder": null,
      "override": {},
      "dur": 1.692
    },
    {
      "n": 32,
      "text": "\"Are you lost?\" I whispered.",
      "start": 43.82,
      "end": 45.932,
      "src": "raw/lighthouse/shot_32.mov",
      "src_dur": 2.817,
      "motion": "push_in",
      "transition": "cut",
      "grade": "cool",
      "placeholder": null,
      "override": {},
      "dur": 2.112
    },
    {
      "n": 33,
      "text": "She nodded.",
      "start": 45.932,
      "end": 46.472,
      "src": "raw/lighthouse/shot_33.mov",
      "src_dur": 1.767,
      "motion": "push_in",
      "transition": "cut",
      "grade": "cool",
      "placeholder": null,
      "override": {},
      "dur": 0.54
    },
    {
      "n": 34,
      "text": "\"Me too, a little,\" I said.",
      "start": 46.472,
      "end": 48.689,
      "src": "raw/lighthouse/shot_34.mov",
      "src_dur": 2.8,
      "motion": "push_in",
      "transition": "cut",
      "grade": "cool",
      "placeholder": null,
      "override": {},
      "dur": 2.217
    },
    {
      "n": 35,
      "text": "\"New house.",
      "start": 48.689,
      "end": 49.289,
      "src": "raw/lighthouse/shot_35.mov",
      "src_dur": 2.783,
      "motion": "push_in",
      "transition": "cut",
      "grade": "cool",
      "placeholder": null,
      "override": {},
      "dur": 0.6
    },
    {
      "n": 36,
      "text": "New street. New everything.\"",
      "start": 49.289,
      "end": 50.45,
      "src": "raw/lighthouse/shot_36.mov",
      "src_dur": 2.8,
      "motion": "push_in",
      "transition": "cut",
      "grade": "cool",
      "placeholder": null,
      "override": {},
      "dur": 1.161
    },
    {
      "n": 37,
      "text": "The light stayed all night.",
      "start": 50.45,
      "end": 51.802,
      "src": "raw/lighthouse/shot_37.mov",
      "src_dur": 2.833,
      "motion": "push_in",
      "transition": "cut",
      "grade": "cool",
      "placeholder": null,
      "override": {},
      "dur": 1.352
    },
    {
      "n": 38,
      "text": "So did I.",
      "start": 51.802,
      "end": 52.993,
      "src": "raw/lighthouse/shot_38.mov",
      "src_dur": 1.833,
      "motion": "pull_out",
      "transition": "cut",
      "grade": "warm",
      "placeholder": null,
      "override": {},
      "dur": 1.191
    },
    {
      "n": 39,
      "text": "The next morning, the lighthouse keeper,",
      "start": 52.993,
      "end": 54.333,
      "src": "raw/lighthouse/shot_39.mov",
      "src_dur": 2.817,
      "motion": "push_in",
      "transition": "fog",
      "grade": "warm",
      "placeholder": null,
      "override": {},
      "dur": 1.34
    },
    {
      "n": 40,
      "text": "old Mr. Pell, knocked on our door",
      "start": 54.333,
      "end": 55.853,
      "src": "raw/lighthouse/shot_40.mov",
      "src_dur": 2.8,
      "motion": "push_in",
      "transition": "cut",
      "grade": "warm",
      "placeholder": null,
      "override": {},
      "dur": 1.52
    },
    {
      "n": 41,
      "text": "with a jar of sea glass.",
      "start": 55.853,
      "end": 57.121,
      "src": "raw/lighthouse/shot_41.mov",
      "src_dur": 2.85,
      "motion": "punch",
      "transition": "cut",
      "grade": "warm",
      "placeholder": null,
      "override": {},
      "dur": 1.268
    },
    {
      "n": 42,
      "text": "\"The light doesn't fix lost,\" he said.",
      "start": 57.121,
      "end": 59.269,
      "src": "raw/lighthouse/shot_42.mov",
      "src_dur": 2.833,
      "motion": "push_in",
      "transition": "cut",
      "grade": "warm",
      "placeholder": null,
      "override": {},
      "dur": 2.148
    },
    {
      "n": 43,
      "text": "\"It just shows someone where to sit.\"",
      "start": 59.269,
      "end": 60.877,
      "src": "raw/lighthouse/shot_43.mov",
      "src_dur": 2.8,
      "motion": "push_in",
      "transition": "cut",
      "grade": "warm",
      "placeholder": null,
      "override": {},
      "dur": 1.608
    },
    {
      "n": 44,
      "text": "June took the jar.",
      "start": 60.877,
      "end": 62.093,
      "src": "raw/lighthouse/shot_44.mov",
      "src_dur": 1.8,
      "motion": "push_in",
      "transition": "cut",
      "grade": "warm",
      "placeholder": null,
      "override": {},
      "dur": 1.216
    },
    {
      "n": 45,
      "text": "She held a blue piece up to the sun.",
      "start": 62.093,
      "end": 63.81,
      "src": "raw/lighthouse/shot_45.mov",
      "src_dur": 2.8,
      "motion": "push_in",
      "transition": "sparkle",
      "grade": "warm",
      "placeholder": null,
      "override": {},
      "dur": 1.717
    },
    {
      "n": 46,
      "text": "And for the first time in three weeks,",
      "start": 63.81,
      "end": 65.47,
      "src": "raw/lighthouse/shot_46.mov",
      "src_dur": 2.833,
      "motion": "push_in",
      "transition": "cut",
      "grade": "warm",
      "placeholder": null,
      "override": {},
      "dur": 1.66
    },
    {
      "n": 47,
      "text": "she said one word.",
      "start": 65.47,
      "end": 66.419,
      "src": "raw/lighthouse/shot_47.mov",
      "src_dur": 1.733,
      "motion": "push_in",
      "transition": "cut",
      "grade": "warm",
      "placeholder": null,
      "override": {},
      "dur": 0.949
    },
    {
      "n": 48,
      "text": "\"Home.\"",
      "start": 66.419,
      "end": 68.584,
      "src": "raw/lighthouse/shot_48.mov",
      "src_dur": 2.8,
      "motion": "pull_out",
      "transition": "fog",
      "grade": "warm",
      "placeholder": null,
      "override": {},
      "dur": 2.165
    }
