{
  "slug": "lighthouse",
  "title": "The Lighthouse for Lost People",
  "timing": "voice",
  "voice": "output/stock/voice/lighthouse.wav",
  "duration": 74.519,
  "shots": [
    {
      "n": 1,
      "text": "In this town,",
      "start": 0.0,
      "end": 0.74,
      "src": "raw/lighthouse/shot_01.mov",
      "src_dur": 3.783,
      "motion": "push_in",
      "transition": "cut",
      "grade": "warm",
      "placeholder": null,
      "override": {},
      "dur": 0.74
    },
    {
      "n": 2,
      "text": "the lighthouse shines for anyone who's lost.",
      "start": 0.74,
      "end": 3.1,
      "src": "raw/lighthouse/shot_02.mov",
      "src_dur": 4.767,
      "motion": "push_in",
      "transition": "cut",
      "grade": "warm",
      "placeholder": null,
      "override": {},
      "dur": 2.36
    },
    {
      "n": 3,
      "text": "Not just ships.",
      "start": 3.1,
      "end": 4.16,
      "src": "raw/lighthouse/shot_03.mov",
      "src_dur": 3.733,
      "motion": "pan_right",
      "transition": "cut",
      "grade": "warm",
      "placeholder": null,
      "override": {},
      "dur": 1.06
    },
    {
      "n": 4,
      "text": "People.",
      "start": 4.16,
      "end": 4.92,
      "src": "raw/lighthouse/shot_04.mov",
      "src_dur": 5.55,
      "motion": "punch",
      "transition": "cut",
      "grade": "warm",
      "placeholder": null,
      "override": {},
      "dur": 0.76
    },
    {
      "n": 5,
      "text": "When Tommy Briggs got lost at the summer fair,",
      "start": 4.92,
      "end": 7.0,
      "src": "raw/lighthouse/shot_05.mov",
      "src_dur": 4.583,
      "motion": "pan_left",
      "transition": "cut",
      "grade": "warm",
      "placeholder": null,
      "override": {},
      "dur": 2.08
    },
    {
      "n": 6,
      "text": "the beam found him at the cotton candy stand.",
      "start": 7.0,
      "end": 9.48,
      "src": "raw/lighthouse/shot_06.mov",
      "src_dur": 3.483,
      "motion": "push_in",
      "transition": "cut",
      "grade": "warm",
      "placeholder": null,
      "override": {},
      "dur": 2.48
    },
    {
      "n": 7,
      "text": "When Mrs. Alder lost her glasses,",
      "start": 9.48,
      "end": 11.86,
      "src": "raw/lighthouse/shot_07.mov",
      "src_dur": 3.5,
      "motion": "push_in",
      "transition": "cut",
      "grade": "warm",
      "placeholder": null,
      "override": {},
      "dur": 2.38
    },
    {
      "n": 8,
      "text": "it lit up her own head.",
      "start": 11.86,
      "end": 13.04,
      "src": "raw/lighthouse/shot_08.mov",
      "src_dur": 4.6,
      "motion": "punch",
      "transition": "cut",
      "grade": "warm",
      "placeholder": null,
      "override": {},
      "dur": 1.18
    },
    {
      "n": 9,
      "text": "They were on it.",
      "start": 13.04,
      "end": 14.0,
      "src": "raw/lighthouse/shot_09.mov",
      "src_dur": 3.75,
      "motion": "push_in",
      "transition": "cut",
      "grade": "warm",
      "placeholder": null,
      "override": {
        "src": "raw/lighthouse/shot_08.mov",
        "src_in": 2.6,
        "motion": "punch"
      },
      "dur": 0.96
    },
    {
      "n": 10,
      "text": "And when my dad lost his job,",
      "start": 14.0,
      "end": 15.62,
      "src": "raw/lighthouse/shot_10.mov",
      "src_dur": 3.767,
      "motion": "push_in",
      "transition": "cut",
      "grade": "cool",
      "placeholder": null,
      "override": {},
      "dur": 1.62
    },
    {
      "n": 11,
      "text": "it shone on our porch for a whole week.",
      "start": 15.62,
      "end": 17.74,
      "src": "raw/lighthouse/shot_11.mov",
      "src_dur": 3.767,
      "motion": "push_in",
      "transition": "cut",
      "grade": "cool",
      "placeholder": null,
      "override": {},
      "dur": 2.12
    },
    {
      "n": 12,
      "text": "He pretended not to notice.",
      "start": 17.74,
      "end": 18.92,
      "src": "raw/lighthouse/shot_12.mov",
      "src_dur": 2.65,
      "motion": "push_in",
      "transition": "cut",
      "grade": "cool",
      "placeholder": null,
      "override": {},
      "dur": 1.18
    },
    {
      "n": 13,
      "text": "He noticed.",
      "start": 18.92,
      "end": 20.34,
      "src": "raw/lighthouse/shot_13.mov",
      "src_dur": 3.783,
      "motion": "punch",
      "transition": "cut",
      "grade": "cool",
      "placeholder": null,
      "override": {},
      "dur": 1.42
    },
    {
      "n": 14,
      "text": "Then, we moved.",
      "start": 20.34,
      "end": 21.9,
      "src": "raw/lighthouse/shot_14.mov",
      "src_dur": 2.85,
      "motion": "pan_right",
      "transition": "fog",
      "grade": "neutral",
      "placeholder": null,
      "override": {},
      "dur": 1.56
    },
    {
      "n": 15,
      "text": "Across town, to a little blue house by the docks.",
      "start": 21.9,
      "end": 24.56,
      "src": "raw/lighthouse/shot_15.mov",
      "src_dur": 3.783,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": null,
      "override": {},
      "dur": 2.66
    },
    {
      "n": 16,
      "text": "My sister June was six.",
      "start": 24.56,
      "end": 26.34,
      "src": "raw/lighthouse/shot_16.mov",
      "src_dur": 2.8,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": null,
      "override": {},
      "dur": 1.78
    },
    {
      "n": 17,
      "text": "She stopped talking the day we packed up her room.",
      "start": 26.34,
      "end": 28.7,
      "src": "raw/lighthouse/shot_17.mov",
      "src_dur": 3.817,
      "motion": "pan_left",
      "transition": "cut",
      "grade": "cool",
      "placeholder": null,
      "override": {},
      "dur": 2.36
    },
    {
      "n": 18,
      "text": "Not sad-quiet.",
      "start": 28.7,
      "end": 29.76,
      "src": "raw/lighthouse/shot_18.mov",
      "src_dur": 2.817,
      "motion": "push_in",
      "transition": "cut",
      "grade": "cool",
      "placeholder": null,
      "override": {},
      "dur": 1.06
    },
    {
      "n": 19,
      "text": "Just gone-quiet.",
      "start": 29.76,
      "end": 31.18,
      "src": "raw/lighthouse/shot_19.mov",
      "src_dur": 2.717,
      "motion": "push_in",
      "transition": "cut",
      "grade": "cool",
      "placeholder": null,
      "override": {},
      "dur": 1.42
    },
    {
      "n": 20,
      "text": "Mom tried pancakes.",
      "start": 31.18,
      "end": 32.8,
      "src": "raw/lighthouse/shot_20.mov",
      "src_dur": 2.8,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": null,
      "override": {},
      "dur": 1.62
    },
    {
      "n": 21,
      "text": "Dad tried knock-knock jokes.",
      "start": 32.8,
      "end": 34.52,
      "src": "raw/lighthouse/shot_21.mov",
      "src_dur": 2.833,
      "motion": "pan_right",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": null,
      "override": {},
      "dur": 1.72
    },
    {
      "n": 22,
      "text": "I gave her my bike.",
      "start": 34.52,
      "end": 35.84,
      "src": "raw/lighthouse/shot_22.mov",
      "src_dur": 2.75,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": null,
      "override": {},
      "dur": 1.32
    },
    {
      "n": 23,
      "text": "Nothing.",
      "start": 35.84,
      "end": 36.42,
      "src": "raw/lighthouse/shot_23.mov",
      "src_dur": 1.767,
      "motion": "drift",
      "transition": "cut",
      "grade": "cool",
      "placeholder": null,
      "override": {},
      "dur": 0.58
    },
    {
      "n": 24,
      "text": "The first foggy night, I couldn't sleep.",
      "start": 36.42,
      "end": 38.44,
      "src": "raw/lighthouse/shot_24.mov",
      "src_dur": 2.817,
      "motion": "push_in",
      "transition": "fog",
      "grade": "cool",
      "placeholder": null,
      "override": {},
      "dur": 2.02
    },
    {
      "n": 25,
      "text": "I looked out my window,",
      "start": 38.44,
      "end": 39.56,
      "src": "raw/lighthouse/shot_25.mov",
      "src_dur": 2.817,
      "motion": "push_in",
      "transition": "cut",
      "grade": "cool",
      "placeholder": null,
      "override": {},
      "dur": 1.12
    },
    {
      "n": 26,
      "text": "and the beam was sweeping the whole town.",
      "start": 39.56,
      "end": 41.34,
      "src": "raw/lighthouse/shot_26.mov",
      "src_dur": 2.783,
      "motion": "pan_left",
      "transition": "cut",
      "grade": "cool",
      "placeholder": null,
      "override": {},
      "dur": 1.78
    },
    {
      "n": 27,
      "text": "Then it stopped.",
      "start": 41.34,
      "end": 42.38,
      "src": "raw/lighthouse/shot_27.mov",
      "src_dur": 1.833,
      "motion": "drift",
      "transition": "cut",
      "grade": "cool",
      "placeholder": null,
      "override": {},
      "dur": 1.04
    },
    {
      "n": 28,
      "text": "Right on our house.",
      "start": 42.38,
      "end": 43.42,
      "src": "raw/lighthouse/shot_28.mov",
      "src_dur": 2.75,
      "motion": "punch",
      "transition": "sparkle",
      "grade": "cool",
      "placeholder": null,
      "override": {},
      "dur": 1.04
    },
    {
      "n": 29,
      "text": "On June's window.",
      "start": 43.42,
      "end": 44.68,
      "src": "raw/lighthouse/shot_29.mov",
      "src_dur": 2.817,
      "motion": "push_in",
      "transition": "cut",
      "grade": "cool",
      "placeholder": null,
      "override": {},
      "dur": 1.26
    },
    {
      "n": 30,
      "text": "I tiptoed into her room.",
      "start": 44.68,
      "end": 46.04,
      "src": "raw/lighthouse/shot_30.mov",
      "src_dur": 2.833,
      "motion": "pan_right",
      "transition": "cut",
      "grade": "cool",
      "placeholder": null,
      "override": {},
      "dur": 1.36
    },
    {
      "n": 31,
      "text": "She was sitting up, staring at the light.",
      "start": 46.04,
      "end": 47.58,
      "src": "raw/lighthouse/shot_31.mov",
      "src_dur": 2.783,
      "motion": "push_in",
      "transition": "cut",
      "grade": "cool",
      "placeholder": null,
      "override": {},
      "dur": 1.54
    },
    {
      "n": 32,
      "text": "\"Are you lost?\" I whispered.",
      "start": 47.58,
      "end": 50.2,
      "src": "raw/lighthouse/shot_32.mov",
      "src_dur": 2.817,
      "motion": "push_in",
      "transition": "cut",
      "grade": "cool",
      "placeholder": null,
      "override": {},
      "dur": 2.62
    },
    {
      "n": 33,
      "text": "She nodded.",
      "start": 50.2,
      "end": 50.9,
      "src": "raw/lighthouse/shot_33.mov",
      "src_dur": 1.767,
      "motion": "push_in",
      "transition": "cut",
      "grade": "cool",
      "placeholder": null,
      "override": {},
      "dur": 0.7
    },
    {
      "n": 34,
      "text": "\"Me too, a little,\" I said.",
      "start": 50.9,
      "end": 52.5,
      "src": "raw/lighthouse/shot_34.mov",
      "src_dur": 2.8,
      "motion": "push_in",
      "transition": "cut",
      "grade": "cool",
      "placeholder": null,
      "override": {},
      "dur": 1.6
    },
    {
      "n": 35,
      "text": "\"New house.",
      "start": 52.5,
      "end": 53.0,
      "src": "raw/lighthouse/shot_35.mov",
      "src_dur": 2.783,
      "motion": "push_in",
      "transition": "cut",
      "grade": "cool",
      "placeholder": null,
      "override": {},
      "dur": 0.5
    },
    {
      "n": 36,
      "text": "New street. New everything.\"",
      "start": 53.0,
      "end": 54.62,
      "src": "raw/lighthouse/shot_36.mov",
      "src_dur": 2.8,
      "motion": "push_in",
      "transition": "cut",
      "grade": "cool",
      "placeholder": null,
      "override": {},
      "dur": 1.62
    },
    {
      "n": 37,
      "text": "The light stayed all night.",
      "start": 54.62,
      "end": 55.78,
      "src": "raw/lighthouse/shot_37.mov",
      "src_dur": 2.833,
      "motion": "push_in",
      "transition": "cut",
      "grade": "cool",
      "placeholder": null,
      "override": {},
      "dur": 1.16
    },
    {
      "n": 38,
      "text": "So did I.",
      "start": 55.78,
      "end": 56.78,
      "src": "raw/lighthouse/shot_38.mov",
      "src_dur": 1.833,
      "motion": "pull_out",
      "transition": "cut",
      "grade": "warm",
      "placeholder": null,
      "override": {},
      "dur": 1.0
    },
    {
      "n": 39,
      "text": "The next morning, the lighthouse keeper,",
      "start": 56.78,
      "end": 58.52,
      "src": "raw/lighthouse/shot_39.mov",
      "src_dur": 2.817,
      "motion": "push_in",
      "transition": "fog",
      "grade": "warm",
      "placeholder": null,
      "override": {},
      "dur": 1.74
    },
    {
      "n": 40,
      "text": "old Mr. Pell, knocked on our door",
      "start": 58.52,
      "end": 60.2,
      "src": "raw/lighthouse/shot_40.mov",
      "src_dur": 2.8,
      "motion": "push_in",
      "transition": "cut",
      "grade": "warm",
      "placeholder": null,
      "override": {},
      "dur": 1.68
    },
    {
      "n": 41,
      "text": "with a jar of sea glass.",
      "start": 60.2,
      "end": 62.08,
      "src": "raw/lighthouse/shot_41.mov",
      "src_dur": 2.85,
      "motion": "punch",
      "transition": "cut",
      "grade": "warm",
      "placeholder": null,
      "override": {},
      "dur": 1.88
    },
    {
      "n": 42,
      "text": "\"The light doesn't fix lost,\" he said.",
      "start": 62.08,
      "end": 64.26,
      "src": "raw/lighthouse/shot_42.mov",
      "src_dur": 2.833,
      "motion": "push_in",
      "transition": "cut",
      "grade": "warm",
      "placeholder": null,
      "override": {},
      "dur": 2.18
    },
    {
      "n": 43,
      "text": "\"It just shows someone where to sit.\"",
      "start": 64.26,
      "end": 66.4,
      "src": "raw/lighthouse/shot_43.mov",
      "src_dur": 2.8,
      "motion": "push_in",
      "transition": "cut",
      "grade": "warm",
      "placeholder": null,
      "override": {},
      "dur": 2.14
    },
    {
      "n": 44,
      "text": "June took the jar.",
      "start": 66.4,
      "end": 67.62,
      "src": "raw/lighthouse/shot_44.mov",
      "src_dur": 1.8,
      "motion": "push_in",
      "transition": "cut",
      "grade": "warm",
      "placeholder": null,
      "override": {},
      "dur": 1.22
    },
    {
      "n": 45,
      "text": "She held a blue piece up to the sun.",
      "start": 67.62,
      "end": 69.54,
      "src": "raw/lighthouse/shot_45.mov",
      "src_dur": 2.8,
      "motion": "push_in",
      "transition": "sparkle",
      "grade": "warm",
      "placeholder": null,
      "override": {},
      "dur": 1.92
    },
    {
      "n": 46,
      "text": "And for the first time in three weeks,",
      "start": 69.54,
      "end": 71.18,
      "src": "raw/lighthouse/shot_46.mov",
      "src_dur": 2.833,
      "motion": "push_in",
      "transition": "cut",
      "grade": "warm",
      "placeholder": null,
      "override": {},
      "dur": 1.64
    },
    {
      "n": 47,
      "text": "she said one word.",
      "start": 71.18,
      "end": 72.66,
      "src": "raw/lighthouse/shot_47.mov",
      "src_dur": 1.733,
      "motion": "push_in",
      "transition": "cut",
      "grade": "warm",
      "placeholder": null,
      "override": {},
      "dur": 1.48
    },
    {
      "n": 48,
      "text": "\"Home.\"",
      "start": 72.66,
      "end": 74.519,
      "src": "raw/lighthouse/shot_48.mov",
      "src_dur": 2.8,
      "motion": "pull_out",
      "transition": "fog",
      "grade": "warm",
      "placeholder": null,
      "override": {},
      "dur": 1.859
    }
