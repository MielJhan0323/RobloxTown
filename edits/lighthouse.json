      "placeholder": null,
      "override": {},
      "dur": 1.02
    },
    {
      "n": 2,
      "text": "the lighthouse shines for anyone who's lost.",
      "start": 1.02,
      "end": 3.3,
      "src": "raw/lighthouse/shot_02.mov",
      "src_dur": 4.767,
      "motion": "push_in",
      "transition": "cut",
      "grade": "warm",
      "placeholder": null,
      "override": {},
      "dur": 2.28
    },
    {
      "n": 3,
      "text": "Not just ships.",
