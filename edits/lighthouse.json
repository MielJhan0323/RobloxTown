      "motion": "punch",
      "transition": "cut",
      "grade": "warm",
      "placeholder": null,
      "override": {},
      "dur": 0.5
    },
    {
      "n": 5,
      "text": "When Tommy Briggs got lost at the summer fair,",
      "start": 4.66,
      "end": 6.96,
      "src": "raw/lighthouse/shot_05.mov",
      "src_dur": 4.583,
      "motion": "pan_left",
      "transition": "cut",
      "grade": "warm",
      "placeholder": null,
      "override": {},
      "dur": 2.3
    },
    {
      "n": 6,
      "text": "the beam found him at the cotton candy stand.",
      "start": 6.96,
      "end": 9.1,
      "src": "output/anim/lighthouse/shot_06.mp4",
      "src_dur": 3.5,
      "motion": "push_in",
      "transition": "cut",
      "grade": "warm",
      "placeholder": null,
      "override": {},
      "dur": 2.14
    },
    {
      "n": 7,
      "text": "When Mrs. Alder lost her glasses,",
      "start": 9.1,
      "end": 11.34,
      "src": "output/anim/lighthouse/shot_07.mp4",
      "src_dur": 3.5,
      "motion": "push_in",
      "transition": "cut",
      "grade": "warm",
      "placeholder": null,
      "override": {},
      "dur": 2.24
    },
    {
      "n": 8,
      "text": "it lit up her own head.",
      "start": 11.34,
      "end": 12.46,
      "src": "output/anim/lighthouse/shot_08.mp4",
      "src_dur": 2.5,
      "motion": "punch",
      "transition": "cut",
      "grade": "warm",
      "placeholder": null,
      "override": {},
      "dur": 1.12
    },
    {
      "n": 9,
      "text": "They were on it.",
      "start": 12.46,
      "end": 13.24,
      "src": "output/anim/lighthouse/shot_09.mp4",
      "src_dur": 2.0,
      "motion": "push_in",
      "transition": "cut",
      "grade": "warm",
      "placeholder": null,
      "override": {},
      "dur": 0.78
    },
    {
      "n": 10,
      "text": "And when my dad lost his job,",
      "start": 13.24,
      "end": 14.86,
      "src": "output/anim/lighthouse/shot_10.mp4",
      "src_dur": 2.5,
      "motion": "push_in",
      "transition": "cut",
      "grade": "cool",
      "placeholder": null,
      "override": {},
      "dur": 1.62
    },
    {
      "n": 11,
      "text": "it shone on our porch for a whole week.",
      "start": 14.86,
      "end": 16.8,
      "src": "output/anim/lighthouse/shot_11.mp4",
      "src_dur": 3.5,
      "motion": "push_in",
      "transition": "cut",
      "grade": "cool",
      "placeholder": null,
      "override": {},
      "dur": 1.94
    },
    {
      "n": 12,
      "text": "He pretended not to notice.",
      "start": 16.8,
      "end": 18.32,
      "src": "output/anim/lighthouse/shot_12.mp4",
      "src_dur": 3.0,
      "motion": "push_in",
      "transition": "cut",
      "grade": "cool",
      "placeholder": null,
      "override": {},
      "dur": 1.52
    },
    {
      "n": 13,
      "text": "He noticed.",
      "start": 18.32,
      "end": 19.18,
      "src": "output/anim/lighthouse/shot_13.mp4",
      "src_dur": 2.0,
      "motion": "punch",
      "transition": "cut",
      "grade": "cool",
      "placeholder": null,
      "override": {},
      "dur": 0.86
    },
    {
      "n": 14,
      "text": "Then, we moved.",
      "start": 19.18,
      "end": 20.38,
      "src": "output/anim/lighthouse/shot_14.mp4",
      "src_dur": 2.5,
      "motion": "pan_right",
      "transition": "fog",
      "grade": "neutral",
      "placeholder": null,
      "override": {},
      "dur": 1.2
    },
    {
      "n": 15,
      "text": "Across town, to a little blue house by the docks.",
      "start": 20.38,
      "end": 23.06,
      "src": "output/anim/lighthouse/shot_15.mp4",
      "src_dur": 3.5,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": null,
      "override": {},
      "dur": 2.68
    },
    {
      "n": 16,
      "text": "My sister June was six.",
      "start": 23.06,
      "end": 24.48,
      "src": "output/anim/lighthouse/shot_16.mp4",
      "src_dur": 3.5,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": null,
      "override": {},
      "dur": 1.42
    },
    {
      "n": 17,
      "text": "She stopped talking the day we packed up her room.",
      "start": 24.48,
      "end": 26.96,
      "src": "output/anim/lighthouse/shot_17.mp4",
      "src_dur": 4.0,
      "motion": "pan_left",
      "transition": "cut",
      "grade": "cool",
      "placeholder": null,
      "override": {},
      "dur": 2.48
    },
    {
      "n": 18,
      "text": "Not sad-quiet.",
      "start": 26.96,
      "end": 28.04,
      "src": "output/anim/lighthouse/shot_18.mp4",
      "src_dur": 2.5,
      "motion": "push_in",
      "transition": "cut",
      "grade": "cool",
      "placeholder": null,
      "override": {},
      "dur": 1.08
    },
    {
      "n": 19,
      "text": "Just gone-quiet.",
      "start": 28.04,
      "end": 29.12,
      "src": "output/anim/lighthouse/shot_19.mp4",
      "src_dur": 2.5,
      "motion": "push_in",
      "transition": "cut",
      "grade": "cool",
      "placeholder": null,
      "override": {},
      "dur": 1.08
    },
    {
      "n": 20,
      "text": "Mom tried pancakes.",
      "start": 29.12,
      "end": 29.98,
      "src": "output/anim/lighthouse/shot_20.mp4",
      "src_dur": 3.0,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": null,
      "override": {},
      "dur": 0.86
    },
    {
      "n": 21,
      "text": "Dad tried knock-knock jokes.",
      "start": 29.98,
      "end": 32.12,
      "src": "output/anim/lighthouse/shot_21.mp4",
      "src_dur": 3.0,
      "motion": "pan_right",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": null,
      "override": {},
      "dur": 2.14
    },
    {
      "n": 22,
      "text": "I gave her my bike.",
      "start": 32.12,
      "end": 33.14,
      "src": "output/anim/lighthouse/shot_22.mp4",
      "src_dur": 2.5,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": null,
      "override": {},
      "dur": 1.02
    },
    {
      "n": 23,
      "text": "Nothing.",
      "start": 33.14,
      "end": 33.7,
      "src": "output/anim/lighthouse/shot_23.mp4",
      "src_dur": 1.5,
      "motion": "drift",
      "transition": "cut",
      "grade": "cool",
      "placeholder": null,
      "override": {},
      "dur": 0.56
    },
    {
      "n": 24,
      "text": "The first foggy night, I couldn't sleep.",
      "start": 33.7,
      "end": 35.76,
      "src": "output/anim/lighthouse/shot_24.mp4",
      "src_dur": 3.5,
      "motion": "push_in",
      "transition": "fog",
      "grade": "cool",
      "placeholder": null,
      "override": {},
      "dur": 2.06
    },
    {
      "n": 25,
      "text": "I looked out my window,",
      "start": 35.76,
      "end": 36.78,
      "src": "output/anim/lighthouse/shot_25.mp4",
      "src_dur": 2.0,
      "motion": "push_in",
      "transition": "cut",
      "grade": "cool",
      "placeholder": null,
      "override": {},
      "dur": 1.02
    },
    {
      "n": 26,
      "text": "and the beam was sweeping the whole town.",
      "start": 36.78,
      "end": 38.68,
      "src": "output/anim/lighthouse/shot_26.mp4",
      "src_dur": 3.0,
      "motion": "pan_left",
      "transition": "cut",
      "grade": "cool",
      "placeholder": null,
      "override": {},
      "dur": 1.9
    },
    {
      "n": 27,
      "text": "Then it stopped.",
      "start": 38.68,
      "end": 39.64,
      "src": "output/anim/lighthouse/shot_27.mp4",
      "src_dur": 2.0,
      "motion": "drift",
      "transition": "cut",
      "grade": "cool",
      "placeholder": null,
      "override": {},
      "dur": 0.96
    },
    {
      "n": 28,
      "text": "Right on our house.",
      "start": 39.64,
      "end": 40.64,
      "src": "output/anim/lighthouse/shot_28.mp4",
      "src_dur": 2.0,
      "motion": "punch",
      "transition": "sparkle",
      "grade": "cool",
      "placeholder": null,
      "override": {},
      "dur": 1.0
    },
    {
      "n": 29,
      "text": "On June's window.",
      "start": 40.64,
      "end": 41.68,
      "src": "output/anim/lighthouse/shot_29.mp4",
      "src_dur": 2.5,
      "motion": "push_in",
      "transition": "cut",
      "grade": "cool",
      "placeholder": null,
      "override": {},
      "dur": 1.04
    },
    {
      "n": 30,
      "text": "I tiptoed into her room.",
      "start": 41.68,
      "end": 43.1,
      "src": "output/anim/lighthouse/shot_30.mp4",
      "src_dur": 3.0,
      "motion": "pan_right",
      "transition": "cut",
      "grade": "cool",
      "placeholder": null,
      "override": {},
      "dur": 1.42
    },
    {
      "n": 31,
      "text": "She was sitting up, staring at the light.",
      "start": 43.1,
      "end": 44.72,
      "src": "output/anim/lighthouse/shot_31.mp4",
      "src_dur": 2.5,
      "motion": "push_in",
      "transition": "cut",
      "grade": "cool",
      "placeholder": null,
      "override": {},
      "dur": 1.62
    },
    {
      "n": 32,
      "text": "\"Are you lost?\" I whispered.",
      "start": 44.72,
      "end": 46.58,
      "src": "output/anim/lighthouse/shot_32.mp4",
      "src_dur": 4.0,
      "motion": "push_in",
      "transition": "cut",
      "grade": "cool",
      "placeholder": null,
      "override": {},
      "dur": 1.86
    },
    {
      "n": 33,
      "text": "She nodded.",
      "start": 46.58,
      "end": 47.3,
      "src": "output/anim/lighthouse/shot_33.mp4",
      "src_dur": 2.0,
      "motion": "push_in",
      "transition": "cut",
      "grade": "cool",
      "placeholder": null,
      "override": {},
      "dur": 0.72
    },
    {
      "n": 34,
      "text": "\"Me too, a little,\" I said.",
      "start": 47.3,
      "end": 48.92,
      "src": "output/anim/lighthouse/shot_34.mp4",
      "src_dur": 3.0,
      "motion": "push_in",
      "transition": "cut",
      "grade": "cool",
      "placeholder": null,
      "override": {},
      "dur": 1.62
    },
    {
      "n": 35,
      "text": "\"New house.",
      "start": 48.92,
      "end": 49.58,
      "src": "output/anim/lighthouse/shot_35.mp4",
      "src_dur": 2.0,
      "motion": "push_in",
      "transition": "cut",
      "grade": "cool",
      "placeholder": null,
      "override": {},
      "dur": 0.66
    },
    {
      "n": 36,
      "text": "New street. New everything.\"",
      "start": 49.58,
      "end": 51.34,
      "src": "output/anim/lighthouse/shot_36.mp4",
      "src_dur": 3.5,
      "motion": "push_in",
      "transition": "cut",
      "grade": "cool",
      "placeholder": null,
      "override": {},
      "dur": 1.76
    },
    {
      "n": 37,
      "text": "The light stayed all night.",
      "start": 51.34,
      "end": 52.74,
      "src": "output/anim/lighthouse/shot_37.mp4",
      "src_dur": 2.5,
      "motion": "push_in",
      "transition": "cut",
      "grade": "cool",
      "placeholder": null,
      "override": {},
      "dur": 1.4
    },
    {
      "n": 38,
      "text": "So did I.",
      "start": 52.74,
      "end": 53.6,
      "src": "output/anim/lighthouse/shot_38.mp4",
      "src_dur": 2.0,
      "motion": "pull_out",
      "transition": "cut",
      "grade": "warm",
      "placeholder": null,
      "override": {},
      "dur": 0.86
    },
    {
      "n": 39,
      "text": "The next morning, the lighthouse keeper,",
      "start": 53.6,
      "end": 55.28,
      "src": "output/anim/lighthouse/shot_39.mp4",
      "src_dur": 2.5,
      "motion": "push_in",
      "transition": "fog",
      "grade": "warm",
      "placeholder": null,
      "override": {},
      "dur": 1.68
    },
    {
      "n": 40,
      "text": "old Mr. Pell, knocked on our door",
      "start": 55.28,
      "end": 57.14,
      "src": "output/anim/lighthouse/shot_40.mp4",
      "src_dur": 3.5,
      "motion": "push_in",
      "transition": "cut",
      "grade": "warm",
      "placeholder": null,
      "override": {},
      "dur": 1.86
    },
    {
      "n": 41,
      "text": "with a jar of sea glass.",
      "start": 57.14,
      "end": 58.56,
      "src": "output/anim/lighthouse/shot_41.mp4",
      "src_dur": 3.0,
      "motion": "punch",
      "transition": "cut",
      "grade": "warm",
      "placeholder": null,
      "override": {},
      "dur": 1.42
    },
    {
      "n": 42,
      "text": "\"The light doesn't fix lost,\" he said.",
      "start": 58.56,
      "end": 60.36,
      "src": "output/anim/lighthouse/shot_42.mp4",
      "src_dur": 3.0,
      "motion": "push_in",
      "transition": "cut",
      "grade": "warm",
      "placeholder": null,
      "override": {},
      "dur": 1.8
    },
    {
      "n": 43,
      "text": "\"It just shows someone where to sit.\"",
      "start": 60.36,
      "end": 62.24,
      "src": "output/anim/lighthouse/shot_43.mp4",
      "src_dur": 3.5,
      "motion": "push_in",
      "transition": "cut",
      "grade": "warm",
      "placeholder": null,
      "override": {},
      "dur": 1.88
    },
    {
      "n": 44,
      "text": "June took the jar.",
      "start": 62.24,
      "end": 63.46,
      "src": "output/anim/lighthouse/shot_44.mp4",
      "src_dur": 2.5,
      "motion": "push_in",
      "transition": "cut",
      "grade": "warm",
      "placeholder": null,
      "override": {},
      "dur": 1.22
    },
    {
      "n": 45,
      "text": "She held a blue piece up to the sun.",
      "start": 63.46,
      "end": 65.22,
      "src": "output/anim/lighthouse/shot_45.mp4",
      "src_dur": 3.0,
      "motion": "push_in",
      "transition": "sparkle",
      "grade": "warm",
      "placeholder": null,
      "override": {},
      "dur": 1.76
    },
    {
      "n": 46,
      "text": "And for the first time in three weeks,",
      "start": 65.22,
      "end": 67.02,
      "src": "output/anim/lighthouse/shot_46.mp4",
      "src_dur": 2.5,
      "motion": "push_in",
      "transition": "cut",
      "grade": "warm",
      "placeholder": null,
      "override": {},
      "dur": 1.8
    },
    {
      "n": 47,
      "text": "she said one word.",
      "start": 67.02,
      "end": 67.88,
      "src": "output/anim/lighthouse/shot_47.mp4",
      "src_dur": 2.5,
      "motion": "push_in",
      "transition": "cut",
      "grade": "warm",
      "placeholder": null,
      "override": {},
      "dur": 0.86
    },
    {
      "n": 48,
      "text": "\"Home.\"",
      "start": 67.88,
      "end": 69.793,
      "src": "output/anim/lighthouse/shot_48.mp4",
