  "duration": 105.497,
  "shots": [
    {
      "n": 1,
      "text": "In this town,",
      "start": 0.0,
      "end": 1.08,
      "src": "raw/lighthouse/shot_01.mov",
      "src_dur": 3.783,
      "motion": "push_in",
      "transition": "cut",
      "grade": "warm",
      "placeholder": null,
      "override": {},
      "dur": 1.08
    },
    {
      "n": 2,
      "text": "the lighthouse shines for anyone who's lost.",
      "start": 1.08,
      "end": 4.0,
      "src": "raw/lighthouse/shot_02.mov",
      "src_dur": 4.767,
      "motion": "push_in",
      "transition": "cut",
      "grade": "warm",
      "placeholder": null,
      "override": {},
      "dur": 2.92
    },
    {
      "n": 3,
      "text": "Not just ships.",
      "start": 4.0,
      "end": 5.8,
      "src": "raw/lighthouse/shot_03.mov",
      "src_dur": 3.733,
      "motion": "pan_right",
      "transition": "cut",
      "grade": "warm",
      "placeholder": null,
      "override": {},
      "dur": 1.8
    },
    {
      "n": 4,
      "text": "People.",
      "start": 5.8,
      "end": 7.76,
      "src": "raw/lighthouse/shot_04.mov",
      "src_dur": 5.55,
      "motion": "punch",
      "transition": "cut",
      "grade": "warm",
      "placeholder": null,
      "override": {},
      "dur": 1.96
    },
    {
      "n": 5,
      "text": "When Tommy Briggs got lost at the summer fair,",
      "start": 7.76,
      "end": 10.34,
      "src": "raw/lighthouse/shot_05.mov",
      "src_dur": 4.583,
      "motion": "pan_left",
      "transition": "cut",
      "grade": "warm",
      "placeholder": null,
      "override": {},
      "dur": 2.58
    },
    {
      "n": 6,
      "text": "the beam found him at the cotton candy stand.",
      "start": 10.34,
      "end": 12.46,
      "src": "raw/lighthouse/shot_06.mov",
      "src_dur": 3.483,
      "motion": "push_in",
      "transition": "cut",
      "grade": "warm",
      "placeholder": null,
      "override": {},
      "dur": 2.12
    },
    {
      "n": 7,
      "text": "When Mrs. Alder lost her glasses,",
      "start": 12.46,
      "end": 15.26,
      "src": "raw/lighthouse/shot_07.mov",
      "src_dur": 3.5,
      "motion": "push_in",
      "transition": "cut",
      "grade": "warm",
      "placeholder": null,
      "override": {},
      "dur": 2.8
    },
    {
      "n": 8,
      "text": "it lit up her own head.",
      "start": 15.26,
      "end": 16.9,
      "src": "raw/lighthouse/shot_08.mov",
      "src_dur": 4.6,
      "motion": "punch",
      "transition": "cut",
      "grade": "warm",
      "placeholder": null,
      "override": {},
      "dur": 1.64
    },
    {
      "n": 9,
      "text": "They were on it.",
      "start": 16.9,
      "end": 18.34,
      "src": "raw/lighthouse/shot_09.mov",
      "src_dur": 3.75,
      "motion": "push_in",
      "transition": "cut",
      "grade": "warm",
      "placeholder": null,
      "override": {
        "src": "raw/lighthouse/shot_08.mov",
        "src_in": 2.6,
        "motion": "punch"
      },
      "dur": 1.44
    },
    {
      "n": 10,
      "text": "And when my dad lost his job,",
      "start": 18.34,
      "end": 20.28,
      "src": "raw/lighthouse/shot_10.mov",
      "src_dur": 3.767,
      "motion": "push_in",
      "transition": "cut",
      "grade": "cool",
      "placeholder": null,
      "override": {},
      "dur": 1.94
    },
    {
      "n": 11,
      "text": "it shone on our porch for a whole week.",
      "start": 20.28,
      "end": 22.7,
      "src": "raw/lighthouse/shot_11.mov",
      "src_dur": 3.767,
      "motion": "push_in",
      "transition": "cut",
      "grade": "cool",
      "placeholder": null,
      "override": {},
      "dur": 2.42
    },
    {
      "n": 12,
      "text": "He pretended not to notice.",
      "start": 22.7,
      "end": 25.18,
      "src": "raw/lighthouse/shot_12.mov",
      "src_dur": 2.65,
      "motion": "push_in",
      "transition": "cut",
      "grade": "cool",
      "placeholder": null,
      "override": {},
      "dur": 2.48
    },
    {
      "n": 13,
      "text": "He noticed.",
      "start": 25.18,
      "end": 27.0,
      "src": "raw/lighthouse/shot_13.mov",
      "src_dur": 3.783,
      "motion": "punch",
      "transition": "cut",
      "grade": "cool",
      "placeholder": null,
      "override": {},
      "dur": 1.82
    },
    {
      "n": 14,
      "text": "Then, we moved.",
      "start": 27.0,
      "end": 28.86,
      "src": "raw/lighthouse/shot_14.mov",
      "src_dur": 2.85,
      "motion": "pan_right",
      "transition": "fog",
      "grade": "neutral",
      "placeholder": null,
      "override": {},
      "dur": 1.86
    },
    {
      "n": 15,
      "text": "Across town, to a little blue house by the docks.",
      "start": 28.86,
      "end": 32.16,
      "src": "raw/lighthouse/shot_15.mov",
      "src_dur": 3.783,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": null,
      "override": {},
      "dur": 3.3
    },
    {
      "n": 16,
      "text": "My sister June was six.",
      "start": 32.16,
      "end": 34.3,
      "src": "raw/lighthouse/shot_16.mov",
      "src_dur": 2.8,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": null,
      "override": {},
      "dur": 2.14
    },
    {
      "n": 17,
      "text": "She stopped talking the day we packed up her room.",
      "start": 34.3,
      "end": 37.36,
      "src": "raw/lighthouse/shot_17.mov",
      "src_dur": 3.817,
      "motion": "pan_left",
      "transition": "cut",
      "grade": "cool",
      "placeholder": null,
      "override": {},
      "dur": 3.06
    },
    {
      "n": 18,
      "text": "Not sad-quiet.",
      "start": 37.36,
      "end": 39.36,
      "src": "raw/lighthouse/shot_18.mov",
      "src_dur": 2.817,
      "motion": "push_in",
      "transition": "cut",
      "grade": "cool",
      "placeholder": null,
      "override": {},
      "dur": 2.0
    },
    {
      "n": 19,
      "text": "Just gone-quiet.",
      "start": 39.36,
      "end": 41.38,
      "src": "raw/lighthouse/shot_19.mov",
      "src_dur": 2.717,
      "motion": "push_in",
      "transition": "cut",
      "grade": "cool",
      "placeholder": null,
      "override": {},
      "dur": 2.02
    },
    {
      "n": 20,
      "text": "Mom tried pancakes.",
      "start": 41.38,
      "end": 43.88,
      "src": "raw/lighthouse/shot_20.mov",
      "src_dur": 2.8,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": null,
      "override": {},
      "dur": 2.5
    },
    {
      "n": 21,
      "text": "Dad tried knock-knock jokes.",
      "start": 43.88,
      "end": 46.08,
      "src": "raw/lighthouse/shot_21.mov",
      "src_dur": 2.833,
      "motion": "pan_right",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": null,
      "override": {},
      "dur": 2.2
    },
    {
      "n": 22,
      "text": "I gave her my bike.",
      "start": 46.08,
      "end": 48.28,
      "src": "raw/lighthouse/shot_22.mov",
      "src_dur": 2.75,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": null,
      "override": {},
      "dur": 2.2
    },
    {
      "n": 23,
      "text": "Nothing.",
      "start": 48.28,
      "end": 49.88,
      "src": "raw/lighthouse/shot_23.mov",
      "src_dur": 1.767,
      "motion": "drift",
      "transition": "cut",
      "grade": "cool",
      "placeholder": null,
      "override": {},
      "dur": 1.6
    },
    {
      "n": 24,
      "text": "The first foggy night, I couldn't sleep.",
      "start": 49.88,
      "end": 52.4,
      "src": "raw/lighthouse/shot_24.mov",
      "src_dur": 2.817,
      "motion": "push_in",
      "transition": "fog",
      "grade": "cool",
      "placeholder": null,
      "override": {},
      "dur": 2.52
    },
    {
      "n": 25,
      "text": "I looked out my window,",
      "start": 52.4,
      "end": 53.7,
      "src": "raw/lighthouse/shot_25.mov",
      "src_dur": 2.817,
      "motion": "push_in",
      "transition": "cut",
      "grade": "cool",
      "placeholder": null,
      "override": {},
      "dur": 1.3
    },
    {
      "n": 26,
      "text": "and the beam was sweeping the whole town.",
      "start": 53.7,
      "end": 56.32,
      "src": "raw/lighthouse/shot_26.mov",
      "src_dur": 2.783,
      "motion": "pan_left",
      "transition": "cut",
      "grade": "cool",
      "placeholder": null,
      "override": {},
      "dur": 2.62
    },
    {
      "n": 27,
      "text": "Then it stopped.",
      "start": 56.32,
      "end": 57.98,
      "src": "raw/lighthouse/shot_27.mov",
      "src_dur": 1.833,
      "motion": "drift",
      "transition": "cut",
      "grade": "cool",
      "placeholder": null,
      "override": {},
      "dur": 1.66
    },
    {
      "n": 28,
      "text": "Right on our house.",
      "start": 57.98,
      "end": 59.98,
      "src": "raw/lighthouse/shot_28.mov",
      "src_dur": 2.75,
      "motion": "punch",
      "transition": "sparkle",
      "grade": "cool",
      "placeholder": null,
      "override": {},
      "dur": 2.0
    },
    {
      "n": 29,
      "text": "On June's window.",
      "start": 59.98,
      "end": 62.02,
      "src": "raw/lighthouse/shot_29.mov",
      "src_dur": 2.817,
      "motion": "push_in",
      "transition": "cut",
      "grade": "cool",
      "placeholder": null,
      "override": {},
      "dur": 2.04
    },
    {
      "n": 30,
      "text": "I tiptoed into her room.",
      "start": 62.02,
      "end": 64.5,
      "src": "raw/lighthouse/shot_30.mov",
      "src_dur": 2.833,
      "motion": "pan_right",
      "transition": "cut",
      "grade": "cool",
      "placeholder": null,
      "override": {},
      "dur": 2.48
    },
    {
      "n": 31,
      "text": "She was sitting up, staring at the light.",
      "start": 64.5,
      "end": 67.14,
      "src": "raw/lighthouse/shot_31.mov",
      "src_dur": 2.783,
      "motion": "push_in",
      "transition": "cut",
      "grade": "cool",
      "placeholder": null,
      "override": {},
      "dur": 2.64
    },
    {
      "n": 32,
      "text": "\"Are you lost?\" I whispered.",
      "start": 67.14,
      "end": 70.82,
      "src": "raw/lighthouse/shot_32.mov",
      "src_dur": 2.817,
      "motion": "push_in",
      "transition": "cut",
      "grade": "cool",
      "placeholder": null,
      "override": {},
      "dur": 3.68
    },
    {
      "n": 33,
      "text": "She nodded.",
      "start": 70.82,
      "end": 72.24,
      "src": "raw/lighthouse/shot_33.mov",
      "src_dur": 1.767,
      "motion": "push_in",
      "transition": "cut",
      "grade": "cool",
      "placeholder": null,
      "override": {},
      "dur": 1.42
    },
    {
      "n": 34,
      "text": "\"Me too, a little,\" I said.",
      "start": 72.24,
      "end": 74.58,
      "src": "raw/lighthouse/shot_34.mov",
      "src_dur": 2.8,
      "motion": "push_in",
      "transition": "cut",
      "grade": "cool",
      "placeholder": null,
      "override": {},
      "dur": 2.34
    },
    {
      "n": 35,
      "text": "\"New house.",
      "start": 74.58,
      "end": 76.3,
      "src": "raw/lighthouse/shot_35.mov",
      "src_dur": 2.783,
      "motion": "push_in",
      "transition": "cut",
      "grade": "cool",
      "placeholder": null,
      "override": {},
      "dur": 1.72
    },
    {
      "n": 36,
      "text": "New street. New everything.\"",
      "start": 76.3,
      "end": 79.6,
      "src": "raw/lighthouse/shot_36.mov",
      "src_dur": 2.8,
      "motion": "push_in",
      "transition": "cut",
      "grade": "cool",
      "placeholder": null,
      "override": {},
      "dur": 3.3
    },
    {
      "n": 37,
      "text": "The light stayed all night.",
      "start": 79.6,
      "end": 82.0,
      "src": "raw/lighthouse/shot_37.mov",
      "src_dur": 2.833,
      "motion": "push_in",
      "transition": "cut",
      "grade": "cool",
      "placeholder": null,
      "override": {},
      "dur": 2.4
    },
    {
      "n": 38,
      "text": "So did I.",
      "start": 82.0,
      "end": 83.58,
      "src": "raw/lighthouse/shot_38.mov",
      "src_dur": 1.833,
      "motion": "pull_out",
      "transition": "cut",
      "grade": "warm",
      "placeholder": null,
      "override": {},
      "dur": 1.58
    },
    {
      "n": 39,
      "text": "The next morning, the lighthouse keeper,",
      "start": 83.58,
      "end": 85.78,
      "src": "raw/lighthouse/shot_39.mov",
      "src_dur": 2.817,
      "motion": "push_in",
      "transition": "fog",
      "grade": "warm",
      "placeholder": null,
      "override": {},
      "dur": 2.2
    },
    {
      "n": 40,
      "text": "old Mr. Pell, knocked on our door",
      "start": 85.78,
      "end": 87.82,
      "src": "raw/lighthouse/shot_40.mov",
      "src_dur": 2.8,
      "motion": "push_in",
      "transition": "cut",
      "grade": "warm",
      "placeholder": null,
      "override": {},
      "dur": 2.04
    },
    {
      "n": 41,
      "text": "with a jar of sea glass.",
      "start": 87.82,
      "end": 89.86,
      "src": "raw/lighthouse/shot_41.mov",
      "src_dur": 2.85,
      "motion": "punch",
      "transition": "cut",
      "grade": "warm",
      "placeholder": null,
      "override": {},
      "dur": 2.04
    },
    {
      "n": 42,
      "text": "\"The light doesn't fix lost,\" he said.",
      "start": 89.86,
      "end": 92.64,
      "src": "raw/lighthouse/shot_42.mov",
      "src_dur": 2.833,
      "motion": "push_in",
      "transition": "cut",
      "grade": "warm",
      "placeholder": null,
      "override": {},
      "dur": 2.78
    },
    {
      "n": 43,
      "text": "\"It just shows someone where to sit.\"",
      "start": 92.64,
      "end": 95.06,
      "src": "raw/lighthouse/shot_43.mov",
      "src_dur": 2.8,
      "motion": "push_in",
      "transition": "cut",
      "grade": "warm",
      "placeholder": null,
      "override": {},
      "dur": 2.42
    },
    {
      "n": 44,
      "text": "June took the jar.",
      "start": 95.06,
      "end": 96.7,
      "src": "raw/lighthouse/shot_44.mov",
      "src_dur": 1.8,
      "motion": "push_in",
      "transition": "cut",
      "grade": "warm",
      "placeholder": null,
      "override": {},
      "dur": 1.64
    },
    {
      "n": 45,
      "text": "She held a blue piece up to the sun.",
      "start": 96.7,
      "end": 99.12,
      "src": "raw/lighthouse/shot_45.mov",
      "src_dur": 2.8,
      "motion": "push_in",
      "transition": "sparkle",
      "grade": "warm",
      "placeholder": null,
      "override": {},
      "dur": 2.42
    },
    {
      "n": 46,
      "text": "And for the first time in three weeks,",
      "start": 99.12,
      "end": 101.02,
      "src": "raw/lighthouse/shot_46.mov",
      "src_dur": 2.833,
      "motion": "push_in",
      "transition": "cut",
      "grade": "warm",
      "placeholder": null,
      "override": {},
      "dur": 1.9
    },
    {
      "n": 47,
      "text": "she said one word.",
      "start": 101.02,
      "end": 103.08,
      "src": "raw/lighthouse/shot_47.mov",
      "src_dur": 1.733,
      "motion": "push_in",
      "transition": "cut",
      "grade": "warm",
      "placeholder": null,
      "override": {},
      "dur": 2.06
    },
    {
      "n": 48,
      "text": "\"Home.\"",
      "start": 103.08,
      "end": 105.497,
      "src": "raw/lighthouse/shot_48.mov",
      "src_dur": 2.8,
      "motion": "pull_out",
      "transition": "fog",
      "grade": "warm",
      "placeholder": null,
      "override": {},
      "dur": 2.417
    }
