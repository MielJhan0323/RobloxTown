{
  "slug": "lighthouse",
  "title": "The Lighthouse for Lost People",
  "timing": "voice",
  "voice": "output/stock/voice/lighthouse.wav",
  "duration": 53.932,
  "shots": [
    {
      "n": 1,
      "text": "In this town,",
      "start": 0.0,
      "end": 0.54,
      "src": "raw/lighthouse/shot_01.mov",
      "src_dur": 3.783,
      "motion": "push_in",
      "transition": "cut",
      "grade": "warm",
      "placeholder": null,
      "override": {},
      "dur": 0.54
    },
    {
      "n": 2,
      "text": "the lighthouse shines for anyone who's lost.",
      "start": 0.54,
      "end": 2.24,
      "src": "raw/lighthouse/shot_02.mov",
      "src_dur": 4.767,
      "motion": "push_in",
      "transition": "cut",
      "grade": "warm",
      "placeholder": null,
      "override": {},
      "dur": 1.7
    },
    {
      "n": 3,
      "text": "Not just ships.",
      "start": 2.24,
      "end": 3.02,
      "src": "raw/lighthouse/shot_03.mov",
      "src_dur": 3.733,
      "motion": "pan_right",
      "transition": "cut",
      "grade": "warm",
      "placeholder": null,
      "override": {},
      "dur": 0.78
    },
    {
      "n": 4,
      "text": "People.",
      "start": 3.02,
      "end": 3.6,
      "src": "raw/lighthouse/shot_04.mov",
      "src_dur": 5.55,
      "motion": "punch",
      "transition": "cut",
      "grade": "warm",
      "placeholder": null,
      "override": {},
      "dur": 0.58
    },
    {
      "n": 5,
      "text": "When Tommy Briggs got lost at the summer fair,",
      "start": 3.6,
      "end": 5.18,
      "src": "raw/lighthouse/shot_05.mov",
      "src_dur": 4.583,
      "motion": "pan_left",
      "transition": "cut",
      "grade": "warm",
      "placeholder": null,
      "override": {},
      "dur": 1.58
    },
    {
      "n": 6,
      "text": "the beam found him at the cotton candy stand.",
      "start": 5.18,
      "end": 6.96,
      "src": "raw/lighthouse/shot_06.mov",
      "src_dur": 3.483,
      "motion": "push_in",
      "transition": "cut",
      "grade": "warm",
      "placeholder": null,
      "override": {},
      "dur": 1.78
    },
    {
      "n": 7,
      "text": "When Mrs. Alder lost her glasses,",
      "start": 6.96,
      "end": 8.76,
      "src": "raw/lighthouse/shot_07.mov",
      "src_dur": 3.5,
      "motion": "push_in",
      "transition": "cut",
      "grade": "warm",
      "placeholder": null,
      "override": {},
      "dur": 1.8
    },
    {
      "n": 8,
      "text": "it lit up her own head.",
      "start": 8.76,
      "end": 9.62,
      "src": "raw/lighthouse/shot_08.mov",
      "src_dur": 4.6,
      "motion": "punch",
      "transition": "cut",
      "grade": "warm",
      "placeholder": null,
      "override": {},
      "dur": 0.86
    },
    {
      "n": 9,
      "text": "They were on it.",
      "start": 9.62,
      "end": 10.36,
      "src": "raw/lighthouse/shot_09.mov",
      "src_dur": 3.75,
      "motion": "push_in",
      "transition": "cut",
      "grade": "warm",
      "placeholder": null,
      "override": {
        "src": "raw/lighthouse/shot_08.mov",
        "src_in": 2.6,
        "motion": "punch"
      },
      "dur": 0.74
    },
    {
      "n": 10,
      "text": "And when my dad lost his job,",
      "start": 10.36,
      "end": 11.44,
      "src": "raw/lighthouse/shot_10.mov",
      "src_dur": 3.767,
      "motion": "push_in",
      "transition": "cut",
      "grade": "cool",
      "placeholder": null,
      "override": {},
      "dur": 1.08
    },
    {
      "n": 11,
      "text": "it shone on our porch for a whole week.",
      "start": 11.44,
      "end": 12.94,
      "src": "raw/lighthouse/shot_11.mov",
      "src_dur": 3.767,
      "motion": "push_in",
      "transition": "cut",
      "grade": "cool",
      "placeholder": null,
      "override": {},
      "dur": 1.5
    },
    {
      "n": 12,
      "text": "He pretended not to notice.",
      "start": 12.94,
      "end": 14.14,
      "src": "raw/lighthouse/shot_12.mov",
      "src_dur": 2.65,
      "motion": "push_in",
      "transition": "cut",
      "grade": "cool",
      "placeholder": null,
      "override": {},
      "dur": 1.2
    },
    {
      "n": 13,
      "text": "He noticed.",
      "start": 14.14,
      "end": 14.88,
      "src": "raw/lighthouse/shot_13.mov",
      "src_dur": 3.783,
      "motion": "punch",
      "transition": "cut",
      "grade": "cool",
      "placeholder": null,
      "override": {},
      "dur": 0.74
    },
    {
      "n": 14,
      "text": "Then, we moved.",
      "start": 14.88,
      "end": 15.94,
      "src": "raw/lighthouse/shot_14.mov",
      "src_dur": 2.85,
      "motion": "pan_right",
      "transition": "fog",
      "grade": "neutral",
      "placeholder": null,
      "override": {},
      "dur": 1.06
    },
    {
      "n": 15,
      "text": "Across town, to a little blue house by the docks.",
      "start": 15.94,
      "end": 18.0,
      "src": "raw/lighthouse/shot_15.mov",
      "src_dur": 3.783,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": null,
      "override": {},
      "dur": 2.06
    },
    {
      "n": 16,
      "text": "My sister June was six.",
      "start": 18.0,
      "end": 19.16,
      "src": "raw/lighthouse/shot_16.mov",
      "src_dur": 2.8,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": null,
      "override": {},
      "dur": 1.16
    },
    {
      "n": 17,
      "text": "She stopped talking the day we packed up her room.",
      "start": 19.16,
      "end": 20.84,
      "src": "raw/lighthouse/shot_17.mov",
      "src_dur": 3.817,
      "motion": "pan_left",
      "transition": "cut",
      "grade": "cool",
      "placeholder": null,
      "override": {},
      "dur": 1.68
    },
    {
      "n": 18,
      "text": "Not sad-quiet.",
      "start": 20.84,
      "end": 21.52,
      "src": "raw/lighthouse/shot_18.mov",
      "src_dur": 2.817,
      "motion": "push_in",
      "transition": "cut",
      "grade": "cool",
      "placeholder": null,
      "override": {},
      "dur": 0.68
    },
    {
      "n": 19,
      "text": "Just gone-quiet.",
      "start": 21.52,
      "end": 22.5,
      "src": "raw/lighthouse/shot_19.mov",
      "src_dur": 2.717,
      "motion": "push_in",
      "transition": "cut",
      "grade": "cool",
      "placeholder": null,
      "override": {},
      "dur": 0.98
    },
    {
      "n": 20,
      "text": "Mom tried pancakes.",
      "start": 22.5,
      "end": 23.58,
      "src": "raw/lighthouse/shot_20.mov",
      "src_dur": 2.8,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": null,
      "override": {},
      "dur": 1.08
    },
    {
      "n": 21,
      "text": "Dad tried knock-knock jokes.",
      "start": 23.58,
      "end": 24.82,
      "src": "raw/lighthouse/shot_21.mov",
      "src_dur": 2.833,
      "motion": "pan_right",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": null,
      "override": {},
      "dur": 1.24
    },
    {
      "n": 22,
      "text": "I gave her my bike.",
      "start": 24.82,
      "end": 25.76,
      "src": "raw/lighthouse/shot_22.mov",
      "src_dur": 2.75,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": null,
      "override": {},
      "dur": 0.94
    },
    {
      "n": 23,
      "text": "Nothing.",
      "start": 25.76,
      "end": 26.2,
      "src": "raw/lighthouse/shot_23.mov",
      "src_dur": 1.767,
      "motion": "drift",
      "transition": "cut",
      "grade": "cool",
      "placeholder": null,
      "override": {},
      "dur": 0.44
    },
    {
      "n": 24,
      "text": "The first foggy night, I couldn't sleep.",
      "start": 26.2,
      "end": 27.7,
      "src": "raw/lighthouse/shot_24.mov",
      "src_dur": 2.817,
      "motion": "push_in",
      "transition": "fog",
      "grade": "cool",
      "placeholder": null,
      "override": {},
      "dur": 1.5
    },
    {
      "n": 25,
      "text": "I looked out my window,",
      "start": 27.7,
      "end": 28.48,
      "src": "raw/lighthouse/shot_25.mov",
      "src_dur": 2.817,
      "motion": "push_in",
      "transition": "cut",
      "grade": "cool",
      "placeholder": null,
      "override": {},
      "dur": 0.78
    },
    {
      "n": 26,
      "text": "and the beam was sweeping the whole town.",
      "start": 28.48,
      "end": 29.78,
      "src": "raw/lighthouse/shot_26.mov",
      "src_dur": 2.783,
      "motion": "pan_left",
      "transition": "cut",
      "grade": "cool",
      "placeholder": null,
      "override": {},
      "dur": 1.3
    },
    {
      "n": 27,
      "text": "Then it stopped.",
      "start": 29.78,
      "end": 30.5,
      "src": "raw/lighthouse/shot_27.mov",
      "src_dur": 1.833,
      "motion": "drift",
      "transition": "cut",
      "grade": "cool",
      "placeholder": null,
      "override": {},
      "dur": 0.72
    },
    {
      "n": 28,
      "text": "Right on our house.",
      "start": 30.5,
      "end": 31.38,
      "src": "raw/lighthouse/shot_28.mov",
      "src_dur": 2.75,
      "motion": "punch",
      "transition": "sparkle",
      "grade": "cool",
      "placeholder": null,
      "override": {},
      "dur": 0.88
    },
    {
      "n": 29,
      "text": "On June's window.",
      "start": 31.38,
      "end": 32.28,
      "src": "raw/lighthouse/shot_29.mov",
      "src_dur": 2.817,
      "motion": "push_in",
      "transition": "cut",
      "grade": "cool",
      "placeholder": null,
      "override": {},
      "dur": 0.9
    },
    {
      "n": 30,
      "text": "I tiptoed into her room.",
      "start": 32.28,
      "end": 33.2,
      "src": "raw/lighthouse/shot_30.mov",
      "src_dur": 2.833,
      "motion": "pan_right",
      "transition": "cut",
      "grade": "cool",
      "placeholder": null,
      "override": {},
      "dur": 0.92
    },
    {
      "n": 31,
      "text": "She was sitting up, staring at the light.",
      "start": 33.2,
      "end": 34.84,
      "src": "raw/lighthouse/shot_31.mov",
      "src_dur": 2.783,
      "motion": "push_in",
      "transition": "cut",
      "grade": "cool",
      "placeholder": null,
      "override": {},
      "dur": 1.64
    },
    {
      "n": 32,
      "text": "\"Are you lost?\" I whispered.",
      "start": 34.84,
      "end": 36.36,
      "src": "raw/lighthouse/shot_32.mov",
      "src_dur": 2.817,
      "motion": "push_in",
      "transition": "cut",
      "grade": "cool",
      "placeholder": null,
      "override": {},
      "dur": 1.52
    },
    {
      "n": 33,
      "text": "She nodded.",
      "start": 36.36,
      "end": 36.88,
      "src": "raw/lighthouse/shot_33.mov",
      "src_dur": 1.767,
      "motion": "push_in",
      "transition": "cut",
      "grade": "cool",
      "placeholder": null,
      "override": {},
      "dur": 0.52
    },
    {
      "n": 34,
      "text": "\"Me too, a little,\" I said.",
      "start": 36.88,
      "end": 38.1,
      "src": "raw/lighthouse/shot_34.mov",
      "src_dur": 2.8,
      "motion": "push_in",
      "transition": "cut",
      "grade": "cool",
      "placeholder": null,
      "override": {},
      "dur": 1.22
    },
    {
      "n": 35,
      "text": "\"New house.",
      "start": 38.1,
      "end": 38.52,
      "src": "raw/lighthouse/shot_35.mov",
      "src_dur": 2.783,
      "motion": "push_in",
      "transition": "cut",
      "grade": "cool",
      "placeholder": null,
      "override": {},
      "dur": 0.42
    },
    {
      "n": 36,
      "text": "New street. New everything.\"",
      "start": 38.52,
      "end": 39.64,
      "src": "raw/lighthouse/shot_36.mov",
      "src_dur": 2.8,
      "motion": "push_in",
      "transition": "cut",
      "grade": "cool",
      "placeholder": null,
      "override": {},
      "dur": 1.12
    },
    {
      "n": 37,
      "text": "The light stayed all night.",
      "start": 39.64,
      "end": 40.46,
      "src": "raw/lighthouse/shot_37.mov",
      "src_dur": 2.833,
      "motion": "push_in",
      "transition": "cut",
      "grade": "cool",
      "placeholder": null,
      "override": {},
      "dur": 0.82
    },
    {
      "n": 38,
      "text": "So did I.",
      "start": 40.46,
      "end": 41.2,
      "src": "raw/lighthouse/shot_38.mov",
      "src_dur": 1.833,
      "motion": "pull_out",
      "transition": "cut",
      "grade": "warm",
      "placeholder": null,
      "override": {},
      "dur": 0.74
    },
    {
      "n": 39,
      "text": "The next morning, the lighthouse keeper,",
      "start": 41.2,
      "end": 42.38,
      "src": "raw/lighthouse/shot_39.mov",
      "src_dur": 2.817,
      "motion": "push_in",
      "transition": "fog",
      "grade": "warm",
      "placeholder": null,
      "override": {},
      "dur": 1.18
    },
    {
      "n": 40,
      "text": "old Mr. Pell, knocked on our door",
      "start": 42.38,
      "end": 43.54,
      "src": "raw/lighthouse/shot_40.mov",
      "src_dur": 2.8,
      "motion": "push_in",
      "transition": "cut",
      "grade": "warm",
      "placeholder": null,
      "override": {},
      "dur": 1.16
    },
    {
      "n": 41,
      "text": "with a jar of sea glass.",
      "start": 43.54,
      "end": 44.8,
      "src": "raw/lighthouse/shot_41.mov",
      "src_dur": 2.85,
      "motion": "punch",
      "transition": "cut",
      "grade": "warm",
      "placeholder": null,
      "override": {},
      "dur": 1.26
    },
    {
      "n": 42,
      "text": "\"The light doesn't fix lost,\" he said.",
      "start": 44.8,
      "end": 46.34,
      "src": "raw/lighthouse/shot_42.mov",
      "src_dur": 2.833,
      "motion": "push_in",
      "transition": "cut",
      "grade": "warm",
      "placeholder": null,
      "override": {},
      "dur": 1.54
    },
    {
      "n": 43,
      "text": "\"It just shows someone where to sit.\"",
      "start": 46.34,
      "end": 47.88,
      "src": "raw/lighthouse/shot_43.mov",
      "src_dur": 2.8,
      "motion": "push_in",
      "transition": "cut",
      "grade": "warm",
      "placeholder": null,
      "override": {},
      "dur": 1.54
    },
    {
      "n": 44,
      "text": "June took the jar.",
      "start": 47.88,
      "end": 48.74,
      "src": "raw/lighthouse/shot_44.mov",
      "src_dur": 1.8,
      "motion": "push_in",
      "transition": "cut",
      "grade": "warm",
      "placeholder": null,
      "override": {},
      "dur": 0.86
    },
    {
      "n": 45,
      "text": "She held a blue piece up to the sun.",
      "start": 48.74,
      "end": 50.1,
      "src": "raw/lighthouse/shot_45.mov",
      "src_dur": 2.8,
      "motion": "push_in",
      "transition": "sparkle",
      "grade": "warm",
      "placeholder": null,
      "override": {},
      "dur": 1.36
    },
    {
      "n": 46,
      "text": "And for the first time in three weeks,",
      "start": 50.1,
      "end": 51.22,
      "src": "raw/lighthouse/shot_46.mov",
      "src_dur": 2.833,
      "motion": "push_in",
      "transition": "cut",
      "grade": "warm",
      "placeholder": null,
      "override": {},
      "dur": 1.12
    },
    {
      "n": 47,
      "text": "she said one word.",
      "start": 51.22,
      "end": 52.18,
      "src": "raw/lighthouse/shot_47.mov",
      "src_dur": 1.733,
      "motion": "push_in",
      "transition": "cut",
      "grade": "warm",
      "placeholder": null,
      "override": {},
      "dur": 0.96
    },
    {
      "n": 48,
      "text": "\"Home.\"",
      "start": 52.18,
      "end": 53.932,
      "src": "raw/lighthouse/shot_48.mov",
      "src_dur": 2.8,
      "motion": "pull_out",
      "transition": "fog",
      "grade": "warm",
      "placeholder": null,
      "override": {},
      "dur": 1.752
    }
