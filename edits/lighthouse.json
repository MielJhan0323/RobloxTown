{
  "slug": "lighthouse",
  "title": "The Lighthouse for Lost People",
  "timing": "voice",
  "voice": "output/cache/lighthouse/voice_fx.wav",
  "duration": 75.064,
  "shots": [
    {
      "n": 1,
      "text": "In this town,",
      "start": 0.0,
      "end": 0.84,
      "src": "raw/lighthouse/shot_01.mov",
      "src_dur": 3.783,
      "motion": "push_in",
      "transition": "cut",
      "grade": "warm",
      "placeholder": null,
      "override": {},
      "dur": 0.84
    },
    {
      "n": 2,
      "text": "the lighthouse shines for anyone who's lost.",
      "start": 0.84,
      "end": 3.24,
      "src": "raw/lighthouse/shot_02.mov",
      "src_dur": 4.767,
      "motion": "push_in",
      "transition": "cut",
      "grade": "warm",
      "placeholder": null,
      "override": {},
      "dur": 2.4
    },
    {
      "n": 3,
      "text": "Not just ships.",
      "start": 3.24,
      "end": 4.28,
      "src": "raw/lighthouse/shot_03.mov",
      "src_dur": 3.733,
      "motion": "pan_right",
      "transition": "cut",
      "grade": "warm",
      "placeholder": null,
      "override": {},
      "dur": 1.04
    },
    {
      "n": 4,
      "text": "People.",
      "start": 4.28,
      "end": 5.22,
      "src": "raw/lighthouse/shot_04.mov",
      "src_dur": 5.55,
      "motion": "punch",
      "transition": "cut",
      "grade": "warm",
      "placeholder": null,
      "override": {},
      "dur": 0.94
    },
    {
      "n": 5,
      "text": "When Tommy Briggs got lost at the summer fair,",
      "start": 5.22,
      "end": 7.26,
      "src": "raw/lighthouse/shot_05.mov",
      "src_dur": 4.583,
      "motion": "pan_left",
      "transition": "cut",
      "grade": "warm",
      "placeholder": null,
      "override": {},
      "dur": 2.04
    },
    {
      "n": 6,
      "text": "the beam found him at the cotton candy stand.",
      "start": 7.26,
      "end": 9.5,
      "src": "raw/lighthouse/shot_06.mov",
      "src_dur": 3.483,
      "motion": "push_in",
      "transition": "cut",
      "grade": "warm",
      "placeholder": null,
      "override": {},
      "dur": 2.24
    },
    {
      "n": 7,
      "text": "When Mrs. Alder lost her glasses,",
      "start": 9.5,
      "end": 11.28,
      "src": "raw/lighthouse/shot_07.mov",
      "src_dur": 3.5,
      "motion": "push_in",
      "transition": "cut",
      "grade": "warm",
      "placeholder": null,
      "override": {},
      "dur": 1.78
    },
    {
      "n": 8,
      "text": "it lit up her own head.",
      "start": 11.28,
      "end": 12.64,
      "src": "raw/lighthouse/shot_08.mov",
      "src_dur": 4.6,
      "motion": "punch",
      "transition": "cut",
      "grade": "warm",
      "placeholder": null,
      "override": {},
      "dur": 1.36
    },
    {
      "n": 9,
      "text": "They were on it.",
      "start": 12.64,
      "end": 13.66,
      "src": "raw/lighthouse/shot_09.mov",
      "src_dur": 3.75,
      "motion": "push_in",
      "transition": "cut",
      "grade": "warm",
      "placeholder": null,
      "override": {
        "src": "raw/lighthouse/shot_08.mov",
        "src_in": 2.6,
        "motion": "punch"
      },
      "dur": 1.02
    },
    {
      "n": 10,
      "text": "And when my dad lost his job,",
      "start": 13.66,
      "end": 15.18,
      "src": "raw/lighthouse/shot_10.mov",
      "src_dur": 3.767,
      "motion": "push_in",
      "transition": "cut",
      "grade": "cool",
      "placeholder": null,
      "override": {},
      "dur": 1.52
    },
    {
      "n": 11,
      "text": "it shone on our porch for a whole week.",
      "start": 15.18,
      "end": 17.4,
      "src": "raw/lighthouse/shot_11.mov",
      "src_dur": 3.767,
      "motion": "push_in",
      "transition": "cut",
      "grade": "cool",
      "placeholder": null,
      "override": {},
      "dur": 2.22
    },
    {
      "n": 12,
      "text": "He pretended not to notice.",
      "start": 17.4,
      "end": 19.0,
      "src": "raw/lighthouse/shot_12.mov",
      "src_dur": 2.65,
      "motion": "push_in",
      "transition": "cut",
      "grade": "cool",
      "placeholder": null,
      "override": {},
      "dur": 1.6
    },
    {
      "n": 13,
      "text": "He noticed.",
      "start": 19.0,
      "end": 20.08,
      "src": "raw/lighthouse/shot_13.mov",
      "src_dur": 3.783,
      "motion": "punch",
      "transition": "cut",
      "grade": "cool",
      "placeholder": null,
      "override": {},
      "dur": 1.08
    },
    {
      "n": 14,
      "text": "Then, we moved.",
      "start": 20.08,
      "end": 21.32,
      "src": "raw/lighthouse/shot_14.mov",
      "src_dur": 2.85,
      "motion": "pan_right",
      "transition": "fog",
      "grade": "neutral",
      "placeholder": null,
      "override": {},
      "dur": 1.24
    },
    {
      "n": 15,
      "text": "Across town, to a little blue house by the docks.",
      "start": 21.32,
      "end": 23.82,
      "src": "raw/lighthouse/shot_15.mov",
      "src_dur": 3.783,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": null,
      "override": {},
      "dur": 2.5
    },
    {
      "n": 16,
      "text": "My sister June was six.",
      "start": 23.82,
      "end": 25.38,
      "src": "raw/lighthouse/shot_16.mov",
      "src_dur": 2.8,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": null,
      "override": {},
      "dur": 1.56
    },
    {
      "n": 17,
      "text": "She stopped talking the day we packed up her room.",
      "start": 25.38,
      "end": 27.62,
      "src": "raw/lighthouse/shot_17.mov",
      "src_dur": 3.817,
      "motion": "pan_left",
      "transition": "cut",
      "grade": "cool",
      "placeholder": null,
      "override": {},
      "dur": 2.24
    },
    {
      "n": 18,
      "text": "Not sad-quiet.",
      "start": 27.62,
      "end": 28.88,
      "src": "raw/lighthouse/shot_18.mov",
      "src_dur": 2.817,
      "motion": "push_in",
      "transition": "cut",
      "grade": "cool",
      "placeholder": null,
      "override": {},
      "dur": 1.26
    },
    {
      "n": 19,
      "text": "Just gone-quiet.",
      "start": 28.88,
      "end": 29.98,
      "src": "raw/lighthouse/shot_19.mov",
      "src_dur": 2.717,
      "motion": "push_in",
      "transition": "cut",
      "grade": "cool",
      "placeholder": null,
      "override": {},
      "dur": 1.1
    },
    {
      "n": 20,
      "text": "Mom tried pancakes.",
      "start": 29.98,
      "end": 32.02,
      "src": "raw/lighthouse/shot_20.mov",
      "src_dur": 2.8,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": null,
      "override": {},
      "dur": 2.04
    },
    {
      "n": 21,
      "text": "Dad tried knock-knock jokes.",
      "start": 32.02,
      "end": 33.52,
      "src": "raw/lighthouse/shot_21.mov",
      "src_dur": 2.833,
      "motion": "pan_right",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": null,
      "override": {},
      "dur": 1.5
    },
    {
      "n": 22,
      "text": "I gave her my bike.",
      "start": 33.52,
      "end": 34.86,
      "src": "raw/lighthouse/shot_22.mov",
      "src_dur": 2.75,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": null,
      "override": {},
      "dur": 1.34
    },
    {
      "n": 23,
      "text": "Nothing.",
      "start": 34.86,
      "end": 35.66,
      "src": "raw/lighthouse/shot_23.mov",
      "src_dur": 1.767,
      "motion": "drift",
      "transition": "cut",
      "grade": "cool",
      "placeholder": null,
      "override": {},
      "dur": 0.8
    },
    {
      "n": 24,
      "text": "The first foggy night, I couldn't sleep.",
      "start": 35.66,
      "end": 37.82,
      "src": "raw/lighthouse/shot_24.mov",
      "src_dur": 2.817,
      "motion": "push_in",
      "transition": "fog",
      "grade": "cool",
      "placeholder": null,
      "override": {},
      "dur": 2.16
    },
    {
      "n": 25,
      "text": "I looked out my window,",
      "start": 37.82,
      "end": 38.82,
      "src": "raw/lighthouse/shot_25.mov",
      "src_dur": 2.817,
      "motion": "push_in",
      "transition": "cut",
      "grade": "cool",
      "placeholder": null,
      "override": {},
      "dur": 1.0
    },
    {
      "n": 26,
      "text": "and the beam was sweeping the whole town.",
      "start": 38.82,
      "end": 41.18,
      "src": "raw/lighthouse/shot_26.mov",
      "src_dur": 2.783,
      "motion": "pan_left",
      "transition": "cut",
      "grade": "cool",
      "placeholder": null,
      "override": {},
      "dur": 2.36
    },
    {
      "n": 27,
      "text": "Then it stopped.",
      "start": 41.18,
      "end": 42.32,
      "src": "raw/lighthouse/shot_27.mov",
      "src_dur": 1.833,
      "motion": "drift",
      "transition": "cut",
      "grade": "cool",
      "placeholder": null,
      "override": {},
      "dur": 1.14
    },
    {
      "n": 28,
      "text": "Right on our house.",
      "start": 42.32,
      "end": 43.36,
      "src": "raw/lighthouse/shot_28.mov",
      "src_dur": 2.75,
      "motion": "punch",
      "transition": "sparkle",
      "grade": "cool",
      "placeholder": null,
      "override": {},
      "dur": 1.04
    },
    {
      "n": 29,
      "text": "On June's window.",
      "start": 43.36,
      "end": 44.58,
      "src": "raw/lighthouse/shot_29.mov",
      "src_dur": 2.817,
      "motion": "push_in",
      "transition": "cut",
      "grade": "cool",
      "placeholder": null,
      "override": {},
      "dur": 1.22
    },
    {
      "n": 30,
      "text": "I tiptoed into her room.",
      "start": 44.58,
      "end": 46.12,
      "src": "raw/lighthouse/shot_30.mov",
      "src_dur": 2.833,
      "motion": "pan_right",
      "transition": "cut",
      "grade": "cool",
      "placeholder": null,
      "override": {},
      "dur": 1.54
    },
    {
      "n": 31,
      "text": "She was sitting up, staring at the light.",
      "start": 46.12,
      "end": 47.74,
      "src": "raw/lighthouse/shot_31.mov",
      "src_dur": 2.783,
      "motion": "push_in",
      "transition": "cut",
      "grade": "cool",
      "placeholder": null,
      "override": {},
      "dur": 1.62
    },
    {
      "n": 32,
      "text": "\"Are you lost?\" I whispered.",
      "start": 47.74,
      "end": 50.2,
      "src": "raw/lighthouse/shot_32.mov",
      "src_dur": 2.817,
      "motion": "push_in",
      "transition": "cut",
      "grade": "cool",
      "placeholder": null,
      "override": {},
      "dur": 2.46
    },
    {
      "n": 33,
      "text": "She nodded.",
      "start": 50.2,
      "end": 50.98,
      "src": "raw/lighthouse/shot_33.mov",
      "src_dur": 1.767,
      "motion": "push_in",
      "transition": "cut",
      "grade": "cool",
      "placeholder": null,
      "override": {},
      "dur": 0.78
    },
    {
      "n": 34,
      "text": "\"Me too, a little,\" I said.",
      "start": 50.98,
      "end": 53.1,
      "src": "raw/lighthouse/shot_34.mov",
      "src_dur": 2.8,
      "motion": "push_in",
      "transition": "cut",
      "grade": "cool",
      "placeholder": null,
      "override": {},
      "dur": 2.12
    },
    {
      "n": 35,
      "text": "\"New house.",
      "start": 53.1,
      "end": 53.92,
      "src": "raw/lighthouse/shot_35.mov",
      "src_dur": 2.783,
      "motion": "push_in",
      "transition": "cut",
      "grade": "cool",
      "placeholder": null,
      "override": {},
      "dur": 0.82
    },
    {
      "n": 36,
      "text": "New street. New everything.\"",
      "start": 53.92,
      "end": 55.88,
      "src": "raw/lighthouse/shot_36.mov",
      "src_dur": 2.8,
      "motion": "push_in",
      "transition": "cut",
      "grade": "cool",
      "placeholder": null,
      "override": {},
      "dur": 1.96
    },
    {
      "n": 37,
      "text": "The light stayed all night.",
      "start": 55.88,
      "end": 57.52,
      "src": "raw/lighthouse/shot_37.mov",
      "src_dur": 2.833,
      "motion": "push_in",
      "transition": "cut",
      "grade": "cool",
      "placeholder": null,
      "override": {},
      "dur": 1.64
    },
    {
      "n": 38,
      "text": "So did I.",
      "start": 57.52,
      "end": 58.32,
      "src": "raw/lighthouse/shot_38.mov",
      "src_dur": 1.833,
      "motion": "pull_out",
      "transition": "cut",
      "grade": "warm",
      "placeholder": null,
      "override": {},
      "dur": 0.8
    },
    {
      "n": 39,
      "text": "The next morning, the lighthouse keeper,",
      "start": 58.32,
      "end": 60.0,
      "src": "raw/lighthouse/shot_39.mov",
      "src_dur": 2.817,
      "motion": "push_in",
      "transition": "fog",
      "grade": "warm",
      "placeholder": null,
      "override": {},
      "dur": 1.68
    },
    {
      "n": 40,
      "text": "old Mr. Pell, knocked on our door",
      "start": 60.0,
      "end": 61.46,
      "src": "raw/lighthouse/shot_40.mov",
      "src_dur": 2.8,
      "motion": "push_in",
      "transition": "cut",
      "grade": "warm",
      "placeholder": null,
      "override": {},
      "dur": 1.46
    },
    {
      "n": 41,
      "text": "with a jar of sea glass.",
      "start": 61.46,
      "end": 62.96,
      "src": "raw/lighthouse/shot_41.mov",
      "src_dur": 2.85,
      "motion": "punch",
      "transition": "cut",
      "grade": "warm",
      "placeholder": null,
      "override": {},
      "dur": 1.5
    },
    {
      "n": 42,
      "text": "\"The light doesn't fix lost,\" he said.",
      "start": 62.96,
      "end": 65.18,
      "src": "raw/lighthouse/shot_42.mov",
      "src_dur": 2.833,
      "motion": "push_in",
      "transition": "cut",
      "grade": "warm",
      "placeholder": null,
      "override": {},
      "dur": 2.22
    },
    {
      "n": 43,
      "text": "\"It just shows someone where to sit.\"",
      "start": 65.18,
      "end": 66.96,
      "src": "raw/lighthouse/shot_43.mov",
      "src_dur": 2.8,
      "motion": "push_in",
      "transition": "cut",
      "grade": "warm",
      "placeholder": null,
      "override": {},
      "dur": 1.78
    },
    {
      "n": 44,
      "text": "June took the jar.",
      "start": 66.96,
      "end": 68.02,
      "src": "raw/lighthouse/shot_44.mov",
      "src_dur": 1.8,
      "motion": "push_in",
      "transition": "cut",
      "grade": "warm",
      "placeholder": null,
      "override": {},
      "dur": 1.06
    },
    {
      "n": 45,
      "text": "She held a blue piece up to the sun.",
      "start": 68.02,
      "end": 69.76,
      "src": "raw/lighthouse/shot_45.mov",
      "src_dur": 2.8,
      "motion": "push_in",
      "transition": "sparkle",
      "grade": "warm",
      "placeholder": null,
      "override": {},
      "dur": 1.74
    },
    {
      "n": 46,
      "text": "And for the first time in three weeks,",
      "start": 69.76,
      "end": 71.7,
      "src": "raw/lighthouse/shot_46.mov",
      "src_dur": 2.833,
      "motion": "push_in",
      "transition": "cut",
      "grade": "warm",
      "placeholder": null,
      "override": {},
      "dur": 1.94
    },
    {
      "n": 47,
      "text": "she said one word.",
      "start": 71.7,
      "end": 73.14,
      "src": "raw/lighthouse/shot_47.mov",
      "src_dur": 1.733,
      "motion": "push_in",
      "transition": "cut",
      "grade": "warm",
      "placeholder": null,
      "override": {},
      "dur": 1.44
    },
    {
      "n": 48,
      "text": "\"Home.\"",
      "start": 73.14,
      "end": 75.064,
      "src": "raw/lighthouse/shot_48.mov",
      "src_dur": 2.8,
      "motion": "pull_out",
      "transition": "fog",
      "grade": "warm",
      "placeholder": null,
      "override": {},
      "dur": 1.924
    }
