{
  "slug": "lighthouse",
  "title": "The Lighthouse for Lost People",
  "timing": "voice",
  "voice": "audio/voice/lighthouse.mp3",
  "duration": 93.508,
  "shots": [
    {
      "n": 1,
      "text": "In this town,",
      "start": 0.0,
      "end": 1.2,
      "src": "raw/lighthouse/shot_01.mov",
      "src_dur": 3.783,
      "motion": "push_in",
      "transition": "cut",
      "grade": "warm",
      "placeholder": null,
      "override": {},
      "dur": 1.2
    },
    {
      "n": 2,
      "text": "the lighthouse shines for anyone who's lost.",
      "start": 1.2,
      "end": 4.02,
      "src": "raw/lighthouse/shot_02.mov",
      "src_dur": 4.767,
      "motion": "push_in",
      "transition": "cut",
      "grade": "warm",
      "placeholder": null,
      "override": {},
      "dur": 2.82
    },
    {
      "n": 3,
      "text": "Not just ships.",
      "start": 4.02,
      "end": 5.38,
      "src": "raw/lighthouse/shot_03.mov",
      "src_dur": 3.733,
      "motion": "pan_right",
      "transition": "cut",
      "grade": "warm",
      "placeholder": null,
      "override": {},
      "dur": 1.36
    },
    {
      "n": 4,
      "text": "People.",
      "start": 5.38,
      "end": 6.56,
      "src": "raw/lighthouse/shot_04.mov",
      "src_dur": 5.55,
      "motion": "punch",
      "transition": "cut",
      "grade": "warm",
      "placeholder": null,
      "override": {},
      "dur": 1.18
    },
    {
      "n": 5,
      "text": "When Tommy Briggs got lost at the summer fair,",
      "start": 6.56,
      "end": 9.1,
      "src": "raw/lighthouse/shot_05.mov",
      "src_dur": 4.583,
      "motion": "pan_left",
      "transition": "cut",
      "grade": "warm",
      "placeholder": null,
      "override": {},
      "dur": 2.54
    },
    {
      "n": 6,
      "text": "the beam found him at the cotton candy stand.",
      "start": 9.1,
      "end": 11.84,
      "src": "raw/lighthouse/shot_06.mov",
      "src_dur": 3.483,
      "motion": "push_in",
      "transition": "cut",
      "grade": "warm",
      "placeholder": null,
      "override": {},
      "dur": 2.74
    },
    {
      "n": 7,
      "text": "When Mrs. Alder lost her glasses,",
      "start": 11.84,
      "end": 14.06,
      "src": "raw/lighthouse/shot_07.mov",
      "src_dur": 3.5,
      "motion": "push_in",
      "transition": "cut",
      "grade": "warm",
      "placeholder": null,
      "override": {},
      "dur": 2.22
    },
    {
      "n": 8,
      "text": "it lit up her own head.",
      "start": 14.06,
      "end": 15.78,
      "src": "raw/lighthouse/shot_08.mov",
      "src_dur": 4.6,
      "motion": "punch",
      "transition": "cut",
      "grade": "warm",
      "placeholder": null,
      "override": {},
      "dur": 1.72
    },
    {
      "n": 9,
      "text": "They were on it.",
      "start": 15.78,
      "end": 17.08,
      "src": "raw/lighthouse/shot_09.mov",
      "src_dur": 3.75,
      "motion": "push_in",
      "transition": "cut",
      "grade": "warm",
      "placeholder": null,
      "override": {
        "src": "raw/lighthouse/shot_08.mov",
        "src_in": 2.6,
        "motion": "punch"
      },
      "dur": 1.3
    },
    {
      "n": 10,
      "text": "And when my dad lost his job,",
      "start": 17.08,
      "end": 18.98,
      "src": "raw/lighthouse/shot_10.mov",
      "src_dur": 3.767,
      "motion": "push_in",
      "transition": "cut",
      "grade": "cool",
      "placeholder": null,
      "override": {},
      "dur": 1.9
    },
    {
      "n": 11,
      "text": "it shone on our porch for a whole week.",
      "start": 18.98,
      "end": 21.72,
      "src": "raw/lighthouse/shot_11.mov",
      "src_dur": 3.767,
      "motion": "push_in",
      "transition": "cut",
      "grade": "cool",
      "placeholder": null,
      "override": {},
      "dur": 2.74
    },
    {
      "n": 12,
      "text": "He pretended not to notice.",
      "start": 21.72,
      "end": 23.74,
      "src": "raw/lighthouse/shot_12.mov",
      "src_dur": 2.65,
      "motion": "push_in",
      "transition": "cut",
      "grade": "cool",
      "placeholder": null,
      "override": {},
      "dur": 2.02
    },
    {
      "n": 13,
      "text": "He noticed.",
      "start": 23.74,
      "end": 25.04,
      "src": "raw/lighthouse/shot_13.mov",
      "src_dur": 3.783,
      "motion": "punch",
      "transition": "cut",
      "grade": "cool",
      "placeholder": null,
      "override": {},
      "dur": 1.3
    },
    {
      "n": 14,
      "text": "Then, we moved.",
      "start": 25.04,
      "end": 26.6,
      "src": "raw/lighthouse/shot_14.mov",
      "src_dur": 2.85,
      "motion": "pan_right",
      "transition": "fog",
      "grade": "neutral",
      "placeholder": null,
      "override": {},
      "dur": 1.56
    },
    {
      "n": 15,
      "text": "Across town, to a little blue house by the docks.",
      "start": 26.6,
      "end": 29.22,
      "src": "raw/lighthouse/shot_15.mov",
      "src_dur": 3.783,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": null,
      "override": {},
      "dur": 2.62
    },
    {
      "n": 16,
      "text": "My sister June was six.",
      "start": 29.22,
      "end": 31.82,
      "src": "raw/lighthouse/shot_16.mov",
      "src_dur": 2.8,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": null,
      "override": {},
      "dur": 2.6
    },
    {
      "n": 17,
      "text": "She stopped talking the day we packed up her room.",
      "start": 31.82,
      "end": 34.62,
      "src": "raw/lighthouse/shot_17.mov",
      "src_dur": 3.817,
      "motion": "pan_left",
      "transition": "cut",
      "grade": "cool",
      "placeholder": null,
      "override": {},
      "dur": 2.8
    },
    {
      "n": 18,
      "text": "Not sad-quiet.",
      "start": 34.62,
      "end": 36.08,
      "src": "raw/lighthouse/shot_18.mov",
      "src_dur": 2.817,
      "motion": "push_in",
      "transition": "cut",
      "grade": "cool",
      "placeholder": null,
      "override": {},
      "dur": 1.46
    },
    {
      "n": 19,
      "text": "Just gone-quiet.",
      "start": 36.08,
      "end": 38.2,
      "src": "raw/lighthouse/shot_19.mov",
      "src_dur": 2.717,
      "motion": "push_in",
      "transition": "cut",
      "grade": "cool",
      "placeholder": null,
      "override": {},
      "dur": 2.12
    },
    {
      "n": 20,
      "text": "Mom tried pancakes.",
      "start": 38.2,
      "end": 39.98,
      "src": "raw/lighthouse/shot_20.mov",
      "src_dur": 2.8,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": null,
      "override": {},
      "dur": 1.78
    },
    {
      "n": 21,
      "text": "Dad tried knock-knock jokes.",
      "start": 39.98,
      "end": 41.64,
      "src": "raw/lighthouse/shot_21.mov",
      "src_dur": 2.833,
      "motion": "pan_right",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": null,
      "override": {},
      "dur": 1.66
    },
    {
      "n": 22,
      "text": "I gave her my bike.",
      "start": 41.64,
      "end": 43.48,
      "src": "raw/lighthouse/shot_22.mov",
      "src_dur": 2.75,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": null,
      "override": {},
      "dur": 1.84
    },
    {
      "n": 23,
      "text": "Nothing.",
      "start": 43.48,
      "end": 44.44,
      "src": "raw/lighthouse/shot_23.mov",
      "src_dur": 1.767,
      "motion": "drift",
      "transition": "cut",
      "grade": "cool",
      "placeholder": null,
      "override": {},
      "dur": 0.96
    },
    {
      "n": 24,
      "text": "The first foggy night, I couldn't sleep.",
      "start": 44.44,
      "end": 47.16,
      "src": "raw/lighthouse/shot_24.mov",
      "src_dur": 2.817,
      "motion": "push_in",
      "transition": "fog",
      "grade": "cool",
      "placeholder": null,
      "override": {},
      "dur": 2.72
    },
    {
      "n": 25,
      "text": "I looked out my window,",
      "start": 47.16,
      "end": 48.48,
      "src": "raw/lighthouse/shot_25.mov",
      "src_dur": 2.817,
      "motion": "push_in",
      "transition": "cut",
      "grade": "cool",
      "placeholder": null,
      "override": {},
      "dur": 1.32
    },
    {
      "n": 26,
      "text": "and the beam was sweeping the whole town.",
      "start": 48.48,
      "end": 51.42,
      "src": "raw/lighthouse/shot_26.mov",
      "src_dur": 2.783,
      "motion": "pan_left",
      "transition": "cut",
      "grade": "cool",
      "placeholder": null,
      "override": {},
      "dur": 2.94
    },
    {
      "n": 27,
      "text": "Then it stopped.",
      "start": 51.42,
      "end": 52.68,
      "src": "raw/lighthouse/shot_27.mov",
      "src_dur": 1.833,
      "motion": "drift",
      "transition": "cut",
      "grade": "cool",
      "placeholder": null,
      "override": {},
      "dur": 1.26
    },
    {
      "n": 28,
      "text": "Right on our house.",
      "start": 52.68,
      "end": 54.16,
      "src": "raw/lighthouse/shot_28.mov",
      "src_dur": 2.75,
      "motion": "punch",
      "transition": "sparkle",
      "grade": "cool",
      "placeholder": null,
      "override": {},
      "dur": 1.48
    },
    {
      "n": 29,
      "text": "On June's window.",
      "start": 54.16,
      "end": 55.66,
      "src": "raw/lighthouse/shot_29.mov",
      "src_dur": 2.817,
      "motion": "push_in",
      "transition": "cut",
      "grade": "cool",
      "placeholder": null,
      "override": {},
      "dur": 1.5
    },
    {
      "n": 30,
      "text": "I tiptoed into her room.",
      "start": 55.66,
      "end": 57.6,
      "src": "raw/lighthouse/shot_30.mov",
      "src_dur": 2.833,
      "motion": "pan_right",
      "transition": "cut",
      "grade": "cool",
      "placeholder": null,
      "override": {},
      "dur": 1.94
    },
    {
      "n": 31,
      "text": "She was sitting up, staring at the light.",
      "start": 57.6,
      "end": 60.06,
      "src": "raw/lighthouse/shot_31.mov",
      "src_dur": 2.783,
      "motion": "push_in",
      "transition": "cut",
      "grade": "cool",
      "placeholder": null,
      "override": {},
      "dur": 2.46
    },
    {
      "n": 32,
      "text": "\"Are you lost?\" I whispered.",
      "start": 60.06,
      "end": 62.74,
      "src": "raw/lighthouse/shot_32.mov",
      "src_dur": 2.817,
      "motion": "push_in",
      "transition": "cut",
      "grade": "cool",
      "placeholder": null,
      "override": {},
      "dur": 2.68
    },
    {
      "n": 33,
      "text": "She nodded.",
      "start": 62.74,
      "end": 63.74,
      "src": "raw/lighthouse/shot_33.mov",
      "src_dur": 1.767,
      "motion": "push_in",
      "transition": "cut",
      "grade": "cool",
      "placeholder": null,
      "override": {},
      "dur": 1.0
    },
    {
      "n": 34,
      "text": "\"Me too, a little,\" I said.",
      "start": 63.74,
      "end": 66.4,
      "src": "raw/lighthouse/shot_34.mov",
      "src_dur": 2.8,
      "motion": "push_in",
      "transition": "cut",
      "grade": "cool",
      "placeholder": null,
      "override": {},
      "dur": 2.66
    },
    {
      "n": 35,
      "text": "\"New house.",
      "start": 66.4,
      "end": 67.3,
      "src": "raw/lighthouse/shot_35.mov",
      "src_dur": 2.783,
      "motion": "push_in",
      "transition": "cut",
      "grade": "cool",
      "placeholder": null,
      "override": {},
      "dur": 0.9
    },
    {
      "n": 36,
      "text": "New street. New everything.\"",
      "start": 67.3,
      "end": 69.86,
      "src": "raw/lighthouse/shot_36.mov",
      "src_dur": 2.8,
      "motion": "push_in",
      "transition": "cut",
      "grade": "cool",
      "placeholder": null,
      "override": {},
      "dur": 2.56
    },
    {
      "n": 37,
      "text": "The light stayed all night.",
      "start": 69.86,
      "end": 71.9,
      "src": "raw/lighthouse/shot_37.mov",
      "src_dur": 2.833,
      "motion": "push_in",
      "transition": "cut",
      "grade": "cool",
      "placeholder": null,
      "override": {},
      "dur": 2.04
    },
    {
      "n": 38,
      "text": "So did I.",
      "start": 71.9,
      "end": 72.94,
      "src": "raw/lighthouse/shot_38.mov",
      "src_dur": 1.833,
      "motion": "pull_out",
      "transition": "cut",
      "grade": "warm",
      "placeholder": null,
      "override": {},
      "dur": 1.04
    },
    {
      "n": 39,
      "text": "The next morning, the lighthouse keeper,",
      "start": 72.94,
      "end": 75.02,
      "src": "raw/lighthouse/shot_39.mov",
      "src_dur": 2.817,
      "motion": "push_in",
      "transition": "fog",
      "grade": "warm",
      "placeholder": null,
      "override": {},
      "dur": 2.08
    },
    {
      "n": 40,
      "text": "old Mr. Pell, knocked on our door",
      "start": 75.02,
      "end": 76.82,
      "src": "raw/lighthouse/shot_40.mov",
      "src_dur": 2.8,
      "motion": "push_in",
      "transition": "cut",
      "grade": "warm",
      "placeholder": null,
      "override": {},
      "dur": 1.8
    },
    {
      "n": 41,
      "text": "with a jar of sea glass.",
      "start": 76.82,
      "end": 78.22,
      "src": "raw/lighthouse/shot_41.mov",
      "src_dur": 2.85,
      "motion": "punch",
      "transition": "cut",
      "grade": "warm",
      "placeholder": null,
      "override": {},
      "dur": 1.4
    },
    {
      "n": 42,
      "text": "\"The light doesn't fix lost,\" he said.",
      "start": 78.22,
      "end": 81.48,
      "src": "raw/lighthouse/shot_42.mov",
      "src_dur": 2.833,
      "motion": "push_in",
      "transition": "cut",
      "grade": "warm",
      "placeholder": null,
      "override": {},
      "dur": 3.26
    },
    {
      "n": 43,
      "text": "\"It just shows someone where to sit.\"",
      "start": 81.48,
      "end": 83.74,
      "src": "raw/lighthouse/shot_43.mov",
      "src_dur": 2.8,
      "motion": "push_in",
      "transition": "cut",
      "grade": "warm",
      "placeholder": null,
      "override": {},
      "dur": 2.26
    },
    {
      "n": 44,
      "text": "June took the jar.",
      "start": 83.74,
      "end": 85.02,
      "src": "raw/lighthouse/shot_44.mov",
      "src_dur": 1.8,
      "motion": "push_in",
      "transition": "cut",
      "grade": "warm",
      "placeholder": null,
      "override": {},
      "dur": 1.28
    },
    {
      "n": 45,
      "text": "She held a blue piece up to the sun.",
      "start": 85.02,
      "end": 87.24,
      "src": "raw/lighthouse/shot_45.mov",
      "src_dur": 2.8,
      "motion": "push_in",
      "transition": "sparkle",
      "grade": "warm",
      "placeholder": null,
      "override": {},
      "dur": 2.22
    },
    {
      "n": 46,
      "text": "And for the first time in three weeks,",
      "start": 87.24,
      "end": 89.62,
      "src": "raw/lighthouse/shot_46.mov",
      "src_dur": 2.833,
      "motion": "push_in",
      "transition": "cut",
      "grade": "warm",
      "placeholder": null,
      "override": {},
      "dur": 2.38
    },
    {
      "n": 47,
      "text": "she said one word.",
      "start": 89.62,
      "end": 91.2,
      "src": "raw/lighthouse/shot_47.mov",
      "src_dur": 1.733,
      "motion": "push_in",
      "transition": "cut",
      "grade": "warm",
      "placeholder": null,
      "override": {},
      "dur": 1.58
    },
    {
      "n": 48,
      "text": "\"Home.\"",
      "start": 91.2,
      "end": 93.508,
      "src": "raw/lighthouse/shot_48.mov",
      "src_dur": 2.8,
      "motion": "pull_out",
      "transition": "fog",
      "grade": "warm",
      "placeholder": null,
      "override": {},
      "dur": 2.308
    }
