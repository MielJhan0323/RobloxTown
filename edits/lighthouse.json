  "duration": 65.566,
  "shots": [
    {
      "n": 1,
      "text": "In this town,",
      "start": 0.0,
      "end": 0.82,
      "src": "raw/lighthouse/shot_01.mov",
      "src_dur": 3.783,
      "motion": "push_in",
      "transition": "cut",
      "grade": "warm",
      "placeholder": null,
      "override": {},
      "dur": 0.82
    },
    {
      "n": 2,
      "text": "the lighthouse shines for anyone who's lost.",
      "start": 0.82,
      "end": 2.8,
      "src": "raw/lighthouse/shot_02.mov",
      "src_dur": 4.767,
      "motion": "push_in",
      "transition": "cut",
      "grade": "warm",
      "placeholder": null,
      "override": {},
      "dur": 1.98
    },
    {
      "n": 3,
      "text": "Not just ships.",
      "start": 2.8,
      "end": 3.78,
      "src": "raw/lighthouse/shot_03.mov",
      "src_dur": 3.733,
      "motion": "pan_right",
      "transition": "cut",
      "grade": "warm",
      "placeholder": null,
      "override": {},
      "dur": 0.98
    },
    {
      "n": 4,
      "text": "People.",
      "start": 3.78,
      "end": 4.42,
      "src": "raw/lighthouse/shot_04.mov",
      "src_dur": 5.55,
      "motion": "punch",
      "transition": "cut",
      "grade": "warm",
      "placeholder": null,
      "override": {},
      "dur": 0.64
    },
    {
      "n": 5,
      "text": "When Tommy Briggs got lost at the summer fair,",
      "start": 4.42,
      "end": 6.18,
      "src": "raw/lighthouse/shot_05.mov",
      "src_dur": 4.583,
      "motion": "pan_left",
      "transition": "cut",
      "grade": "warm",
      "placeholder": null,
      "override": {},
      "dur": 1.76
    },
    {
      "n": 6,
      "text": "the beam found him at the cotton candy stand.",
      "start": 6.18,
      "end": 7.73,
      "src": "raw/lighthouse/shot_06.mov",
      "src_dur": 3.483,
      "motion": "push_in",
      "transition": "cut",
      "grade": "warm",
      "placeholder": null,
      "override": {},
      "dur": 1.55
    },
    {
      "n": 7,
      "text": "When Mrs. Alder lost her glasses,",
      "start": 7.73,
      "end": 9.35,
      "src": "raw/lighthouse/shot_07.mov",
      "src_dur": 3.5,
      "motion": "push_in",
      "transition": "cut",
      "grade": "warm",
      "placeholder": null,
      "override": {},
      "dur": 1.62
    },
    {
      "n": 8,
      "text": "it lit up her own head.",
      "start": 9.35,
      "end": 10.71,
      "src": "raw/lighthouse/shot_08.mov",
      "src_dur": 4.6,
      "motion": "punch",
      "transition": "cut",
      "grade": "warm",
      "placeholder": null,
      "override": {},
      "dur": 1.36
    },
    {
      "n": 9,
      "text": "They were on it.",
      "start": 10.71,
      "end": 11.69,
      "src": "raw/lighthouse/shot_09.mov",
      "src_dur": 3.75,
      "motion": "push_in",
      "transition": "cut",
      "grade": "warm",
      "placeholder": null,
      "override": {
        "src": "raw/lighthouse/shot_08.mov",
        "src_in": 2.6,
        "motion": "punch"
      },
      "dur": 0.98
    },
    {
      "n": 10,
      "text": "And when my dad lost his job,",
      "start": 11.69,
      "end": 13.15,
      "src": "raw/lighthouse/shot_10.mov",
      "src_dur": 3.767,
      "motion": "push_in",
      "transition": "cut",
      "grade": "cool",
      "placeholder": null,
      "override": {},
      "dur": 1.46
    },
    {
      "n": 11,
      "text": "it shone on our porch for a whole week.",
      "start": 13.15,
      "end": 15.07,
      "src": "raw/lighthouse/shot_11.mov",
      "src_dur": 3.767,
      "motion": "push_in",
      "transition": "cut",
      "grade": "cool",
      "placeholder": null,
      "override": {},
      "dur": 1.92
    },
    {
      "n": 12,
      "text": "He pretended not to notice.",
      "start": 15.07,
      "end": 16.38,
      "src": "raw/lighthouse/shot_12.mov",
      "src_dur": 2.65,
      "motion": "push_in",
      "transition": "cut",
      "grade": "cool",
      "placeholder": null,
      "override": {},
      "dur": 1.31
    },
    {
      "n": 13,
      "text": "He noticed.",
      "start": 16.38,
      "end": 17.32,
      "src": "raw/lighthouse/shot_13.mov",
      "src_dur": 3.783,
      "motion": "punch",
      "transition": "cut",
      "grade": "cool",
      "placeholder": null,
      "override": {},
      "dur": 0.94
    },
    {
      "n": 14,
      "text": "Then, we moved.",
      "start": 17.32,
      "end": 18.36,
      "src": "raw/lighthouse/shot_14.mov",
      "src_dur": 2.85,
      "motion": "pan_right",
      "transition": "fog",
      "grade": "neutral",
      "placeholder": null,
      "override": {},
      "dur": 1.04
    },
    {
      "n": 15,
      "text": "Across town, to a little blue house by the docks.",
      "start": 18.36,
      "end": 20.56,
      "src": "raw/lighthouse/shot_15.mov",
      "src_dur": 3.783,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": null,
      "override": {},
      "dur": 2.2
    },
    {
      "n": 16,
      "text": "My sister June was six.",
      "start": 20.56,
      "end": 21.98,
      "src": "raw/lighthouse/shot_16.mov",
      "src_dur": 2.8,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": null,
      "override": {},
      "dur": 1.42
    },
    {
      "n": 17,
      "text": "She stopped talking the day we packed up her room.",
      "start": 21.98,
      "end": 24.0,
      "src": "raw/lighthouse/shot_17.mov",
      "src_dur": 3.817,
      "motion": "pan_left",
      "transition": "cut",
      "grade": "cool",
      "placeholder": null,
      "override": {},
      "dur": 2.02
    },
    {
      "n": 18,
      "text": "Not sad-quiet.",
      "start": 24.0,
      "end": 25.1,
      "src": "raw/lighthouse/shot_18.mov",
      "src_dur": 2.817,
      "motion": "push_in",
      "transition": "cut",
      "grade": "cool",
      "placeholder": null,
      "override": {},
      "dur": 1.1
    },
    {
      "n": 19,
      "text": "Just gone-quiet.",
      "start": 25.1,
      "end": 26.63,
      "src": "raw/lighthouse/shot_19.mov",
      "src_dur": 2.717,
      "motion": "push_in",
      "transition": "cut",
      "grade": "cool",
      "placeholder": null,
      "override": {},
      "dur": 1.53
    },
    {
      "n": 20,
      "text": "Mom tried pancakes.",
      "start": 26.63,
      "end": 27.71,
      "src": "raw/lighthouse/shot_20.mov",
      "src_dur": 2.8,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": null,
      "override": {},
      "dur": 1.08
    },
    {
      "n": 21,
      "text": "Dad tried knock-knock jokes.",
      "start": 27.71,
      "end": 29.01,
      "src": "raw/lighthouse/shot_21.mov",
      "src_dur": 2.833,
      "motion": "pan_right",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": null,
      "override": {},
      "dur": 1.3
    },
    {
      "n": 22,
      "text": "I gave her my bike.",
      "start": 29.01,
      "end": 30.03,
      "src": "raw/lighthouse/shot_22.mov",
      "src_dur": 2.75,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": null,
      "override": {},
      "dur": 1.02
    },
    {
      "n": 23,
      "text": "Nothing.",
      "start": 30.03,
      "end": 30.75,
      "src": "raw/lighthouse/shot_23.mov",
      "src_dur": 1.767,
      "motion": "drift",
      "transition": "cut",
      "grade": "cool",
      "placeholder": null,
      "override": {},
      "dur": 0.72
    },
    {
      "n": 24,
      "text": "The first foggy night, I couldn't sleep.",
      "start": 30.75,
      "end": 32.25,
      "src": "raw/lighthouse/shot_24.mov",
      "src_dur": 2.817,
      "motion": "push_in",
      "transition": "fog",
      "grade": "cool",
      "placeholder": null,
      "override": {},
      "dur": 1.5
    },
    {
      "n": 25,
      "text": "I looked out my window,",
      "start": 32.25,
      "end": 33.38,
      "src": "raw/lighthouse/shot_25.mov",
      "src_dur": 2.817,
      "motion": "push_in",
      "transition": "cut",
      "grade": "cool",
      "placeholder": null,
      "override": {},
      "dur": 1.13
    },
    {
      "n": 26,
      "text": "and the beam was sweeping the whole town.",
      "start": 33.38,
      "end": 35.58,
      "src": "raw/lighthouse/shot_26.mov",
      "src_dur": 2.783,
      "motion": "pan_left",
      "transition": "cut",
      "grade": "cool",
      "placeholder": null,
      "override": {},
      "dur": 2.2
    },
    {
      "n": 27,
      "text": "Then it stopped.",
      "start": 35.58,
      "end": 36.1,
      "src": "raw/lighthouse/shot_27.mov",
      "src_dur": 1.833,
      "motion": "drift",
      "transition": "cut",
      "grade": "cool",
      "placeholder": null,
      "override": {},
      "dur": 0.52
    },
    {
      "n": 28,
      "text": "Right on our house.",
      "start": 36.1,
      "end": 37.58,
      "src": "raw/lighthouse/shot_28.mov",
      "src_dur": 2.75,
      "motion": "punch",
      "transition": "sparkle",
      "grade": "cool",
      "placeholder": null,
      "override": {},
      "dur": 1.48
    },
    {
      "n": 29,
      "text": "On June's window.",
      "start": 37.58,
      "end": 38.76,
      "src": "raw/lighthouse/shot_29.mov",
      "src_dur": 2.817,
      "motion": "push_in",
      "transition": "cut",
      "grade": "cool",
      "placeholder": null,
      "override": {},
      "dur": 1.18
    },
    {
      "n": 30,
      "text": "I tiptoed into her room.",
      "start": 38.76,
      "end": 39.56,
      "src": "raw/lighthouse/shot_30.mov",
      "src_dur": 2.833,
      "motion": "pan_right",
      "transition": "cut",
      "grade": "cool",
      "placeholder": null,
      "override": {},
      "dur": 0.8
    },
    {
      "n": 31,
      "text": "She was sitting up, staring at the light.",
      "start": 39.56,
      "end": 41.58,
      "src": "raw/lighthouse/shot_31.mov",
      "src_dur": 2.783,
      "motion": "push_in",
      "transition": "cut",
      "grade": "cool",
      "placeholder": null,
      "override": {},
      "dur": 2.02
    },
    {
      "n": 32,
      "text": "\"Are you lost?\" I whispered.",
      "start": 41.58,
      "end": 43.62,
      "src": "raw/lighthouse/shot_32.mov",
      "src_dur": 2.817,
      "motion": "push_in",
      "transition": "cut",
      "grade": "cool",
      "placeholder": null,
      "override": {},
      "dur": 2.04
    },
    {
      "n": 33,
      "text": "She nodded.",
      "start": 43.62,
      "end": 44.36,
      "src": "raw/lighthouse/shot_33.mov",
      "src_dur": 1.767,
      "motion": "push_in",
      "transition": "cut",
      "grade": "cool",
      "placeholder": null,
      "override": {},
      "dur": 0.74
    },
    {
      "n": 34,
      "text": "\"Me too, a little,\" I said.",
      "start": 44.36,
      "end": 46.1,
      "src": "raw/lighthouse/shot_34.mov",
      "src_dur": 2.8,
      "motion": "push_in",
      "transition": "cut",
      "grade": "cool",
      "placeholder": null,
      "override": {},
      "dur": 1.74
    },
    {
      "n": 35,
      "text": "\"New house.",
      "start": 46.1,
      "end": 46.7,
      "src": "raw/lighthouse/shot_35.mov",
      "src_dur": 2.783,
      "motion": "push_in",
      "transition": "cut",
      "grade": "cool",
      "placeholder": null,
      "override": {},
      "dur": 0.6
    },
    {
      "n": 36,
      "text": "New street. New everything.\"",
      "start": 46.7,
      "end": 48.03,
      "src": "raw/lighthouse/shot_36.mov",
      "src_dur": 2.8,
      "motion": "push_in",
      "transition": "cut",
      "grade": "cool",
      "placeholder": null,
      "override": {},
      "dur": 1.33
    },
    {
      "n": 37,
      "text": "The light stayed all night.",
      "start": 48.03,
      "end": 49.77,
      "src": "raw/lighthouse/shot_37.mov",
      "src_dur": 2.833,
      "motion": "push_in",
      "transition": "cut",
      "grade": "cool",
      "placeholder": null,
      "override": {},
      "dur": 1.74
    },
    {
      "n": 38,
      "text": "So did I.",
      "start": 49.77,
      "end": 50.57,
      "src": "raw/lighthouse/shot_38.mov",
      "src_dur": 1.833,
      "motion": "pull_out",
      "transition": "cut",
      "grade": "warm",
      "placeholder": null,
      "override": {},
      "dur": 0.8
    },
    {
      "n": 39,
      "text": "The next morning, the lighthouse keeper,",
      "start": 50.57,
      "end": 51.93,
      "src": "raw/lighthouse/shot_39.mov",
      "src_dur": 2.817,
      "motion": "push_in",
      "transition": "fog",
      "grade": "warm",
      "placeholder": null,
      "override": {},
      "dur": 1.36
    },
    {
      "n": 40,
      "text": "old Mr. Pell, knocked on our door",
      "start": 51.93,
      "end": 53.17,
      "src": "raw/lighthouse/shot_40.mov",
      "src_dur": 2.8,
      "motion": "push_in",
      "transition": "cut",
      "grade": "warm",
      "placeholder": null,
      "override": {},
      "dur": 1.24
    },
    {
      "n": 41,
      "text": "with a jar of sea glass.",
      "start": 53.17,
      "end": 54.34,
      "src": "raw/lighthouse/shot_41.mov",
      "src_dur": 2.85,
      "motion": "punch",
      "transition": "cut",
      "grade": "warm",
      "placeholder": null,
      "override": {},
      "dur": 1.17
    },
    {
      "n": 42,
      "text": "\"The light doesn't fix lost,\" he said.",
      "start": 54.34,
      "end": 56.46,
      "src": "raw/lighthouse/shot_42.mov",
      "src_dur": 2.833,
      "motion": "push_in",
      "transition": "cut",
      "grade": "warm",
      "placeholder": null,
      "override": {},
      "dur": 2.12
    },
    {
      "n": 43,
      "text": "\"It just shows someone where to sit.\"",
      "start": 56.46,
      "end": 58.1,
      "src": "raw/lighthouse/shot_43.mov",
      "src_dur": 2.8,
      "motion": "push_in",
      "transition": "cut",
      "grade": "warm",
      "placeholder": null,
      "override": {},
      "dur": 1.64
    },
    {
      "n": 44,
      "text": "June took the jar.",
      "start": 58.1,
      "end": 59.02,
      "src": "raw/lighthouse/shot_44.mov",
      "src_dur": 1.8,
      "motion": "push_in",
      "transition": "cut",
      "grade": "warm",
      "placeholder": null,
      "override": {},
      "dur": 0.92
    },
    {
      "n": 45,
      "text": "She held a blue piece up to the sun.",
      "start": 59.02,
      "end": 60.6,
      "src": "raw/lighthouse/shot_45.mov",
      "src_dur": 2.8,
      "motion": "push_in",
      "transition": "sparkle",
      "grade": "warm",
      "placeholder": null,
      "override": {},
      "dur": 1.58
    },
    {
      "n": 46,
      "text": "And for the first time in three weeks,",
      "start": 60.6,
      "end": 62.32,
      "src": "raw/lighthouse/shot_46.mov",
      "src_dur": 2.833,
      "motion": "push_in",
      "transition": "cut",
      "grade": "warm",
      "placeholder": null,
      "override": {},
      "dur": 1.72
    },
    {
      "n": 47,
      "text": "she said one word.",
      "start": 62.32,
      "end": 63.58,
      "src": "raw/lighthouse/shot_47.mov",
      "src_dur": 1.733,
      "motion": "push_in",
      "transition": "cut",
      "grade": "warm",
      "placeholder": null,
      "override": {},
      "dur": 1.26
    },
    {
      "n": 48,
      "text": "\"Home.\"",
      "start": 63.58,
      "end": 65.566,
      "src": "raw/lighthouse/shot_48.mov",
      "src_dur": 2.8,
      "motion": "pull_out",
      "transition": "fog",
      "grade": "warm",
      "placeholder": null,
      "override": {},
      "dur": 1.986
    }
