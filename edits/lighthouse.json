  "duration": 62.828,
  "shots": [
    {
      "n": 1,
      "text": "In this town,",
      "start": 0.0,
      "end": 0.72,
      "src": "raw/lighthouse/shot_01.mov",
      "src_dur": 3.783,
      "motion": "push_in",
      "transition": "cut",
      "grade": "warm",
      "placeholder": null,
      "override": {},
      "dur": 0.72
    },
    {
      "n": 2,
      "text": "the lighthouse shines for anyone who's lost.",
      "start": 0.72,
      "end": 2.92,
      "src": "raw/lighthouse/shot_02.mov",
      "src_dur": 4.767,
      "motion": "push_in",
      "transition": "cut",
      "grade": "warm",
      "placeholder": null,
      "override": {},
      "dur": 2.2
    },
    {
      "n": 3,
      "text": "Not just ships.",
      "start": 2.92,
      "end": 3.66,
      "src": "raw/lighthouse/shot_03.mov",
      "src_dur": 3.733,
      "motion": "pan_right",
      "transition": "cut",
      "grade": "warm",
      "placeholder": null,
      "override": {},
      "dur": 0.74
    },
    {
      "n": 4,
      "text": "People.",
      "start": 3.66,
      "end": 4.18,
      "src": "raw/lighthouse/shot_04.mov",
      "src_dur": 5.55,
      "motion": "punch",
      "transition": "cut",
      "grade": "warm",
      "placeholder": null,
      "override": {},
      "dur": 0.52
    },
    {
      "n": 5,
      "text": "When Tommy Briggs got lost at the summer fair,",
      "start": 4.18,
      "end": 6.1,
      "src": "raw/lighthouse/shot_05.mov",
      "src_dur": 4.583,
      "motion": "pan_left",
      "transition": "cut",
      "grade": "warm",
      "placeholder": null,
      "override": {},
      "dur": 1.92
    },
    {
      "n": 6,
      "text": "the beam found him at the cotton candy stand.",
      "start": 6.1,
      "end": 8.32,
      "src": "raw/lighthouse/shot_06.mov",
      "src_dur": 3.483,
      "motion": "push_in",
      "transition": "cut",
      "grade": "warm",
      "placeholder": null,
      "override": {},
      "dur": 2.22
    },
    {
      "n": 7,
      "text": "When Mrs. Alder lost her glasses,",
      "start": 8.32,
      "end": 10.4,
      "src": "raw/lighthouse/shot_07.mov",
      "src_dur": 3.5,
      "motion": "push_in",
      "transition": "cut",
      "grade": "warm",
      "placeholder": null,
      "override": {},
      "dur": 2.08
    },
    {
      "n": 8,
      "text": "it lit up her own head.",
      "start": 10.4,
      "end": 11.42,
      "src": "raw/lighthouse/shot_08.mov",
      "src_dur": 4.6,
      "motion": "punch",
      "transition": "cut",
      "grade": "warm",
      "placeholder": null,
      "override": {},
      "dur": 1.02
    },
    {
      "n": 9,
      "text": "They were on it.",
      "start": 11.42,
      "end": 12.12,
      "src": "raw/lighthouse/shot_09.mov",
      "src_dur": 3.75,
      "motion": "push_in",
      "transition": "cut",
      "grade": "warm",
      "placeholder": null,
      "override": {
        "src": "raw/lighthouse/shot_08.mov",
        "src_in": 2.6,
        "motion": "punch"
      },
      "dur": 0.7
    },
    {
      "n": 10,
      "text": "And when my dad lost his job,",
      "start": 12.12,
      "end": 13.52,
      "src": "raw/lighthouse/shot_10.mov",
      "src_dur": 3.767,
      "motion": "push_in",
      "transition": "cut",
      "grade": "cool",
      "placeholder": null,
      "override": {},
      "dur": 1.4
    },
    {
      "n": 11,
      "text": "it shone on our porch for a whole week.",
      "start": 13.52,
      "end": 15.5,
      "src": "raw/lighthouse/shot_11.mov",
      "src_dur": 3.767,
      "motion": "push_in",
      "transition": "cut",
      "grade": "cool",
      "placeholder": null,
      "override": {},
      "dur": 1.98
    },
    {
      "n": 12,
      "text": "He pretended not to notice.",
      "start": 15.5,
      "end": 16.94,
      "src": "raw/lighthouse/shot_12.mov",
      "src_dur": 2.65,
      "motion": "push_in",
      "transition": "cut",
      "grade": "cool",
      "placeholder": null,
      "override": {},
      "dur": 1.44
    },
    {
      "n": 13,
      "text": "He noticed.",
      "start": 16.94,
      "end": 17.74,
      "src": "raw/lighthouse/shot_13.mov",
      "src_dur": 3.783,
      "motion": "punch",
      "transition": "cut",
      "grade": "cool",
      "placeholder": null,
      "override": {},
      "dur": 0.8
    },
    {
      "n": 14,
      "text": "Then, we moved.",
      "start": 17.74,
      "end": 18.52,
      "src": "raw/lighthouse/shot_14.mov",
      "src_dur": 2.85,
      "motion": "pan_right",
      "transition": "fog",
      "grade": "neutral",
      "placeholder": null,
      "override": {},
      "dur": 0.78
    },
    {
      "n": 15,
      "text": "Across town, to a little blue house by the docks.",
      "start": 18.52,
      "end": 21.04,
      "src": "raw/lighthouse/shot_15.mov",
      "src_dur": 3.783,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": null,
      "override": {},
      "dur": 2.52
    },
    {
      "n": 16,
      "text": "My sister June was six.",
      "start": 21.04,
      "end": 22.6,
      "src": "raw/lighthouse/shot_16.mov",
      "src_dur": 2.8,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": null,
      "override": {},
      "dur": 1.56
    },
    {
      "n": 17,
      "text": "She stopped talking the day we packed up her room.",
      "start": 22.6,
      "end": 24.5,
      "src": "raw/lighthouse/shot_17.mov",
      "src_dur": 3.817,
      "motion": "pan_left",
      "transition": "cut",
      "grade": "cool",
      "placeholder": null,
      "override": {},
      "dur": 1.9
    },
    {
      "n": 18,
      "text": "Not sad-quiet.",
      "start": 24.5,
      "end": 25.46,
      "src": "raw/lighthouse/shot_18.mov",
      "src_dur": 2.817,
      "motion": "push_in",
      "transition": "cut",
      "grade": "cool",
      "placeholder": null,
      "override": {},
      "dur": 0.96
    },
    {
      "n": 19,
      "text": "Just gone-quiet.",
      "start": 25.46,
      "end": 26.54,
      "src": "raw/lighthouse/shot_19.mov",
      "src_dur": 2.717,
      "motion": "push_in",
      "transition": "cut",
      "grade": "cool",
      "placeholder": null,
      "override": {},
      "dur": 1.08
    },
    {
      "n": 20,
      "text": "Mom tried pancakes.",
      "start": 26.54,
      "end": 27.86,
      "src": "raw/lighthouse/shot_20.mov",
      "src_dur": 2.8,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": null,
      "override": {},
      "dur": 1.32
    },
    {
      "n": 21,
      "text": "Dad tried knock-knock jokes.",
      "start": 27.86,
      "end": 29.3,
      "src": "raw/lighthouse/shot_21.mov",
      "src_dur": 2.833,
      "motion": "pan_right",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": null,
      "override": {},
      "dur": 1.44
    },
    {
      "n": 22,
      "text": "I gave her my bike.",
      "start": 29.3,
      "end": 29.98,
      "src": "raw/lighthouse/shot_22.mov",
      "src_dur": 2.75,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": null,
      "override": {},
      "dur": 0.68
    },
    {
      "n": 23,
      "text": "Nothing.",
      "start": 29.98,
      "end": 30.58,
      "src": "raw/lighthouse/shot_23.mov",
      "src_dur": 1.767,
      "motion": "drift",
      "transition": "cut",
      "grade": "cool",
      "placeholder": null,
      "override": {},
      "dur": 0.6
    },
    {
      "n": 24,
      "text": "The first foggy night, I couldn't sleep.",
      "start": 30.58,
      "end": 32.44,
      "src": "raw/lighthouse/shot_24.mov",
      "src_dur": 2.817,
      "motion": "push_in",
      "transition": "fog",
      "grade": "cool",
      "placeholder": null,
      "override": {},
      "dur": 1.86
    },
    {
      "n": 25,
      "text": "I looked out my window,",
      "start": 32.44,
      "end": 33.2,
      "src": "raw/lighthouse/shot_25.mov",
      "src_dur": 2.817,
      "motion": "push_in",
      "transition": "cut",
      "grade": "cool",
      "placeholder": null,
      "override": {},
      "dur": 0.76
    },
    {
      "n": 26,
      "text": "and the beam was sweeping the whole town.",
      "start": 33.2,
      "end": 34.84,
      "src": "raw/lighthouse/shot_26.mov",
      "src_dur": 2.783,
      "motion": "pan_left",
      "transition": "cut",
      "grade": "cool",
      "placeholder": null,
      "override": {},
      "dur": 1.64
    },
    {
      "n": 27,
      "text": "Then it stopped.",
      "start": 34.84,
      "end": 35.52,
      "src": "raw/lighthouse/shot_27.mov",
      "src_dur": 1.833,
      "motion": "drift",
      "transition": "cut",
      "grade": "cool",
      "placeholder": null,
      "override": {},
      "dur": 0.68
    },
    {
      "n": 28,
      "text": "Right on our house.",
      "start": 35.52,
      "end": 36.28,
      "src": "raw/lighthouse/shot_28.mov",
      "src_dur": 2.75,
      "motion": "punch",
      "transition": "sparkle",
      "grade": "cool",
      "placeholder": null,
      "override": {},
      "dur": 0.76
    },
    {
      "n": 29,
      "text": "On June's window.",
      "start": 36.28,
      "end": 37.28,
      "src": "raw/lighthouse/shot_29.mov",
      "src_dur": 2.817,
      "motion": "push_in",
      "transition": "cut",
      "grade": "cool",
      "placeholder": null,
      "override": {},
      "dur": 1.0
    },
    {
      "n": 30,
      "text": "I tiptoed into her room.",
      "start": 37.28,
      "end": 38.36,
      "src": "raw/lighthouse/shot_30.mov",
      "src_dur": 2.833,
      "motion": "pan_right",
      "transition": "cut",
      "grade": "cool",
      "placeholder": null,
      "override": {},
      "dur": 1.08
    },
    {
      "n": 31,
      "text": "She was sitting up, staring at the light.",
      "start": 38.36,
      "end": 40.26,
      "src": "raw/lighthouse/shot_31.mov",
      "src_dur": 2.783,
      "motion": "push_in",
      "transition": "cut",
      "grade": "cool",
      "placeholder": null,
      "override": {},
      "dur": 1.9
    },
    {
      "n": 32,
      "text": "\"Are you lost?\" I whispered.",
      "start": 40.26,
      "end": 41.96,
      "src": "raw/lighthouse/shot_32.mov",
      "src_dur": 2.817,
      "motion": "push_in",
      "transition": "cut",
      "grade": "cool",
      "placeholder": null,
      "override": {},
      "dur": 1.7
    },
    {
      "n": 33,
      "text": "She nodded.",
      "start": 41.96,
      "end": 42.26,
      "src": "raw/lighthouse/shot_33.mov",
      "src_dur": 1.767,
      "motion": "push_in",
      "transition": "cut",
      "grade": "cool",
      "placeholder": null,
      "override": {},
      "dur": 0.3
    },
    {
      "n": 34,
      "text": "\"Me too, a little,\" I said.",
      "start": 42.26,
      "end": 43.8,
      "src": "raw/lighthouse/shot_34.mov",
      "src_dur": 2.8,
      "motion": "push_in",
      "transition": "cut",
      "grade": "cool",
      "placeholder": null,
      "override": {},
      "dur": 1.54
    },
    {
      "n": 35,
      "text": "\"New house.",
      "start": 43.8,
      "end": 44.3,
      "src": "raw/lighthouse/shot_35.mov",
      "src_dur": 2.783,
      "motion": "push_in",
      "transition": "cut",
      "grade": "cool",
      "placeholder": null,
      "override": {},
      "dur": 0.5
    },
    {
      "n": 36,
      "text": "New street. New everything.\"",
      "start": 44.3,
      "end": 45.7,
      "src": "raw/lighthouse/shot_36.mov",
      "src_dur": 2.8,
      "motion": "push_in",
      "transition": "cut",
      "grade": "cool",
      "placeholder": null,
      "override": {},
      "dur": 1.4
    },
    {
      "n": 37,
      "text": "The light stayed all night.",
      "start": 45.7,
      "end": 46.76,
      "src": "raw/lighthouse/shot_37.mov",
      "src_dur": 2.833,
      "motion": "push_in",
      "transition": "cut",
      "grade": "cool",
      "placeholder": null,
      "override": {},
      "dur": 1.06
    },
    {
      "n": 38,
      "text": "So did I.",
      "start": 46.76,
      "end": 47.56,
      "src": "raw/lighthouse/shot_38.mov",
      "src_dur": 1.833,
      "motion": "pull_out",
      "transition": "cut",
      "grade": "warm",
      "placeholder": null,
      "override": {},
      "dur": 0.8
    },
    {
      "n": 39,
      "text": "The next morning, the lighthouse keeper,",
      "start": 47.56,
      "end": 49.12,
      "src": "raw/lighthouse/shot_39.mov",
      "src_dur": 2.817,
      "motion": "push_in",
      "transition": "fog",
      "grade": "warm",
      "placeholder": null,
      "override": {},
      "dur": 1.56
    },
    {
      "n": 40,
      "text": "old Mr. Pell, knocked on our door",
      "start": 49.12,
      "end": 50.56,
      "src": "raw/lighthouse/shot_40.mov",
      "src_dur": 2.8,
      "motion": "push_in",
      "transition": "cut",
      "grade": "warm",
      "placeholder": null,
      "override": {},
      "dur": 1.44
    },
    {
      "n": 41,
      "text": "with a jar of sea glass.",
      "start": 50.56,
      "end": 52.18,
      "src": "raw/lighthouse/shot_41.mov",
      "src_dur": 2.85,
      "motion": "punch",
      "transition": "cut",
      "grade": "warm",
      "placeholder": null,
      "override": {},
      "dur": 1.62
    },
    {
      "n": 42,
      "text": "\"The light doesn't fix lost,\" he said.",
      "start": 52.18,
      "end": 54.08,
      "src": "raw/lighthouse/shot_42.mov",
      "src_dur": 2.833,
      "motion": "push_in",
      "transition": "cut",
      "grade": "warm",
      "placeholder": null,
      "override": {},
      "dur": 1.9
    },
    {
      "n": 43,
      "text": "\"It just shows someone where to sit.\"",
      "start": 54.08,
      "end": 55.78,
      "src": "raw/lighthouse/shot_43.mov",
      "src_dur": 2.8,
      "motion": "push_in",
      "transition": "cut",
      "grade": "warm",
      "placeholder": null,
      "override": {},
      "dur": 1.7
    },
    {
      "n": 44,
      "text": "June took the jar.",
      "start": 55.78,
      "end": 56.78,
      "src": "raw/lighthouse/shot_44.mov",
      "src_dur": 1.8,
      "motion": "push_in",
      "transition": "cut",
      "grade": "warm",
      "placeholder": null,
      "override": {},
      "dur": 1.0
    },
    {
      "n": 45,
      "text": "She held a blue piece up to the sun.",
      "start": 56.78,
      "end": 58.28,
      "src": "raw/lighthouse/shot_45.mov",
      "src_dur": 2.8,
      "motion": "push_in",
      "transition": "sparkle",
      "grade": "warm",
      "placeholder": null,
      "override": {},
      "dur": 1.5
    },
    {
      "n": 46,
      "text": "And for the first time in three weeks,",
      "start": 58.28,
      "end": 59.62,
      "src": "raw/lighthouse/shot_46.mov",
      "src_dur": 2.833,
      "motion": "push_in",
      "transition": "cut",
      "grade": "warm",
      "placeholder": null,
      "override": {},
      "dur": 1.34
    },
    {
      "n": 47,
      "text": "she said one word.",
      "start": 59.62,
      "end": 60.92,
      "src": "raw/lighthouse/shot_47.mov",
      "src_dur": 1.733,
      "motion": "push_in",
      "transition": "cut",
      "grade": "warm",
      "placeholder": null,
      "override": {},
      "dur": 1.3
    },
    {
      "n": 48,
      "text": "\"Home.\"",
      "start": 60.92,
      "end": 62.828,
      "src": "raw/lighthouse/shot_48.mov",
      "src_dur": 2.8,
      "motion": "pull_out",
      "transition": "fog",
      "grade": "warm",
      "placeholder": null,
      "override": {},
      "dur": 1.908
    }
