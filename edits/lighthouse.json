{
  "slug": "lighthouse",
  "title": "The Lighthouse for Lost People",
  "timing": "voice",
  "voice": "output/cache/lighthouse/voice_fx.wav",
  "duration": 56.613,
  "shots": [
    {
      "n": 1,
      "text": "In this town,",
      "start": 0.0,
      "end": 0.77,
      "src": "raw/lighthouse/shot_01.mov",
      "src_dur": 3.783,
      "motion": "push_in",
      "transition": "cut",
      "grade": "warm",
      "placeholder": null,
      "override": {},
      "dur": 0.77
    },
    {
      "n": 2,
      "text": "the lighthouse shines for anyone who's lost.",
      "start": 0.77,
      "end": 2.299,
      "src": "raw/lighthouse/shot_02.mov",
      "src_dur": 4.767,
      "motion": "push_in",
      "transition": "cut",
      "grade": "warm",
      "placeholder": null,
      "override": {},
      "dur": 1.529
    },
    {
      "n": 3,
      "text": "Not just ships.",
      "start": 2.299,
      "end": 3.07,
      "src": "raw/lighthouse/shot_03.mov",
      "src_dur": 3.733,
      "motion": "pan_right",
      "transition": "cut",
      "grade": "warm",
      "placeholder": null,
      "override": {},
      "dur": 0.771
    },
    {
      "n": 4,
      "text": "People.",
      "start": 3.07,
      "end": 3.656,
      "src": "raw/lighthouse/shot_04.mov",
      "src_dur": 5.55,
      "motion": "punch",
      "transition": "cut",
      "grade": "warm",
      "placeholder": null,
      "override": {},
      "dur": 0.586
    },
    {
      "n": 5,
      "text": "When Tommy Briggs got lost at the summer fair,",
      "start": 3.656,
      "end": 5.676,
      "src": "raw/lighthouse/shot_05.mov",
      "src_dur": 4.583,
      "motion": "pan_left",
      "transition": "cut",
      "grade": "warm",
      "placeholder": null,
      "override": {},
      "dur": 2.02
    },
    {
      "n": 6,
      "text": "the beam found him at the cotton candy stand.",
      "start": 5.676,
      "end": 7.328,
      "src": "raw/lighthouse/shot_06.mov",
      "src_dur": 3.483,
      "motion": "push_in",
      "transition": "cut",
      "grade": "warm",
      "placeholder": null,
      "override": {},
      "dur": 1.652
    },
    {
      "n": 7,
      "text": "When Mrs. Alder lost her glasses,",
      "start": 7.328,
      "end": 8.948,
      "src": "raw/lighthouse/shot_07.mov",
      "src_dur": 3.5,
      "motion": "push_in",
      "transition": "cut",
      "grade": "warm",
      "placeholder": null,
      "override": {},
      "dur": 1.62
    },
    {
      "n": 8,
      "text": "it lit up her own head.",
      "start": 8.948,
      "end": 9.71,
      "src": "raw/lighthouse/shot_08.mov",
      "src_dur": 4.6,
      "motion": "punch",
      "transition": "cut",
      "grade": "warm",
      "placeholder": null,
      "override": {},
      "dur": 0.762
    },
    {
      "n": 9,
      "text": "They were on it.",
      "start": 9.71,
      "end": 10.484,
      "src": "raw/lighthouse/shot_09.mov",
      "src_dur": 3.75,
      "motion": "push_in",
      "transition": "cut",
      "grade": "warm",
      "placeholder": null,
      "override": {
        "src": "raw/lighthouse/shot_08.mov",
        "src_in": 2.6,
        "motion": "punch"
      },
      "dur": 0.774
    },
    {
      "n": 10,
      "text": "And when my dad lost his job,",
      "start": 10.484,
      "end": 11.984,
      "src": "raw/lighthouse/shot_10.mov",
      "src_dur": 3.767,
      "motion": "push_in",
      "transition": "cut",
      "grade": "cool",
      "placeholder": null,
      "override": {},
      "dur": 1.5
    },
    {
      "n": 11,
      "text": "it shone on our porch for a whole week.",
      "start": 11.984,
      "end": 13.353,
      "src": "raw/lighthouse/shot_11.mov",
      "src_dur": 3.767,
      "motion": "push_in",
      "transition": "cut",
      "grade": "cool",
      "placeholder": null,
      "override": {},
      "dur": 1.369
    },
    {
      "n": 12,
      "text": "He pretended not to notice.",
      "start": 13.353,
      "end": 14.659,
      "src": "raw/lighthouse/shot_12.mov",
      "src_dur": 2.65,
      "motion": "push_in",
      "transition": "cut",
      "grade": "cool",
      "placeholder": null,
      "override": {},
      "dur": 1.306
    },
    {
      "n": 13,
      "text": "He noticed.",
      "start": 14.659,
      "end": 15.41,
      "src": "raw/lighthouse/shot_13.mov",
      "src_dur": 3.783,
      "motion": "punch",
      "transition": "cut",
      "grade": "cool",
      "placeholder": null,
      "override": {},
      "dur": 0.751
    },
    {
      "n": 14,
      "text": "Then, we moved.",
      "start": 15.41,
      "end": 16.208,
      "src": "raw/lighthouse/shot_14.mov",
      "src_dur": 2.85,
      "motion": "pan_right",
      "transition": "fog",
      "grade": "neutral",
      "placeholder": null,
      "override": {},
      "dur": 0.798
    },
    {
      "n": 15,
      "text": "Across town, to a little blue house by the docks.",
      "start": 16.208,
      "end": 18.068,
      "src": "raw/lighthouse/shot_15.mov",
      "src_dur": 3.783,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": null,
      "override": {},
      "dur": 1.86
    },
    {
      "n": 16,
      "text": "My sister June was six.",
      "start": 18.068,
      "end": 19.276,
      "src": "raw/lighthouse/shot_16.mov",
      "src_dur": 2.8,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": null,
      "override": {},
      "dur": 1.208
    },
    {
      "n": 17,
      "text": "She stopped talking the day we packed up her room.",
      "start": 19.276,
      "end": 21.004,
      "src": "raw/lighthouse/shot_17.mov",
      "src_dur": 3.817,
      "motion": "pan_left",
      "transition": "cut",
      "grade": "cool",
      "placeholder": null,
      "override": {},
      "dur": 1.728
    },
    {
      "n": 18,
      "text": "Not sad-quiet.",
      "start": 21.004,
      "end": 21.891,
      "src": "raw/lighthouse/shot_18.mov",
      "src_dur": 2.817,
      "motion": "push_in",
      "transition": "cut",
      "grade": "cool",
      "placeholder": null,
      "override": {},
      "dur": 0.887
    },
    {
      "n": 19,
      "text": "Just gone-quiet.",
      "start": 21.891,
      "end": 22.795,
      "src": "raw/lighthouse/shot_19.mov",
      "src_dur": 2.717,
      "motion": "push_in",
      "transition": "cut",
      "grade": "cool",
      "placeholder": null,
      "override": {},
      "dur": 0.904
    },
    {
      "n": 20,
      "text": "Mom tried pancakes.",
      "start": 22.795,
      "end": 23.908,
      "src": "raw/lighthouse/shot_20.mov",
      "src_dur": 2.8,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": null,
      "override": {},
      "dur": 1.113
    },
    {
      "n": 21,
      "text": "Dad tried knock-knock jokes.",
      "start": 23.908,
      "end": 25.248,
      "src": "raw/lighthouse/shot_21.mov",
      "src_dur": 2.833,
      "motion": "pan_right",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": null,
      "override": {},
      "dur": 1.34
    },
    {
      "n": 22,
      "text": "I gave her my bike.",
      "start": 25.248,
      "end": 26.226,
      "src": "raw/lighthouse/shot_22.mov",
      "src_dur": 2.75,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": null,
      "override": {},
      "dur": 0.978
    },
    {
      "n": 23,
      "text": "Nothing.",
      "start": 26.226,
      "end": 26.887,
      "src": "raw/lighthouse/shot_23.mov",
      "src_dur": 1.767,
      "motion": "drift",
      "transition": "cut",
      "grade": "cool",
      "placeholder": null,
      "override": {},
      "dur": 0.661
    },
    {
      "n": 24,
      "text": "The first foggy night, I couldn't sleep.",
      "start": 26.887,
      "end": 28.37,
      "src": "raw/lighthouse/shot_24.mov",
      "src_dur": 2.817,
      "motion": "push_in",
      "transition": "fog",
      "grade": "cool",
      "placeholder": null,
      "override": {},
      "dur": 1.483
    },
    {
      "n": 25,
      "text": "I looked out my window,",
      "start": 28.37,
      "end": 29.45,
      "src": "raw/lighthouse/shot_25.mov",
      "src_dur": 2.817,
      "motion": "push_in",
      "transition": "cut",
      "grade": "cool",
      "placeholder": null,
      "override": {},
      "dur": 1.08
    },
    {
      "n": 26,
      "text": "and the beam was sweeping the whole town.",
      "start": 29.45,
      "end": 30.777,
      "src": "raw/lighthouse/shot_26.mov",
      "src_dur": 2.783,
      "motion": "pan_left",
      "transition": "cut",
      "grade": "cool",
      "placeholder": null,
      "override": {},
      "dur": 1.327
    },
    {
      "n": 27,
      "text": "Then it stopped.",
      "start": 30.777,
      "end": 31.569,
      "src": "raw/lighthouse/shot_27.mov",
      "src_dur": 1.833,
      "motion": "drift",
      "transition": "cut",
      "grade": "cool",
      "placeholder": null,
      "override": {},
      "dur": 0.792
    },
    {
      "n": 28,
      "text": "Right on our house.",
      "start": 31.569,
      "end": 32.421,
      "src": "raw/lighthouse/shot_28.mov",
      "src_dur": 2.75,
      "motion": "punch",
      "transition": "sparkle",
      "grade": "cool",
      "placeholder": null,
      "override": {},
      "dur": 0.852
    },
    {
      "n": 29,
      "text": "On June's window.",
      "start": 32.421,
      "end": 33.506,
      "src": "raw/lighthouse/shot_29.mov",
      "src_dur": 2.817,
      "motion": "push_in",
      "transition": "cut",
      "grade": "cool",
      "placeholder": null,
      "override": {},
      "dur": 1.085
    },
    {
      "n": 30,
      "text": "I tiptoed into her room.",
      "start": 33.506,
      "end": 34.67,
      "src": "raw/lighthouse/shot_30.mov",
      "src_dur": 2.833,
      "motion": "pan_right",
      "transition": "cut",
      "grade": "cool",
      "placeholder": null,
      "override": {},
      "dur": 1.164
    },
    {
      "n": 31,
      "text": "She was sitting up, staring at the light.",
      "start": 34.67,
      "end": 36.036,
      "src": "raw/lighthouse/shot_31.mov",
      "src_dur": 2.783,
      "motion": "push_in",
      "transition": "cut",
      "grade": "cool",
      "placeholder": null,
      "override": {},
      "dur": 1.366
    },
    {
      "n": 32,
      "text": "\"Are you lost?\" I whispered.",
      "start": 36.036,
      "end": 37.5,
      "src": "raw/lighthouse/shot_32.mov",
      "src_dur": 2.817,
      "motion": "push_in",
      "transition": "cut",
      "grade": "cool",
      "placeholder": null,
      "override": {},
      "dur": 1.464
    },
    {
      "n": 33,
      "text": "She nodded.",
      "start": 37.5,
      "end": 38.146,
      "src": "raw/lighthouse/shot_33.mov",
      "src_dur": 1.767,
      "motion": "push_in",
      "transition": "cut",
      "grade": "cool",
      "placeholder": null,
      "override": {},
      "dur": 0.646
    },
    {
      "n": 34,
      "text": "\"Me too, a little,\" I said.",
      "start": 38.146,
      "end": 39.234,
      "src": "raw/lighthouse/shot_34.mov",
      "src_dur": 2.8,
      "motion": "push_in",
      "transition": "cut",
      "grade": "cool",
      "placeholder": null,
      "override": {},
      "dur": 1.088
    },
    {
      "n": 35,
      "text": "\"New house.",
      "start": 39.234,
      "end": 39.9,
      "src": "raw/lighthouse/shot_35.mov",
      "src_dur": 2.783,
      "motion": "push_in",
      "transition": "cut",
      "grade": "cool",
      "placeholder": null,
      "override": {},
      "dur": 0.666
    },
    {
      "n": 36,
      "text": "New street. New everything.\"",
      "start": 39.9,
      "end": 41.338,
      "src": "raw/lighthouse/shot_36.mov",
      "src_dur": 2.8,
      "motion": "push_in",
      "transition": "cut",
      "grade": "cool",
      "placeholder": null,
      "override": {},
      "dur": 1.438
    },
    {
      "n": 37,
      "text": "The light stayed all night.",
      "start": 41.338,
      "end": 42.446,
      "src": "raw/lighthouse/shot_37.mov",
      "src_dur": 2.833,
      "motion": "push_in",
      "transition": "cut",
      "grade": "cool",
      "placeholder": null,
      "override": {},
      "dur": 1.108
    },
    {
      "n": 38,
      "text": "So did I.",
      "start": 42.446,
      "end": 43.312,
      "src": "raw/lighthouse/shot_38.mov",
      "src_dur": 1.833,
      "motion": "pull_out",
      "transition": "cut",
      "grade": "warm",
      "placeholder": null,
      "override": {},
      "dur": 0.866
    },
    {
      "n": 39,
      "text": "The next morning, the lighthouse keeper,",
      "start": 43.312,
      "end": 44.652,
      "src": "raw/lighthouse/shot_39.mov",
      "src_dur": 2.817,
      "motion": "push_in",
      "transition": "fog",
      "grade": "warm",
      "placeholder": null,
      "override": {},
      "dur": 1.34
    },
    {
      "n": 40,
      "text": "old Mr. Pell, knocked on our door",
      "start": 44.652,
      "end": 46.172,
      "src": "raw/lighthouse/shot_40.mov",
      "src_dur": 2.8,
      "motion": "push_in",
      "transition": "cut",
      "grade": "warm",
      "placeholder": null,
      "override": {},
      "dur": 1.52
    },
    {
      "n": 41,
      "text": "with a jar of sea glass.",
      "start": 46.172,
      "end": 47.216,
      "src": "raw/lighthouse/shot_41.mov",
      "src_dur": 2.85,
      "motion": "punch",
      "transition": "cut",
      "grade": "warm",
      "placeholder": null,
      "override": {},
      "dur": 1.044
    },
    {
      "n": 42,
      "text": "\"The light doesn't fix lost,\" he said.",
      "start": 47.216,
      "end": 48.833,
      "src": "raw/lighthouse/shot_42.mov",
      "src_dur": 2.833,
      "motion": "push_in",
      "transition": "cut",
      "grade": "warm",
      "placeholder": null,
      "override": {},
      "dur": 1.617
    },
    {
      "n": 43,
      "text": "\"It just shows someone where to sit.\"",
      "start": 48.833,
      "end": 50.183,
      "src": "raw/lighthouse/shot_43.mov",
      "src_dur": 2.8,
      "motion": "push_in",
      "transition": "cut",
      "grade": "warm",
      "placeholder": null,
      "override": {},
      "dur": 1.35
    },
    {
      "n": 44,
      "text": "June took the jar.",
      "start": 50.183,
      "end": 51.163,
      "src": "raw/lighthouse/shot_44.mov",
      "src_dur": 1.8,
      "motion": "push_in",
      "transition": "cut",
      "grade": "warm",
      "placeholder": null,
      "override": {},
      "dur": 0.98
    },
    {
      "n": 45,
      "text": "She held a blue piece up to the sun.",
      "start": 51.163,
      "end": 52.58,
      "src": "raw/lighthouse/shot_45.mov",
      "src_dur": 2.8,
      "motion": "push_in",
      "transition": "sparkle",
      "grade": "warm",
      "placeholder": null,
      "override": {},
      "dur": 1.417
    },
    {
      "n": 46,
      "text": "And for the first time in three weeks,",
      "start": 52.58,
      "end": 54.0,
      "src": "raw/lighthouse/shot_46.mov",
      "src_dur": 2.833,
      "motion": "push_in",
      "transition": "cut",
      "grade": "warm",
      "placeholder": null,
      "override": {},
      "dur": 1.42
    },
    {
      "n": 47,
      "text": "she said one word.",
      "start": 54.0,
      "end": 54.681,
      "src": "raw/lighthouse/shot_47.mov",
      "src_dur": 1.733,
      "motion": "push_in",
      "transition": "cut",
      "grade": "warm",
      "placeholder": null,
      "override": {},
      "dur": 0.681
    },
    {
      "n": 48,
      "text": "\"Home.\"",
      "start": 54.681,
      "end": 56.613,
      "src": "raw/lighthouse/shot_48.mov",
      "src_dur": 2.8,
      "motion": "pull_out",
      "transition": "fog",
      "grade": "warm",
      "placeholder": null,
      "override": {},
      "dur": 1.932
    }
