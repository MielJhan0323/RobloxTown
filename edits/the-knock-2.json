{
  "slug": "the-knock-2",
  "title": "The Knock (Part 2)",
  "timing": "estimated",
  "voice": null,
  "duration": 87.634,
  "shots": [
    {
      "n": 1,
      "text": "You told me not to open either door.",
      "start": 0.0,
      "end": 3.157,
      "src": null,
      "src_dur": null,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": "1.8",
      "override": {},
      "dur": 3.157
    },
    {
      "n": 2,
      "text": "So I didn't.",
      "start": 3.157,
      "end": 4.341,
      "src": null,
      "src_dur": null,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": "1.8",
      "override": {},
      "dur": 1.184
    },
    {
      "n": 3,
      "text": "I crawled to the kitchen and plugged in my phone.",
      "start": 4.341,
      "end": 7.969,
      "src": null,
      "src_dur": null,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": "1.8",
      "override": {},
      "dur": 3.628
    },
    {
      "n": 4,
      "text": "Three percent. Four.",
      "start": 7.969,
      "end": 9.609,
      "src": null,
      "src_dur": null,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": "1.8",
      "override": {},
      "dur": 1.64
    },
    {
      "n": 5,
      "text": "The knocking got louder. Both doors at once.",
      "start": 9.609,
      "end": 12.924,
      "src": null,
      "src_dur": null,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": "1.8",
      "override": {},
      "dur": 3.315
    },
    {
      "n": 6,
      "text": "Five percent. I called Mom.",
      "start": 12.924,
      "end": 15.157,
      "src": null,
      "src_dur": null,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": "1.8",
      "override": {},
      "dur": 2.233
    },
    {
      "n": 7,
      "text": "It rang. And rang.",
      "start": 15.157,
      "end": 16.931,
      "src": null,
      "src_dur": null,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": "1.8",
      "override": {},
      "dur": 1.774
    },
    {
      "n": 8,
      "text": "\"Bug? Honey, the lights went out at the restaurant.\"",
      "start": 16.931,
      "end": 20.437,
      "src": null,
      "src_dur": null,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": "1.8",
      "override": {},
      "dur": 3.506
    },
    {
      "n": 9,
      "text": "\"Dad and I are stuck here till morning. Are you inside? Is the door locked?\"",
      "start": 20.437,
      "end": 25.959,
      "src": null,
      "src_dur": null,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": "1.8",
      "override": {},
      "dur": 5.522
    },
    {
      "n": 10,
      "text": "I looked at the front door.",
      "start": 25.959,
      "end": 28.165,
      "src": null,
      "src_dur": null,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": "1.8",
      "override": {},
      "dur": 2.206
    },
    {
      "n": 11,
      "text": "Then the back door.",
      "start": 28.165,
      "end": 29.748,
      "src": null,
      "src_dur": null,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": "1.8",
      "override": {},
      "dur": 1.583
    },
    {
      "n": 12,
      "text": "If Mom and Dad were at the restaurant...",
      "start": 29.748,
      "end": 32.665,
      "src": null,
      "src_dur": null,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": "1.8",
      "override": {},
      "dur": 2.917
    },
    {
      "n": 13,
      "text": "then who was outside?",
      "start": 32.665,
      "end": 34.307,
      "src": null,
      "src_dur": null,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": "1.8",
      "override": {},
      "dur": 1.642
    },
    {
      "n": 14,
      "text": "Both doors went silent.",
      "start": 34.307,
      "end": 36.009,
      "src": null,
      "src_dur": null,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": "1.8",
      "override": {},
      "dur": 1.702
    },
    {
      "n": 15,
      "text": "Then something knocked on the kitchen window.",
      "start": 36.009,
      "end": 38.941,
      "src": null,
      "src_dur": null,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": "1.8",
      "override": {},
      "dur": 2.932
    },
    {
      "n": 16,
      "text": "Right next to me.",
      "start": 38.941,
      "end": 40.465,
      "src": null,
      "src_dur": null,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": "1.8",
      "override": {},
      "dur": 1.524
    },
    {
      "n": 17,
      "text": "\"Bug,\" it said, in Mom's voice. \"Who are you talking to?\"",
      "start": 40.465,
      "end": 44.415,
      "src": null,
      "src_dur": null,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": "1.8",
      "override": {},
      "dur": 3.95
    },
    {
      "n": 18,
      "text": "I didn't answer. I didn't breathe.",
      "start": 44.415,
      "end": 47.048,
      "src": null,
      "src_dur": null,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": "1.8",
      "override": {},
      "dur": 2.633
    },
    {
      "n": 19,
      "text": "I held the phone against my chest.",
      "start": 47.048,
      "end": 49.654,
      "src": null,
      "src_dur": null,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": "1.8",
      "override": {},
      "dur": 2.606
    },
    {
      "n": 20,
      "text": "Mom stayed on the line all night.",
      "start": 49.654,
      "end": 52.23,
      "src": null,
      "src_dur": null,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": "1.8",
      "override": {},
      "dur": 2.576
    },
    {
      "n": 21,
      "text": "She told me stories. She hummed.",
      "start": 52.23,
      "end": 54.804,
      "src": null,
      "src_dur": null,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": "1.8",
      "override": {},
      "dur": 2.574
    },
    {
      "n": 22,
      "text": "Every time something knocked, she said, \"Don't answer, bug. I'm right here.\"",
      "start": 54.804,
      "end": 59.739,
      "src": null,
      "src_dur": null,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": "1.8",
      "override": {},
      "dur": 4.935
    },
    {
      "n": 23,
      "text": "At six a.m., the streetlights flickered back on.",
      "start": 59.739,
      "end": 62.963,
      "src": null,
      "src_dur": null,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": "1.8",
      "override": {},
      "dur": 3.224
    },
    {
      "n": 24,
      "text": "The knocking stopped.",
      "start": 62.963,
      "end": 64.413,
      "src": null,
      "src_dur": null,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": "1.8",
      "override": {},
      "dur": 1.45
    },
    {
      "n": 25,
      "text": "At seven, Mom and Dad pulled into the driveway.",
      "start": 64.413,
      "end": 67.859,
      "src": null,
      "src_dur": null,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": "1.8",
      "override": {},
      "dur": 3.446
    },
    {
      "n": 26,
      "text": "Before I opened the door, I made Mom say one thing a Knocker couldn't have heard today.",
      "start": 67.859,
      "end": 74.031,
      "src": null,
      "src_dur": null,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": "1.8",
      "override": {},
      "dur": 6.172
    },
    {
      "n": 27,
      "text": "She smiled. \"I love you more than the whole sky.\"",
      "start": 74.031,
      "end": 77.57,
      "src": null,
      "src_dur": null,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": "1.8",
      "override": {},
      "dur": 3.539
    },
    {
      "n": 28,
      "text": "She says it every morning. Never at night.",
      "start": 77.57,
      "end": 80.826,
      "src": null,
      "src_dur": null,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": "1.8",
      "override": {},
      "dur": 3.256
    },
    {
      "n": 29,
      "text": "I opened the door.",
      "start": 80.826,
      "end": 82.38,
      "src": null,
      "src_dur": null,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": "1.8",
      "override": {},
      "dur": 1.554
    },
    {
      "n": 30,
      "text": "But the kitchen window still has handprints.",
      "start": 82.38,
      "end": 85.281,
      "src": null,
      "src_dur": null,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": "1.8",
      "override": {},
      "dur": 2.901
    },
    {
      "n": 31,
      "text": "On the inside.",
      "start": 85.281,
      "end": 87.634,
      "src": null,
      "src_dur": null,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": "1.8",
      "override": {},
      "dur": 2.353
    }
  ],
