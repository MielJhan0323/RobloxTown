{
  "slug": "the-knock-2",
  "title": "The Knock (Part 2 of 4)",
  "timing": "estimated",
  "voice": null,
  "duration": 80.152,
  "shots": [
    {
      "n": 1,
      "text": "You told me not to open either door.",
      "start": 0.0,
      "end": 3.157,
      "src": "output/anim/the-knock-2/shot_01.mp4",
      "src_dur": 4.4,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": null,
      "override": {},
      "dur": 3.157
    },
    {
      "n": 2,
      "text": "So I didn't.",
      "start": 3.157,
      "end": 4.341,
      "src": "output/anim/the-knock-2/shot_02.mp4",
      "src_dur": 2.067,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": null,
      "override": {},
      "dur": 1.184
    },
    {
      "n": 3,
      "text": "I crawled to the kitchen and plugged in my phone.",
      "start": 4.341,
      "end": 7.969,
      "src": "output/anim/the-knock-2/shot_03.mp4",
      "src_dur": 5.0,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": null,
      "override": {},
      "dur": 3.628
    },
    {
      "n": 4,
      "text": "Three percent. Four.",
      "start": 7.969,
      "end": 9.609,
      "src": "output/anim/the-knock-2/shot_04.mp4",
      "src_dur": 2.6,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": null,
      "override": {},
      "dur": 1.64
    },
    {
      "n": 5,
      "text": "The knocking got louder. Both doors at once.",
      "start": 9.609,
      "end": 12.924,
      "src": "output/anim/the-knock-2/shot_05.mp4",
      "src_dur": 4.6,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": null,
      "override": {},
      "dur": 3.315
    },
    {
      "n": 6,
      "text": "Five percent. I called Mom.",
      "start": 12.924,
      "end": 15.157,
      "src": "output/anim/the-knock-2/shot_06.mp4",
      "src_dur": 3.333,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": null,
      "override": {},
      "dur": 2.233
    },
    {
      "n": 7,
      "text": "It rang. And rang.",
      "start": 15.157,
      "end": 16.931,
      "src": "output/anim/the-knock-2/shot_07.mp4",
      "src_dur": 2.733,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": null,
      "override": {},
      "dur": 1.774
    },
    {
      "n": 8,
      "text": "\"Bug? Honey, the lights went out at the restaurant.",
      "start": 16.931,
      "end": 20.687,
      "src": "output/anim/the-knock-2/shot_08.mp4",
      "src_dur": 4.867,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": null,
      "override": {},
      "dur": 3.756
    },
    {
      "n": 9,
      "text": "Dad and I are stuck here till morning. Are you inside? Is the door locked?\"",
      "start": 20.687,
      "end": 26.209,
      "src": null,
      "src_dur": null,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": "1.8",
      "override": {},
      "dur": 5.522
    },
    {
      "n": 10,
      "text": "I looked at the front door.",
      "start": 26.209,
      "end": 28.415,
      "src": "output/anim/the-knock-2/shot_10.mp4",
      "src_dur": 3.267,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": null,
      "override": {},
      "dur": 2.206
    },
    {
      "n": 11,
      "text": "Then the back door.",
      "start": 28.415,
      "end": 29.998,
      "src": "output/anim/the-knock-2/shot_11.mp4",
      "src_dur": 2.533,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": null,
      "override": {},
      "dur": 1.583
    },
    {
      "n": 12,
      "text": "If Mom and Dad were at the restaurant...",
      "start": 29.998,
      "end": 32.915,
      "src": null,
      "src_dur": null,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": "1.8",
      "override": {},
      "dur": 2.917
    },
    {
      "n": 13,
      "text": "then who was outside?",
      "start": 32.915,
      "end": 34.557,
      "src": null,
      "src_dur": null,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": "1.8",
      "override": {},
      "dur": 1.642
    },
    {
      "n": 14,
      "text": "Both doors went silent.",
      "start": 34.557,
      "end": 36.259,
      "src": null,
      "src_dur": null,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": "1.8",
      "override": {},
      "dur": 1.702
    },
    {
      "n": 15,
      "text": "Then something knocked on the kitchen window.",
      "start": 36.259,
      "end": 39.191,
      "src": null,
      "src_dur": null,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": "1.8",
      "override": {},
      "dur": 2.932
    },
    {
      "n": 16,
      "text": "Right next to me.",
      "start": 39.191,
      "end": 40.715,
      "src": null,
      "src_dur": null,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": "1.8",
      "override": {},
      "dur": 1.524
    },
    {
      "n": 17,
      "text": "\"Bug,\" it said, in Mom's voice. \"Who are you talking to?\"",
      "start": 40.715,
      "end": 44.665,
      "src": null,
      "src_dur": null,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": "1.8",
      "override": {},
      "dur": 3.95
    },
    {
      "n": 18,
      "text": "I didn't answer.",
      "start": 44.665,
      "end": 45.967,
      "src": null,
      "src_dur": null,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": "1.8",
      "override": {},
      "dur": 1.302
    },
    {
      "n": 19,
      "text": "I held the phone against my chest.",
      "start": 45.967,
      "end": 48.572,
      "src": null,
      "src_dur": null,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": "1.8",
      "override": {},
      "dur": 2.605
    },
    {
      "n": 20,
      "text": "Mom whispered, \"Don't answer, bug. I'm right here.\"",
      "start": 48.572,
      "end": 51.926,
      "src": null,
      "src_dur": null,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": "1.8",
      "override": {},
      "dur": 3.354
    },
    {
      "n": 21,
      "text": "She stayed on the line all night.",
      "start": 51.926,
      "end": 54.502,
      "src": null,
      "src_dur": null,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": "1.8",
      "override": {},
      "dur": 2.576
    },
    {
      "n": 22,
      "text": "At six, the streetlights flickered back on.",
      "start": 54.502,
      "end": 57.444,
      "src": null,
      "src_dur": null,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": "1.8",
      "override": {},
      "dur": 2.942
    },
    {
      "n": 23,
      "text": "The knocking stopped. The house was quiet. Too quiet.",
      "start": 57.444,
      "end": 61.439,
      "src": null,
      "src_dur": null,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": "1.8",
      "override": {},
      "dur": 3.995
    },
    {
      "n": 24,
      "text": "On the kitchen window, there were handprints. Three of them.",
      "start": 61.439,
      "end": 65.683,
      "src": null,
      "src_dur": null,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": "1.8",
      "override": {},
      "dur": 4.244
    },
    {
      "n": 25,
      "text": "I touched the glass. They didn't smear.",
      "start": 65.683,
      "end": 68.657,
      "src": null,
      "src_dur": null,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": "1.8",
      "override": {},
      "dur": 2.974
    },
    {
      "n": 26,
      "text": "They were on the inside.",
      "start": 68.657,
      "end": 70.581,
      "src": null,
      "src_dur": null,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": "1.8",
      "override": {},
      "dur": 1.924
    },
    {
      "n": 27,
      "text": "Then, from upstairs, in Mom's voice:",
      "start": 70.581,
      "end": 73.044,
      "src": null,
      "src_dur": null,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": "1.8",
      "override": {},
      "dur": 2.463
    },
    {
      "n": 28,
      "text": "\"Bug? Come up here. I want to show you something.\"",
      "start": 73.044,
      "end": 76.833,
      "src": null,
      "src_dur": null,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": "1.8",
      "override": {},
      "dur": 3.789
    },
    {
      "n": 29,
      "text": "Mom was still on the phone.",
      "start": 76.833,
      "end": 80.152,
      "src": null,
      "src_dur": null,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": "1.8",
      "override": {},
      "dur": 3.319
    }
  ],
