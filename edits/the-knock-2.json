{
  "slug": "the-knock-2",
  "title": "The Knock (Part 2 of 4)",
  "timing": "voice",
  "voice": "output/cache/the-knock-2/voice_fx.wav",
  "duration": 53.723,
  "shots": [
    {
      "n": 1,
      "text": "You told me not to open either door.",
      "start": 0.0,
      "end": 2.0,
      "src": "output/anim/the-knock-2/shot_01.mp4",
      "src_dur": 4.4,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": null,
      "override": {},
      "dur": 2.0
    },
    {
      "n": 2,
      "text": "So I didn't.",
      "start": 2.0,
      "end": 2.98,
      "src": "output/anim/the-knock-2/shot_02.mp4",
      "src_dur": 2.067,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": null,
      "override": {},
      "dur": 0.98
    },
    {
      "n": 3,
      "text": "I crawled to the kitchen and plugged in my phone.",
      "start": 2.98,
      "end": 4.96,
      "src": "output/anim/the-knock-2/shot_03.mp4",
      "src_dur": 5.0,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": null,
      "override": {},
      "dur": 1.98
    },
    {
      "n": 4,
      "text": "Three percent. Four.",
      "start": 4.96,
      "end": 6.43,
      "src": "output/anim/the-knock-2/shot_04.mp4",
      "src_dur": 2.6,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": null,
      "override": {},
      "dur": 1.47
    },
    {
      "n": 5,
      "text": "The knocking got louder. Both doors at once.",
      "start": 6.43,
      "end": 8.81,
      "src": "output/anim/the-knock-2/shot_05.mp4",
      "src_dur": 4.6,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": null,
      "override": {},
      "dur": 2.38
    },
    {
      "n": 6,
      "text": "Five percent. I called Mom.",
      "start": 8.81,
      "end": 10.57,
      "src": "output/anim/the-knock-2/shot_06.mp4",
      "src_dur": 3.333,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": null,
      "override": {},
      "dur": 1.76
    },
    {
      "n": 7,
      "text": "It rang. And rang.",
      "start": 10.57,
      "end": 12.21,
      "src": "output/anim/the-knock-2/shot_07.mp4",
      "src_dur": 2.733,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": null,
      "override": {},
      "dur": 1.64
    },
    {
      "n": 8,
      "text": "\"Bug? Honey, the lights went out at the restaurant.",
      "start": 12.21,
      "end": 14.57,
      "src": "output/anim/the-knock-2/shot_08.mp4",
      "src_dur": 5.133,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": null,
      "override": {},
      "dur": 2.36
    },
    {
      "n": 9,
      "text": "Dad and I are stuck here till morning. Are you inside? Is the door locked?\"",
      "start": 14.57,
      "end": 17.69,
      "src": "output/anim/the-knock-2/shot_09.mp4",
      "src_dur": 7.267,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": null,
      "override": {},
      "dur": 3.12
    },
    {
      "n": 10,
      "text": "I looked at the front door.",
      "start": 17.69,
      "end": 18.89,
      "src": "output/anim/the-knock-2/shot_10.mp4",
      "src_dur": 3.267,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": null,
      "override": {},
      "dur": 1.2
    },
    {
      "n": 11,
      "text": "Then the back door.",
      "start": 18.89,
      "end": 19.8,
      "src": "output/anim/the-knock-2/shot_11.mp4",
      "src_dur": 2.533,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": null,
      "override": {},
      "dur": 0.91
    },
    {
      "n": 12,
      "text": "If Mom and Dad were at the restaurant...",
      "start": 19.8,
      "end": 21.4,
      "src": "output/anim/the-knock-2/shot_12.mp4",
      "src_dur": 4.133,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": null,
      "override": {},
      "dur": 1.6
    },
    {
      "n": 13,
      "text": "then who was outside?",
      "start": 21.4,
      "end": 22.7,
      "src": "output/anim/the-knock-2/shot_13.mp4",
      "src_dur": 2.6,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": null,
      "override": {},
      "dur": 1.3
    },
    {
      "n": 14,
      "text": "Both doors went silent.",
      "start": 22.7,
      "end": 24.06,
      "src": "output/anim/the-knock-2/shot_14.mp4",
      "src_dur": 2.667,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": null,
      "override": {},
      "dur": 1.36
    },
    {
      "n": 15,
      "text": "Then something knocked on the kitchen window.",
      "start": 24.06,
      "end": 25.7,
      "src": "output/anim/the-knock-2/shot_15.mp4",
      "src_dur": 4.133,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": null,
      "override": {},
      "dur": 1.64
    },
    {
      "n": 16,
      "text": "Right next to me.",
      "start": 25.7,
      "end": 26.9,
      "src": "output/anim/the-knock-2/shot_16.mp4",
      "src_dur": 2.467,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": null,
      "override": {},
      "dur": 1.2
    },
    {
      "n": 17,
      "text": "\"Bug,\" it said, in Mom's voice. \"Who are you talking to?\"",
      "start": 26.9,
      "end": 29.2,
      "src": "output/anim/the-knock-2/shot_17.mp4",
      "src_dur": 5.4,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": null,
      "override": {},
      "dur": 2.3
    },
    {
      "n": 18,
      "text": "I didn't answer.",
      "start": 29.2,
      "end": 30.08,
      "src": "output/anim/the-knock-2/shot_18.mp4",
      "src_dur": 2.2,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": null,
      "override": {},
      "dur": 0.88
    },
    {
      "n": 19,
      "text": "I held the phone against my chest.",
      "start": 30.08,
      "end": 31.64,
      "src": "output/anim/the-knock-2/shot_19.mp4",
      "src_dur": 3.733,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": null,
      "override": {},
      "dur": 1.56
    },
    {
      "n": 20,
      "text": "Mom whispered, \"Don't answer, bug. I'm right here.\"",
      "start": 31.64,
      "end": 34.0,
      "src": "output/anim/the-knock-2/shot_20.mp4",
      "src_dur": 4.667,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": null,
      "override": {},
      "dur": 2.36
    },
    {
      "n": 21,
      "text": "She stayed on the line all night.",
      "start": 34.0,
      "end": 35.7,
      "src": "output/anim/the-knock-2/shot_21.mp4",
      "src_dur": 3.733,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": null,
      "override": {},
      "dur": 1.7
    },
    {
      "n": 22,
      "text": "At six, the streetlights flickered back on.",
      "start": 35.7,
      "end": 37.8,
      "src": "output/anim/the-knock-2/shot_22.mp4",
      "src_dur": 4.133,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": null,
      "override": {},
      "dur": 2.1
    },
    {
      "n": 23,
      "text": "The knocking stopped. The house was quiet. Too quiet.",
      "start": 37.8,
      "end": 41.13,
      "src": "output/anim/the-knock-2/shot_23.mp4",
      "src_dur": 5.4,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": null,
      "override": {},
      "dur": 3.33
    },
    {
      "n": 24,
      "text": "On the kitchen window, there were handprints. Three of them.",
      "start": 41.13,
      "end": 43.56,
      "src": "output/anim/the-knock-2/shot_24.mp4",
      "src_dur": 5.733,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": null,
      "override": {},
      "dur": 2.43
    },
    {
      "n": 25,
      "text": "I touched the glass. They didn't smear.",
      "start": 43.56,
      "end": 45.56,
      "src": "output/anim/the-knock-2/shot_25.mp4",
      "src_dur": 4.2,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": null,
      "override": {},
      "dur": 2.0
    },
    {
      "n": 26,
      "text": "They were on the inside.",
      "start": 45.56,
      "end": 46.98,
      "src": "output/anim/the-knock-2/shot_26.mp4",
      "src_dur": 2.933,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": null,
      "override": {},
      "dur": 1.42
    },
    {
      "n": 27,
      "text": "Then, from upstairs, in Mom's voice:",
      "start": 46.98,
      "end": 49.06,
      "src": "output/anim/the-knock-2/shot_27.mp4",
      "src_dur": 3.6,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": null,
      "override": {},
      "dur": 2.08
    },
    {
      "n": 28,
      "text": "\"Bug? Come up here. I want to show you something.\"",
      "start": 49.06,
      "end": 51.14,
      "src": "output/anim/the-knock-2/shot_28.mp4",
      "src_dur": 5.2,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": null,
      "override": {},
      "dur": 2.08
    },
    {
      "n": 29,
      "text": "Mom was still on the phone.",
      "start": 51.14,
      "end": 53.723,
      "src": "output/anim/the-knock-2/shot_29.mp4",
      "src_dur": 4.6,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": null,
      "override": {},
      "dur": 2.583
    }
