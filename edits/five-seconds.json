   "end": 12.23,
   "src": null,
   "src_dur": null,
   "motion": "push_in",
   "transition": "cut",
   "grade": "neutral",
   "placeholder": "street | glowing gift passed between hands | 1.6",
   "override": {},
   "dur": 2.24
  },
  {
   "n": 9,
   "text": "Most people only do it at the very end, to their kids.",
   "start": 12.23,
   "end": 14.63,
   "src": null,
   "src_dur": null,
   "motion": "push_in",
   "transition": "cut",
