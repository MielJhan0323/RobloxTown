   "placeholder": "house bedroom, night | a soft glow over a bed (nothing else shown) | 1.6",
   "override": {},
   "dur": 2.4
  },
  {
   "n": 10,
   "text": "Rio's gift wasn't much better.",
   "start": 14.63,
   "end": 15.65,
   "src": null,
   "src_dur": null,
   "motion": "push_in",
   "transition": "cut",
   "grade": "neutral",
   "placeholder": "street | Rio | 1.6",
   "override": {},
   "dur": 1.02
  },
  {
   "n": 11,
   "text": "He could sense danger.",
   "start": 15.65,
   "end": 17.22,
   "src": null,
   "src_dur": null,
   "motion": "push_in",
   "transition": "cut",
   "grade": "neutral",
   "placeholder": "street | Rio, eyes glow | 1.6",
   "override": {},
   "dur": 1.57
  },
  {
   "n": 12,
   "text": "That's it. He couldn't stop it. He just felt it coming.",
   "start": 17.22,
   "end": 19.88,
   "src": null,
   "src_dur": null,
   "motion": "push_in",
   "transition": "cut",
   "grade": "neutral",
   "placeholder": "playground | ball hits another kid, Rio flinches | 1.6",
   "override": {},
   "dur": 2.66
  },
  {
   "n": 13,
   "text": "Kids called him a scaredy cat.",
   "start": 19.88,
   "end": 21.32,
   "src": null,
   "src_dur": null,
   "motion": "push_in",
   "transition": "cut",
   "grade": "neutral",
   "placeholder": "playground | kids laughing at Rio | 1.6",
   "override": {},
   "dur": 1.44
  },
  {
   "n": 14,
   "text": "Rio and I were always together.",
   "start": 21.32,
   "end": 22.86,
   "src": null,
   "src_dur": null,
   "motion": "push_in",
   "transition": "cut",
   "grade": "neutral",
   "placeholder": "bench | both | 1.6",
   "override": {},
   "dur": 1.54
  },
  {
   "n": 15,
   "text": "At lunch.",
   "start": 22.86,
   "end": 23.46,
   "src": null,
   "src_dur": null,
   "motion": "push_in",
   "transition": "cut",
   "grade": "neutral",
   "placeholder": "canteen corner | both | 1.6",
   "override": {},
   "dur": 0.6
  },
  {
   "n": 16,
   "text": "On our bench.",
