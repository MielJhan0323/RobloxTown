{
  "slug": "five-seconds",
  "title": "The Last Pickle",
  "timing": "estimated",
  "voice": null,
  "duration": 95.49,
  "shots": [
    {
      "n": 1,
      "text": "In this town,",
      "start": 0.0,
      "end": 1.363,
      "src": null,
      "src_dur": null,
      "motion": "push_in",
      "transition": "cut",
      "grade": "warm",
      "placeholder": "street, golden afternoon | kids walking | smile | wide",
      "override": {},
      "dur": 1.363
    },
    {
      "n": 2,
      "text": "everyone gets one gift.",
      "start": 1.363,
      "end": 3.065,
      "src": null,
      "src_dur": null,
      "motion": "push_in",
      "transition": "sparkle",
      "grade": "warm",
      "placeholder": "street | kids, sparkles | smile | medium | sparkles",
      "override": {},
      "dur": 1.702
    },
    {
      "n": 3,
      "text": "Some kids can talk to dogs.",
      "start": 3.065,
      "end": 5.27,
      "src": null,
      "src_dur": null,
      "motion": "push_in",
      "transition": "cut",
      "grade": "warm",
      "placeholder": "street | Prey1 + dog | laugh | medium | dog",
      "override": {},
      "dur": 2.205
    },
    {
      "n": 4,
      "text": "Some can find anything you lose.",
      "start": 5.27,
      "end": 7.624,
      "src": null,
      "src_dur": null,
      "motion": "push_in",
      "transition": "cut",
      "grade": "warm",
      "placeholder": "street | Crowd1 holding keys | smile | medium | keys",
      "override": {},
      "dur": 2.354
    },
    {
      "n": 5,
      "text": "Mine? My toast always lands butter side up.",
      "start": 7.624,
      "end": 10.909,
      "src": null,
      "src_dur": null,
      "motion": "push_in",
      "transition": "cut",
      "grade": "warm",
      "placeholder": "house kitchen | Narrator, toast falls | tired | medium | toast",
      "override": {},
      "dur": 3.285
    },
    {
      "n": 6,
      "text": "Nobody claps for that.",
      "start": 10.909,
      "end": 12.581,
      "src": null,
      "src_dur": null,
      "motion": "push_in",
      "transition": "cut",
      "grade": "warm",
      "placeholder": "house kitchen | Narrator alone | sad | medium",
      "override": {},
      "dur": 1.672
    },
    {
      "n": 7,
      "text": "Rio's gift was different.",
      "start": 12.581,
      "end": 14.343,
      "src": null,
      "src_dur": null,
      "motion": "push_in",
      "transition": "sparkle",
      "grade": "warm",
      "placeholder": "street, sunset | Rio | smile | medium | sparkles",
      "override": {},
      "dur": 1.762
    },
    {
      "n": 8,
      "text": "He could feel when something was about to end.",
      "start": 14.343,
      "end": 17.689,
      "src": null,
      "src_dur": null,
      "motion": "push_in",
      "transition": "cut",
      "grade": "warm",
      "placeholder": "street | Rio, soft glow | neutral | close | glow",
      "override": {},
      "dur": 3.346
    },
    {
      "n": 9,
      "text": "The last day of summer.",
      "start": 17.689,
      "end": 19.583,
      "src": null,
      "src_dur": null,
      "motion": "push_in",
      "transition": "cut",
      "grade": "warm",
      "placeholder": "street, sunset | Rio watching the sun | smile | wide | sun",
      "override": {},
      "dur": 1.894
    },
    {
      "n": 10,
      "text": "The last bite of a burger.",
      "start": 19.583,
      "end": 21.759,
      "src": null,
      "src_dur": null,
      "motion": "push_in",
      "transition": "cut",
      "grade": "warm",
      "placeholder": "bench | Rio with burger | smile | close | burger",
      "override": {},
      "dur": 2.176
    },
    {
      "n": 11,
      "text": "The second before a glass tips over.",
      "start": 21.759,
      "end": 24.424,
      "src": null,
      "src_dur": null,
      "motion": "push_in",
      "transition": "cut",
      "grade": "warm",
      "placeholder": "canteen | Rio catches a tipping cup | smirk | close | cup",
      "override": {},
      "dur": 2.665
    },
    {
      "n": 12,
      "text": "Rio and I were always together.",
      "start": 24.424,
      "end": 26.748,
      "src": null,
      "src_dur": null,
      "motion": "push_in",
      "transition": "cut",
      "grade": "warm",
      "placeholder": "bench | both | laugh | wide",
      "override": {},
      "dur": 2.324
    },
    {
      "n": 13,
      "text": "At lunch.",
      "start": 26.748,
      "end": 27.65,
      "src": null,
      "src_dur": null,
      "motion": "push_in",
      "transition": "cut",
      "grade": "warm",
      "placeholder": "canteen trash corner | both at the little table | smile | medium",
      "override": {},
      "dur": 0.902
    },
    {
      "n": 14,
      "text": "On our bench.",
      "start": 27.65,
      "end": 28.863,
      "src": null,
      "src_dur": null,
      "motion": "push_in",
      "transition": "cut",
      "grade": "warm",
      "placeholder": "bench | both | smile | medium",
      "override": {},
      "dur": 1.213
    },
    {
      "n": 15,
      "text": "He always saved me the last pickle.",
      "start": 28.863,
      "end": 31.498,
      "src": null,
      "src_dur": null,
      "motion": "push_in",
      "transition": "cut",
      "grade": "warm",
      "placeholder": "bench | Rio hands a pickle | smile | close | pickle",
      "override": {},
      "dur": 2.635
    },
    {
      "n": 16,
      "text": "Kids started laughing at us.",
      "start": 31.498,
      "end": 33.541,
      "src": null,
      "src_dur": null,
      "motion": "push_in",
      "transition": "cut",
      "grade": "warm",
      "placeholder": "canteen | kids pointing and laughing | laugh | wide",
      "override": {},
      "dur": 2.043
    },
    {
      "n": 17,
      "text": "\"Are you two married?\"",
      "start": 33.541,
      "end": 34.904,
      "src": null,
      "src_dur": null,
      "motion": "push_in",
      "transition": "cut",
      "grade": "warm",
      "placeholder": "canteen | Crowd1 teasing | laugh, talk | close",
      "override": {},
      "dur": 1.363
    },
    {
      "n": 18,
      "text": "\"Toast Boy and his shadow.\"",
      "start": 34.904,
      "end": 36.607,
      "src": null,
      "src_dur": null,
      "motion": "push_in",
      "transition": "cut",
      "grade": "warm",
      "placeholder": "canteen | Crowd2 teasing | smirk, talk | close",
      "override": {},
      "dur": 1.703
    },
    {
      "n": 19,
      "text": "Kai said, \"With Rio's gift, you'd actually be somebody.\"",
      "start": 36.607,
      "end": 40.081,
      "src": null,
      "src_dur": null,
      "motion": "push_in",
      "transition": "cut",
      "grade": "warm",
      "placeholder": "playground | Kai leaning in to Narrator | smirk, talk | medium",
      "override": {},
      "dur": 3.474
    },
    {
      "n": 20,
      "text": "So I asked Rio for it.",
      "start": 40.081,
      "end": 42.139,
      "src": null,
      "src_dur": null,
      "motion": "push_in",
      "transition": "fog",
      "grade": "warm",
      "placeholder": "bench | Narrator talking | worried | medium",
      "override": {},
      "dur": 2.058
    },
    {
      "n": 21,
      "text": "He looked at me for a long time.",
      "start": 42.139,
      "end": 44.878,
      "src": null,
      "src_dur": null,
      "motion": "push_in",
      "transition": "cut",
      "grade": "warm",
      "placeholder": "bench | Rio | neutral | close",
      "override": {},
      "dur": 2.739
    },
    {
      "n": 22,
      "text": "\"Why do you think I'm always with you?\" he said.",
      "start": 44.878,
      "end": 48.387,
      "src": null,
      "src_dur": null,
      "motion": "push_in",
      "transition": "cut",
      "grade": "warm",
      "placeholder": "bench | Rio | sad, talk | close",
      "override": {},
      "dur": 3.509
    },
    {
      "n": 23,
      "text": "\"I can feel when things end. And this hasn't.\"",
      "start": 48.387,
      "end": 51.644,
      "src": null,
      "src_dur": null,
      "motion": "push_in",
      "transition": "cut",
      "grade": "warm",
      "placeholder": "bench | Rio | smile, talk | close",
      "override": {},
      "dur": 3.257
    },
    {
      "n": 24,
      "text": "Then he gave it to me anyway.",
      "start": 51.644,
      "end": 54.102,
      "src": null,
      "src_dur": null,
      "motion": "push_in",
      "transition": "cut",
      "grade": "warm",
      "placeholder": "bench | Rio hands a glowing orb | smile | medium | glow orb",
      "override": {},
      "dur": 2.458
    },
    {
      "n": 25,
      "text": "\"Just promise you'll spend every minute with me.\"",
      "start": 54.102,
      "end": 57.035,
      "src": null,
      "src_dur": null,
      "motion": "push_in",
      "transition": "cut",
      "grade": "warm",
      "placeholder": "bench | Rio | smile, talk | close",
      "override": {},
      "dur": 2.933
    },
    {
      "n": 26,
      "text": "I said yes before he finished.",
      "start": 57.035,
      "end": 59.33,
      "src": null,
      "src_dur": null,
      "motion": "push_in",
      "transition": "cut",
      "grade": "warm",
      "placeholder": "bench | Narrator nodding | laugh | close | orb",
      "override": {},
      "dur": 2.295
    },
    {
      "n": 27,
      "text": "With his gift, I knew when every game would end.",
      "start": 59.33,
      "end": 62.998,
      "src": null,
      "src_dur": null,
      "motion": "push_in",
      "transition": "cut",
      "grade": "warm",
      "placeholder": "playground | Narrator, eye glow | smirk | medium",
      "override": {},
      "dur": 3.668
    },
    {
      "n": 28,
      "text": "When to jump. When to leave.",
      "start": 62.998,
      "end": 65.454,
      "src": null,
      "src_dur": null,
      "motion": "push_in",
      "transition": "cut",
      "grade": "warm",
      "placeholder": "playground | Narrator jumps, walks off | smirk | wide",
      "override": {},
      "dur": 2.456
    },
    {
      "n": 29,
      "text": "Nobody laughed at me anymore.",
      "start": 65.454,
      "end": 67.526,
      "src": null,
      "src_dur": null,
      "motion": "push_in",
      "transition": "cut",
      "grade": "warm",
      "placeholder": "playground | crowd cheering | laugh | wide",
      "override": {},
      "dur": 2.072
    },
    {
      "n": 30,
      "text": "I stopped sitting on our bench.",
      "start": 67.526,
      "end": 69.85,
      "src": null,
      "src_dur": null,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": "bench, dusk | Rio alone | sad | wide | two burgers",
      "override": {},
      "dur": 2.324
    },
    {
      "n": 31,
      "text": "Every day, I said, \"Tomorrow.\"",
      "start": 69.85,
      "end": 71.783,
      "src": null,
      "src_dur": null,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": "playground | Narrator waving him off | smile | medium",
      "override": {},
      "dur": 1.933
    },
    {
      "n": 32,
      "text": "Then, one afternoon, I felt it.",
      "start": 71.783,
      "end": 74.248,
      "src": null,
      "src_dur": null,
      "motion": "punch",
      "transition": "fog",
      "grade": "neutral",
      "placeholder": "playground, dusk | Narrator freezes, eye glow | shocked | close, punch | glow",
      "override": {},
      "dur": 2.465
    },
    {
      "n": 33,
      "text": "A tug, like the last page of a book.",
      "start": 74.248,
      "end": 77.369,
      "src": null,
      "src_dur": null,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": "playground | hand on chest | scared | close",
      "override": {},
      "dur": 3.121
    },
    {
      "n": 34,
      "text": "It came from our bench.",
      "start": 77.369,
      "end": 79.263,
      "src": null,
      "src_dur": null,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": "bench, dusk | Rio crossing toward the stand | wide",
      "override": {},
      "dur": 1.894
    },
    {
      "n": 35,
      "text": "I ran.",
      "start": 79.263,
      "end": 80.076,
      "src": null,
      "src_dur": null,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": "playground | Narrator running | scared | wide",
      "override": {},
      "dur": 0.813
    },
    {
      "n": 36,
      "text": "But Rio didn't feel the car coming.",
      "start": 80.076,
      "end": 82.711,
      "src": null,
      "src_dur": null,
      "motion": "push_in",
      "transition": "cut",
      "grade": "cool",
      "placeholder": "street, night | headlights on Rio (nothing shown) | smile | wide | headlights",
      "override": {},
      "dur": 2.635
    },
    {
      "n": 37,
      "text": "He'd given that away.",
      "start": 82.711,
      "end": 84.354,
      "src": null,
      "src_dur": null,
      "motion": "push_in",
      "transition": "fog",
      "grade": "cool",
      "placeholder": "bench, rain | empty bench | wide | rain",
      "override": {},
      "dur": 1.643
    },
    {
      "n": 38,
      "text": "Now I spend every afternoon on our bench.",
      "start": 84.354,
      "end": 87.359,
      "src": null,
      "src_dur": null,
      "motion": "push_in",
      "transition": "fog",
      "grade": "warm",
      "placeholder": "bench, sunset | Narrator alone | sad | medium",
      "override": {},
      "dur": 3.005
    },
    {
      "n": 39,
      "text": "I leave room on the left.",
      "start": 87.359,
      "end": 89.506,
      "src": null,
      "src_dur": null,
      "motion": "push_in",
      "transition": "cut",
      "grade": "warm",
      "placeholder": "bench | Narrator + empty space | sad | wide",
      "override": {},
      "dur": 2.147
    },
    {
      "n": 40,
      "text": "I save him the last pickle.",
      "start": 89.506,
      "end": 91.711,
      "src": null,
      "src_dur": null,
      "motion": "push_in",
      "transition": "cut",
      "grade": "warm",
      "placeholder": "bench | pickle on a napkin | close | pickle",
      "override": {},
      "dur": 2.205
    },
    {
      "n": 41,
      "text": "Every minute I promised. Just late.",
      "start": 91.711,
      "end": 95.49,
      "src": null,
      "src_dur": null,
      "motion": "push_in",
      "transition": "cut",
      "grade": "warm",
      "placeholder": "bench | Narrator | crying | close",
      "override": {},
      "dur": 3.779
    }
