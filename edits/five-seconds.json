{
  "slug": "five-seconds",
  "title": "The Last Pickle",
  "timing": "estimated",
  "voice": null,
  "duration": 130.251,
  "shots": [
    {
      "n": 1,
      "text": "In this town,",
      "start": 0.0,
      "end": 1.363,
      "src": null,
      "src_dur": null,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": "street | kids walking | 1.6",
      "override": {},
      "dur": 1.363
    },
    {
      "n": 2,
      "text": "everyone gets one gift.",
      "start": 1.363,
      "end": 3.065,
      "src": null,
      "src_dur": null,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": "street | sparkles | 1.6",
      "override": {},
      "dur": 1.702
    },
    {
      "n": 3,
      "text": "Some kids can talk to dogs.",
      "start": 3.065,
      "end": 5.27,
      "src": null,
      "src_dur": null,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": "street | dog | 1.6",
      "override": {},
      "dur": 2.205
    },
    {
      "n": 4,
      "text": "Some can fly a little.",
      "start": 5.27,
      "end": 7.135,
      "src": null,
      "src_dur": null,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": "street | Crowd1 hovering | 1.6",
      "override": {},
      "dur": 1.865
    },
    {
      "n": 5,
      "text": "Mine? I'm super strong, for one second.",
      "start": 7.135,
      "end": 10.18,
      "src": null,
      "src_dur": null,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": "playground | Narrator lifts a trash can | 1.6",
      "override": {},
      "dur": 3.045
    },
    {
      "n": 6,
      "text": "Then it's gone.",
      "start": 10.18,
      "end": 11.452,
      "src": null,
      "src_dur": null,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": "playground | the can drops on him | 1.6",
      "override": {},
      "dur": 1.272
    },
    {
      "n": 7,
      "text": "Nobody claps for that.",
      "start": 11.452,
      "end": 13.124,
      "src": null,
      "src_dur": null,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": "playground | kids walk past | 1.6",
      "override": {},
      "dur": 1.672
    },
    {
      "n": 8,
      "text": "You can give your gift away, but only once.",
      "start": 13.124,
      "end": 16.452,
      "src": null,
      "src_dur": null,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": "street | glowing gift passed between hands | 1.6",
      "override": {},
      "dur": 3.328
    },
    {
      "n": 9,
      "text": "Most people only do it at the very end, to their kids.",
      "start": 16.452,
      "end": 20.683,
      "src": null,
      "src_dur": null,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": "house bedroom, night | a soft glow over a bed (nothing else shown) | 1.6",
      "override": {},
      "dur": 4.231
    },
    {
      "n": 10,
      "text": "Rio's gift wasn't much better.",
      "start": 20.683,
      "end": 22.785,
      "src": null,
      "src_dur": null,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": "street | Rio | 1.6",
      "override": {},
      "dur": 2.102
    },
    {
      "n": 11,
      "text": "He could sense danger.",
      "start": 22.785,
      "end": 24.457,
      "src": null,
      "src_dur": null,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": "street | Rio, eyes glow | 1.6",
      "override": {},
      "dur": 1.672
    },
    {
      "n": 12,
      "text": "That's it. He couldn't stop it. He just felt it coming.",
      "start": 24.457,
      "end": 28.896,
      "src": null,
      "src_dur": null,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": "playground | ball hits another kid, Rio flinches | 1.6",
      "override": {},
      "dur": 4.439
    },
    {
      "n": 13,
      "text": "Kids called him a scaredy cat.",
      "start": 28.896,
      "end": 31.191,
      "src": null,
      "src_dur": null,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": "playground | kids laughing at Rio | 1.6",
      "override": {},
      "dur": 2.295
    },
    {
      "n": 14,
      "text": "Rio and I were always together.",
      "start": 31.191,
      "end": 33.515,
      "src": null,
      "src_dur": null,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": "bench | both | 1.6",
      "override": {},
      "dur": 2.324
    },
    {
      "n": 15,
      "text": "At lunch.",
      "start": 33.515,
      "end": 34.417,
      "src": null,
      "src_dur": null,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": "canteen corner | both | 1.6",
      "override": {},
      "dur": 0.902
    },
    {
      "n": 16,
      "text": "On our bench.",
      "start": 34.417,
      "end": 35.63,
      "src": null,
      "src_dur": null,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": "bench | both | 1.6",
      "override": {},
      "dur": 1.213
    },
    {
      "n": 17,
      "text": "He always saved me the last pickle.",
      "start": 35.63,
      "end": 38.265,
      "src": null,
      "src_dur": null,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": "bench | Rio hands a pickle | 1.6",
      "override": {},
      "dur": 2.635
    },
    {
      "n": 18,
      "text": "Then the jokes started.",
      "start": 38.265,
      "end": 39.967,
      "src": null,
      "src_dur": null,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": "canteen | kids pointing | 1.6",
      "override": {},
      "dur": 1.702
    },
    {
      "n": 19,
      "text": "\"Are you two married?\"",
      "start": 39.967,
      "end": 41.33,
      "src": null,
      "src_dur": null,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": "canteen | Crowd1 teasing | 1.6",
      "override": {},
      "dur": 1.363
    },
    {
      "n": 20,
      "text": "\"Scaredy cat and his bodyguard.\"",
      "start": 41.33,
      "end": 43.181,
      "src": null,
      "src_dur": null,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": "canteen | Crowd2 teasing | 1.6",
      "override": {},
      "dur": 1.851
    },
    {
      "n": 21,
      "text": "They laughed in the halls. They laughed at lunch.",
      "start": 43.181,
      "end": 46.837,
      "src": null,
      "src_dur": null,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": "playground | circle of kids laughing | 1.6",
      "override": {},
      "dur": 3.656
    },
    {
      "n": 22,
      "text": "Kai said, \"Two useless gifts. Perfect match.\"",
      "start": 46.837,
      "end": 49.75,
      "src": null,
      "src_dur": null,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": "playground | Kai leaning in | 1.6",
      "override": {},
      "dur": 2.913
    },
    {
      "n": 23,
      "text": "One day, I'd had enough.",
      "start": 49.75,
      "end": 51.744,
      "src": null,
      "src_dur": null,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": "playground | Narrator angry | 1.6",
      "override": {},
      "dur": 1.994
    },
    {
      "n": 24,
      "text": "I knew our gifts would fit together. I asked Rio for his.",
      "start": 51.744,
      "end": 56.215,
      "src": null,
      "src_dur": null,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": "bench | Narrator asks | 1.6",
      "override": {},
      "dur": 4.471
    },
    {
      "n": 25,
      "text": "\"I'll keep you safe,\" I said. \"Every minute. I promise.\"",
      "start": 56.215,
      "end": 60.093,
      "src": null,
      "src_dur": null,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": "bench | Narrator | 1.6",
      "override": {},
      "dur": 3.878
    },
    {
      "n": 26,
      "text": "Rio looked at me for a long time.",
      "start": 60.093,
      "end": 62.861,
      "src": null,
      "src_dur": null,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": "bench | Rio | 1.6",
      "override": {},
      "dur": 2.768
    },
    {
      "n": 27,
      "text": "\"Why do you think I'm always with you?\" he said.",
      "start": 62.861,
      "end": 66.37,
      "src": null,
      "src_dur": null,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": "bench | Rio | 1.6",
      "override": {},
      "dur": 3.509
    },
    {
      "n": 28,
      "text": "\"Nothing feels dangerous when you're here.\"",
      "start": 66.37,
      "end": 68.741,
      "src": null,
      "src_dur": null,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": "bench | Rio | 1.6",
      "override": {},
      "dur": 2.371
    },
    {
      "n": 29,
      "text": "Then he gave it to me anyway.",
      "start": 68.741,
      "end": 71.198,
      "src": null,
      "src_dur": null,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": "bench | glowing orb | 1.6",
      "override": {},
      "dur": 2.457
    },
    {
      "n": 30,
      "text": "Alone, our gifts were nothing.",
      "start": 71.198,
      "end": 73.37,
      "src": null,
      "src_dur": null,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": "bench | orb fades into his hands | 1.6",
      "override": {},
      "dur": 2.172
    },
    {
      "n": 31,
      "text": "Together, I always knew the exact second to be strong.",
      "start": 73.37,
      "end": 77.217,
      "src": null,
      "src_dur": null,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": "playground | Narrator lifts the can, eyes glow | 1.6",
      "override": {},
      "dur": 3.847
    },
    {
      "n": 32,
      "text": "I won every game. Every race.",
      "start": 77.217,
      "end": 79.702,
      "src": null,
      "src_dur": null,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": "playground | race | 1.6",
      "override": {},
      "dur": 2.485
    },
    {
      "n": 33,
      "text": "Even Kai couldn't touch me.",
      "start": 79.702,
      "end": 81.715,
      "src": null,
      "src_dur": null,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": "playground | Kai swings, falls | 1.6",
      "override": {},
      "dur": 2.013
    },
    {
      "n": 34,
      "text": "Everyone wanted to sit with me now.",
      "start": 81.715,
      "end": 84.35,
      "src": null,
      "src_dur": null,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": "canteen | Narrator at the popular table | 1.6",
      "override": {},
      "dur": 2.635
    },
    {
      "n": 35,
      "text": "Without his gift, Rio was just a regular kid.",
      "start": 84.35,
      "end": 87.737,
      "src": null,
      "src_dur": null,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": "street | Rio walking | 1.6",
      "override": {},
      "dur": 3.387
    },
    {
      "n": 36,
      "text": "He got caught in the rain.",
      "start": 87.737,
      "end": 89.913,
      "src": null,
      "src_dur": null,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": "street | Rio in rain | 1.6",
      "override": {},
      "dur": 2.176
    },
    {
      "n": 37,
      "text": "He tripped on the stairs.",
      "start": 89.913,
      "end": 91.867,
      "src": null,
      "src_dur": null,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": "playground | Rio trips | 1.6",
      "override": {},
      "dur": 1.954
    },
    {
      "n": 38,
      "text": "He never saw the ball coming.",
      "start": 91.867,
      "end": 94.131,
      "src": null,
      "src_dur": null,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": "playground | ball bonks Rio | 1.6",
      "override": {},
      "dur": 2.264
    },
    {
      "n": 39,
      "text": "He just laughed it off.",
      "start": 94.131,
      "end": 96.026,
      "src": null,
      "src_dur": null,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": "playground | Rio laughing | 1.6",
      "override": {},
      "dur": 1.895
    },
    {
      "n": 40,
      "text": "I stopped sitting on our bench. Rio didn't.",
      "start": 96.026,
      "end": 99.311,
      "src": null,
      "src_dur": null,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": "bench, dusk | Rio alone | 1.6",
      "override": {},
      "dur": 3.285
    },
    {
      "n": 41,
      "text": "He waited after school. He waited until the streetlights came on.",
      "start": 99.311,
      "end": 103.826,
      "src": null,
      "src_dur": null,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": "bench, night | Rio alone, lamps on | 1.6",
      "override": {},
      "dur": 4.515
    },
    {
      "n": 42,
      "text": "He saved me the last pickle, every day.",
      "start": 103.826,
      "end": 106.843,
      "src": null,
      "src_dur": null,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": "bench | pickle close | 1.6",
      "override": {},
      "dur": 3.017
    },
    {
      "n": 43,
      "text": "And every day, I said, \"Tomorrow.\"",
      "start": 106.843,
      "end": 109.087,
      "src": null,
      "src_dur": null,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": "playground | Narrator waving him off | 1.6",
      "override": {},
      "dur": 2.244
    },
    {
      "n": 44,
      "text": "Then, one afternoon, I felt danger. It came from our bench.",
      "start": 109.087,
      "end": 113.565,
      "src": null,
      "src_dur": null,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": "playground, dusk | Narrator freezes | 1.6",
      "override": {},
      "dur": 4.478
    },
    {
      "n": 45,
      "text": "Rio didn't sense the car coming. He'd given that away.",
      "start": 113.565,
      "end": 117.561,
      "src": null,
      "src_dur": null,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": "street, night | headlights - hard cut, nothing shown | 1.6",
      "override": {},
      "dur": 3.996
    },
    {
      "n": 46,
      "text": "Now I spend every afternoon on our bench.",
      "start": 117.561,
      "end": 120.567,
      "src": null,
      "src_dur": null,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": "bench, sunset | Narrator alone | 1.6",
      "override": {},
      "dur": 3.006
    },
    {
      "n": 47,
      "text": "I leave room on the left.",
      "start": 120.567,
      "end": 122.713,
      "src": null,
      "src_dur": null,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": "bench | empty space | 1.6",
      "override": {},
      "dur": 2.146
    },
    {
      "n": 48,
      "text": "I save him the last pickle.",
      "start": 122.713,
      "end": 124.919,
      "src": null,
      "src_dur": null,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": "bench | pickle close | 1.6",
      "override": {},
      "dur": 2.206
    },
    {
      "n": 49,
      "text": "I promised I'd keep him safe. Every minute. Just late.",
      "start": 124.919,
      "end": 130.251,
      "src": null,
      "src_dur": null,
      "motion": "push_in",
      "transition": "cut",
      "grade": "neutral",
      "placeholder": "bench | Narrator crying | 1.6",
      "override": {},
      "dur": 5.332
    }
