 "shots": [
  {
   "n": 1,
   "text": "In this town,",
   "start": 0.0,
   "end": 0.9,
   "src": null,
   "src_dur": null,
   "motion": "push_in",
   "transition": "cut",
   "grade": "warm",
   "placeholder": "A street, golden afternoon | kids walking | smile | wide, push-in",
   "override": {},
   "dur": 0.9
  },
  {
   "n": 2,
   "text": "everyone gets one gift.",
   "start": 0.9,
   "end": 2.52,
   "src": null,
   "src_dur": null,
   "motion": "push_in",
   "transition": "sparkle",
   "grade": "warm",
   "placeholder": "A street | kids, sparkles on their hands | smile | medium | sparkles",
   "override": {},
   "dur": 1.62
  },
  {
   "n": 3,
   "text": "Some kids can talk to dogs.",
   "start": 2.52,
   "end": 3.9,
   "src": null,
   "src_dur": null,
   "motion": "push_in",
   "transition": "cut",
   "grade": "warm",
   "placeholder": "A street | Prey1 + dog | laugh | medium | dog",
   "override": {},
   "dur": 1.38
  },
  {
   "n": 4,
   "text": "Some can find anything you lose.",
   "start": 3.9,
   "end": 5.9,
   "src": null,
   "src_dur": null,
   "motion": "push_in",
   "transition": "cut",
   "grade": "warm",
   "placeholder": "A street | Crowd1 holding up keys | smile | medium | keys",
   "override": {},
   "dur": 2.0
  },
  {
   "n": 5,
   "text": "My gift? I could whistle really loud.",
   "start": 5.9,
   "end": 8.3,
   "src": null,
   "src_dur": null,
   "motion": "push_in",
   "transition": "cut",
   "grade": "warm",
   "placeholder": "A street | Narrator whistling, kids cover ears | smirk | medium",
   "override": {},
   "dur": 2.4
  },
  {
   "n": 6,
   "text": "Rio's gift was the best one.",
   "start": 8.3,
   "end": 9.51,
   "src": null,
   "src_dur": null,
   "motion": "push_in",
   "transition": "sparkle",
   "grade": "warm",
   "placeholder": "A street | Rio (Crowd3) | smile | medium | glow in eyes",
   "override": {},
   "dur": 1.21
  },
  {
   "n": 7,
   "text": "He could see five seconds into the future.",
   "start": 9.51,
   "end": 11.57,
   "src": null,
   "src_dur": null,
   "motion": "push_in",
   "transition": "cut",
   "grade": "warm",
   "placeholder": "A street | Rio, golden glow | determined | close | glow",
   "override": {},
   "dur": 2.06
  },
  {
   "n": 8,
   "text": "He never dropped a plate.",
   "start": 11.57,
   "end": 12.67,
   "src": null,
   "src_dur": null,
   "motion": "push_in",
   "transition": "cut",
   "grade": "warm",
   "placeholder": "B canteen | Rio catches a falling tray | smile | medium | tray",
   "override": {},
   "dur": 1.1
  },
  {
   "n": 9,
   "text": "He never lost at tag.",
   "start": 12.67,
   "end": 13.97,
   "src": null,
   "src_dur": null,
   "motion": "push_in",
   "transition": "cut",
   "grade": "warm",
   "placeholder": "C playground | Rio dodges, kids miss | laugh | wide",
   "override": {},
   "dur": 1.3
  },
  {
   "n": 10,
   "text": "He always knew when I was about to laugh.",
   "start": 13.97,
   "end": 15.87,
   "src": null,
   "src_dur": null,
   "motion": "push_in",
   "transition": "cut",
   "grade": "warm",
   "placeholder": "A bench | Rio + Narrator | laugh | medium",
   "override": {},
   "dur": 1.9
  },
  {
   "n": 11,
   "text": "I think I liked him before I knew what that meant.",
   "start": 15.87,
   "end": 17.54,
   "src": null,
   "src_dur": null,
   "motion": "push_in",
   "transition": "cut",
   "grade": "warm",
   "placeholder": "A bench | Narrator looking at Rio | embarrassed | close",
   "override": {},
   "dur": 1.67
  },
  {
   "n": 12,
   "text": "Every afternoon, we sat on the bench by the burger stand.",
   "start": 17.54,
   "end": 20.24,
   "src": null,
   "src_dur": null,
   "motion": "push_in",
   "transition": "fog",
   "grade": "warm",
   "placeholder": "A bench + burger stand | both | smile | wide | burger stand",
   "override": {},
   "dur": 2.7
  },
  {
   "n": 13,
   "text": "He always got a double cheeseburger, extra pickles.",
   "start": 20.24,
   "end": 22.8,
   "src": null,
   "src_dur": null,
   "motion": "push_in",
   "transition": "cut",
   "grade": "warm",
   "placeholder": "A bench | Rio eating | laugh | close | burger",
   "override": {},
   "dur": 2.56
  },
  {
   "n": 14,
   "text": "Then, on my birthday, Rio gave me his gift.",
   "start": 22.8,
   "end": 25.41,
   "src": null,
   "src_dur": null,
   "motion": "push_in",
   "transition": "fog",
   "grade": "warm",
   "placeholder": "A bench | Rio hands a glowing light | smile | medium | glow orb",
   "override": {},
   "dur": 2.61
  },
  {
   "n": 15,
   "text": "\"Just promise you'll spend every minute with me,\"",
   "start": 25.41,
   "end": 27.21,
   "src": null,
   "src_dur": null,
   "motion": "push_in",
   "transition": "cut",
   "grade": "warm",
   "placeholder": "A bench | Rio | smile, talk | close",
   "override": {},
   "dur": 1.8
  },
  {
   "n": 16,
   "text": "he said. I promised.",
   "start": 27.21,
   "end": 28.91,
   "src": null,
   "src_dur": null,
   "motion": "push_in",
   "transition": "cut",
   "grade": "warm",
   "placeholder": "A bench | Narrator | smile | close | glow on his hands",
   "override": {},
   "dur": 1.7
  },
  {
   "n": 17,
   "text": "With his gift, I won every game.",
   "start": 28.91,
   "end": 30.83,
   "src": null,
   "src_dur": null,
   "motion": "push_in",
   "transition": "cut",
   "grade": "warm",
   "placeholder": "C playground | Narrator wins, kids cheer | laugh | wide",
   "override": {},
   "dur": 1.92
  },
  {
   "n": 18,
   "text": "Every race.",
   "start": 30.83,
   "end": 31.69,
   "src": null,
   "src_dur": null,
   "motion": "push_in",
   "transition": "cut",
   "grade": "warm",
   "placeholder": "C playground | Narrator running ahead | laugh | medium",
   "override": {},
   "dur": 0.86
  },
  {
   "n": 19,
   "text": "Everyone wanted to be my friend.",
   "start": 31.69,
   "end": 33.23,
   "src": null,
   "src_dur": null,
   "motion": "push_in",
   "transition": "cut",
   "grade": "warm",
   "placeholder": "C playground | crowd around Narrator | laugh | medium",
   "override": {},
   "dur": 1.54
  },
  {
   "n": 20,
   "text": "The bench got lonely.",
   "start": 33.23,
   "end": 34.47,
   "src": null,
   "src_dur": null,
   "motion": "push_in",
   "transition": "cut",
   "grade": "neutral",
   "placeholder": "A bench | Rio alone | sad | wide | two burgers",
   "override": {},
   "dur": 1.24
  },
  {
   "n": 21,
   "text": "Rio kept saving me a seat.",
   "start": 34.47,
   "end": 35.71,
   "src": null,
   "src_dur": null,
   "motion": "push_in",
   "transition": "cut",
   "grade": "neutral",
   "placeholder": "A bench | Rio pats empty seat | sad | medium",
   "override": {},
   "dur": 1.24
  },
  {
   "n": 22,
   "text": "I kept saying, \"Tomorrow.\"",
   "start": 35.71,
   "end": 36.69,
   "src": null,
   "src_dur": null,
   "motion": "push_in",
   "transition": "cut",
   "grade": "neutral",
   "placeholder": "C playground | Narrator waving him off | smile | medium",
   "override": {},
   "dur": 0.98
  },
  {
   "n": 23,
   "text": "Then, one afternoon, Rio crossed the street to buy our burgers.",
   "start": 36.69,
   "end": 37.264,
   "src": null,
   "src_dur": null,
   "motion": "push_in",
   "transition": "fog",
   "grade": "neutral",
   "placeholder": "A street | Rio walking | smile | wide",
   "override": {},
   "dur": 0.574
  },
  {
   "n": 24,
   "text": "I saw it five seconds before it happened.",
   "start": 37.264,
   "end": 42.18,
   "src": null,
   "src_dur": null,
   "motion": "punch",
   "transition": "flash",
   "grade": "neutral",
   "placeholder": "C playground | Narrator, eyes glow, freezes | shocked | close, punch | glow",
   "override": {},
   "dur": 4.916
  },
  {
   "n": 25,
   "text": "But I was all the way across town.",
   "start": 42.18,
   "end": 43.74,
   "src": null,
   "src_dur": null,
   "motion": "push_in",
   "transition": "cut",
   "grade": "neutral",
   "placeholder": "C playground | Narrator running | scared | wide",
   "override": {},
   "dur": 1.56
  },
  {
   "n": 26,
   "text": "And Rio couldn't see it at all.",
   "start": 43.74,
   "end": 45.52,
   "src": null,
   "src_dur": null,
