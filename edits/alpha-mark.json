      "src_dur": 2.4,
      "motion": "push_in",
      "transition": "cut",
      "grade": "warm",
      "placeholder": null,
      "override": {},
      "dur": 1.76
    },
    {
      "n": 13,
      "text": "Every morning, I drew it on.",
      "start": 18.66,
      "end": 20.08,
      "src": "output/anim/alpha-mark/shot_13.mp4",
      "src_dur": 2.067,
      "motion": "push_in",
      "transition": "cut",
      "grade": "warm",
      "placeholder": null,
      "override": {},
      "dur": 1.42
    },
    {
      "n": 14,
      "text": "Every night, I washed it off",
      "start": 20.08,
      "end": 21.26,
      "src": "output/anim/alpha-mark/shot_14.mp4",
      "src_dur": 1.8,
      "motion": "push_in",
