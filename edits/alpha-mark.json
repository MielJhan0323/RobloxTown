      "grade": "cool",
      "placeholder": null,
      "override": {},
      "dur": 1.86
    },
    {
      "n": 20,
      "text": "\"He's prey,\" Kai said.",
      "start": 28.99,
      "end": 30.79,
      "src": "output/anim/alpha-mark/shot_20.mp4",
      "src_dur": 2.4,
      "motion": "push_in",
      "transition": "cut",
      "grade": "cool",
      "placeholder": null,
      "override": {},
      "dur": 1.8
    },
    {
      "n": 21,
      "text": "\"He's been faking it.\"",
      "start": 30.79,
      "end": 31.83,
      "src": "output/anim/alpha-mark/shot_21.mp4",
      "src_dur": 1.667,
      "motion": "push_in",
      "transition": "cut",
      "grade": "cool",
      "placeholder": null,
      "override": {},
      "dur": 1.04
    },
    {
      "n": 22,
      "text": "Everyone circled me.",
      "start": 31.83,
      "end": 32.9,
      "src": "output/anim/alpha-mark/shot_22.mp4",
