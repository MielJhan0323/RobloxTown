      "grade": "warm",
      "placeholder": null,
      "override": {},
      "dur": 1.88
    },
    {
      "n": 3,
      "text": "A leaf means you're prey.",
      "start": 2.82,
      "end": 4.14,
      "src": "output/anim/alpha-mark/shot_03.mp4",
      "src_dur": 1.933,
      "motion": "push_in",
      "transition": "cut",
      "grade": "warm",
      "placeholder": null,
      "override": {},
      "dur": 1.32
    },
    {
      "n": 4,
      "text": "A claw means you're a predator.",
