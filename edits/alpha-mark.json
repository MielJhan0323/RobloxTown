      "end": 6.22,
      "src": "output/anim/alpha-mark/shot_04.mp4",
      "src_dur": 2.733,
      "motion": "push_in",
      "transition": "cut",
      "grade": "warm",
      "placeholder": null,
      "override": {},
      "dur": 2.08
    },
    {
      "n": 5,
      "text": "Predators get the front of the lunch line.",
      "start": 6.22,
      "end": 7.59,
      "src": "output/anim/alpha-mark/shot_05.mp4",
      "src_dur": 2.0,
      "motion": "pan_right",
