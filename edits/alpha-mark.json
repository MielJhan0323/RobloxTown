      "motion": "push_in",
      "transition": "cut",
      "grade": "cool",
      "placeholder": null,
      "override": {},
      "dur": 1.06
    },
    {
      "n": 39,
      "text": "My crown burned brighter than ever.",
      "start": 55.83,
      "end": 56.99,
      "src": "output/anim/alpha-mark/shot_39.mp4",
      "src_dur": 1.8,
      "motion": "push_in",
      "transition": "sparkle",
      "grade": "warm",
      "placeholder": null,
      "override": {},
      "dur": 1.16
    },
    {
      "n": 40,
      "text": "I grabbed his wrist, the same way he grabbed mine.",
