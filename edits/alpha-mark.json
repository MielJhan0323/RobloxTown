      "grade": "warm",
      "placeholder": null,
      "override": {},
      "dur": 0.78
    },
    {
      "n": 8,
      "text": "and hasn't carried his own backpack since.",
      "start": 10.47,
      "end": 12.63,
      "src": "output/anim/alpha-mark/shot_08.mp4",
      "src_dur": 2.8,
      "motion": "pan_left",
      "transition": "cut",
      "grade": "warm",
      "placeholder": null,
      "override": {},
      "dur": 2.16
    },
    {
      "n": 9,
      "text": "And there's a third mark nobody's seen in a hundred years.",
      "start": 12.63,
      "end": 15.67,
      "src": "output/anim/alpha-mark/shot_09.mp4",
      "src_dur": 3.667,
      "motion": "push_in",
