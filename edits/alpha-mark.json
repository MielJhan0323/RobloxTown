      "grade": "warm",
      "placeholder": null,
      "override": {},
      "dur": 0.98
    },
    {
      "n": 42,
      "text": "Kai stared at me, shaking.",
      "start": 60.81,
      "end": 62.35,
      "src": "output/anim/alpha-mark/shot_42.mp4",
      "src_dur": 2.2,
      "motion": "push_in",
      "transition": "cut",
      "grade": "warm",
      "placeholder": null,
      "override": {},
      "dur": 1.54
    },
    {
      "n": 43,
      "text": "\"Why'd you save me?\"",
      "start": 62.35,
      "end": 63.45,
      "src": "output/anim/alpha-mark/shot_43.mp4",
      "src_dur": 1.733,
      "motion": "push_in",
      "transition": "cut",
      "grade": "warm",
      "placeholder": null,
      "override": {},
      "dur": 1.1
    },
    {
      "n": 44,
      "text": "\"Because,\" I said,",
      "start": 63.45,
      "end": 64.63,
      "src": "output/anim/alpha-mark/shot_44.mp4",
      "src_dur": 1.8,
      "motion": "push_in",
