      "grade": "cool",
      "placeholder": null,
      "override": {},
      "dur": 2.07
    },
    {
      "n": 17,
      "text": "Kai, the biggest predator in school,",
      "start": 24.65,
      "end": 26.05,
      "src": "output/anim/alpha-mark/shot_17.mp4",
      "src_dur": 2.0,
