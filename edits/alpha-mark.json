      "placeholder": null,
      "override": {},
      "dur": 1.18
    },
    {
      "n": 15,
      "text": "and stared at my leaf.",
      "start": 21.26,
      "end": 22.58,
      "src": "output/anim/alpha-mark/shot_15.mp4",
      "src_dur": 1.933,
      "motion": "push_in",
