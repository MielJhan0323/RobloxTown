      "motion": "push_in",
      "transition": "cut",
      "grade": "warm",
      "placeholder": null,
      "override": {},
      "dur": 1.54
    },
    {
      "n": 32,
      "text": "By the next week, the whole school called me king.",
      "start": 44.99,
      "end": 47.35,
      "src": "output/anim/alpha-mark/shot_32.mp4",
