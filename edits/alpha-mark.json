      "override": {},
      "dur": 2.1
    },
    {
      "n": 7,
      "text": "My cousin got a claw",
      "start": 9.69,
      "end": 10.47,
      "src": "output/anim/alpha-mark/shot_07.mp4",
      "src_dur": 1.4,
      "motion": "push_in",
