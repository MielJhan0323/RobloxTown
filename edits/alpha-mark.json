      "override": {},
      "dur": 0.94
    },
    {
      "n": 2,
      "text": "everyone is born with a mark on their wrist.",
      "start": 0.94,
      "end": 2.82,
      "src": "output/anim/alpha-mark/shot_02.mp4",
      "src_dur": 2.533,
      "motion": "push_in",
