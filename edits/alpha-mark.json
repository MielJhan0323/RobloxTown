      "motion": "push_in",
      "transition": "cut",
      "grade": "cool",
      "placeholder": null,
      "override": {},
      "dur": 1.07
    },
    {
      "n": 23,
      "text": "\"Show us,\" they said.",
      "start": 32.9,
      "end": 34.12,
      "src": "output/anim/alpha-mark/shot_23.mp4",
      "src_dur": 1.867,
      "motion": "push_in",
      "transition": "cut",
      "grade": "cool",
      "placeholder": null,
      "override": {},
      "dur": 1.22
    },
    {
      "n": 24,
      "text": "\"Show us what you really are.\"",
      "start": 34.12,
      "end": 35.42,
      "src": "output/anim/alpha-mark/shot_24.mp4",
      "src_dur": 1.933,
